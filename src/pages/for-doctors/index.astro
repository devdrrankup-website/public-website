---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import DoctorHero from '../../components/doctors/DoctorHero.astro';
import DoctorDiscoverySection from '../../components/doctors/DoctorDiscoverySection.astro';
import DoctorOutcomesSection from '../../components/doctors/DoctorOutcomesSection.astro';
import DoctorBangladeshSection from '../../components/doctors/DoctorBangladeshSection.astro';
import DoctorSolutionsSection from '../../components/doctors/DoctorSolutionsSection.astro';
import { doctorHeroPreload } from '../../lib/doctor-hero-image';
---
