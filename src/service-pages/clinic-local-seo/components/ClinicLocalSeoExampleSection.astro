---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-local-seo/clinic-local-seo-example-v1.webp';
import { pageCopy } from '../data/clinic-local-seo-source';
const copy = pageCopy.example;
import '../styles/clinic-local-seo-example.css';
---
<clinic-local-seo-example class="clinic-local-seo-example-motion">
  <section id="clinic-local-seo-example" class="clinic-local-seo-example" aria-labelledby="clinic-local-seo-example-heading">
    <div class="section-container clinic-local-seo-example-layout">
      <header class="clinic-local-seo-example-header" data-example-entry>
        <h2 id="clinic-local-seo-example-heading">{copy.heading}</h2>
        <span class="clinic-local-seo-example-rule" data-example-rule aria-hidden="true"></span>
      </header>
      <figure class="clinic-local-seo-example-photo" data-example-entry data-example-photo>
        <Image src={photo} alt="Visitor confirming a clinic location with reception staff" title="Visitor confirming a clinic location with reception staff" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <div class="clinic-local-seo-example-copy">
        <div class="clinic-local-seo-source-content" data-example-entry set:html={copy.html} />
      </div>
    </div>
  </section>
</clinic-local-seo-example>
<script>
  import '../scripts/clinic-local-seo-example';
</script>
