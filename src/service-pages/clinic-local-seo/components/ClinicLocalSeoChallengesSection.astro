---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-local-seo/clinic-local-seo-challenges-v1.webp';
import { pageCopy } from '../data/clinic-local-seo-source';
const copy = pageCopy.challenges;
import '../styles/clinic-local-seo-challenges.css';
---

<clinic-local-seo-challenges class="clinic-local-seo-challenges">
  <section id="clinic-local-seo-challenges" class="section-container clinic-local-seo-challenges-layout" aria-labelledby="clinic-local-seo-challenges-heading">
    <div class="clinic-local-seo-challenges-editorial">
      <h2 id="clinic-local-seo-challenges-heading">{copy.heading}</h2>
      <p class="clinic-local-seo-challenges-introduction" set:html={copy.introductionHtml} />
      <div class="clinic-local-seo-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Clinic owner and staff checking location information on a laptop"
          title="Clinic owner and staff checking location information on a laptop"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="clinic-local-seo-challenges-details">
      {copy.preListHtml && <p class="clinic-local-seo-challenges-prelist" set:html={copy.preListHtml} />}
      <p id="clinic-local-seo-challenges-list-heading" class="clinic-local-seo-challenges-list-intro" set:html={copy.listIntroductionHtml} />
      <ul class="clinic-local-seo-challenges-list" role="list" aria-labelledby="clinic-local-seo-challenges-list-heading" data-seo-challenges-motion>
        {copy.challengesHtml.map((challenge, index) => <li>
          <span class="clinic-local-seo-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={challenge} />
        </li>)}
      </ul>
      {copy.conclusionHtml && <p class="clinic-local-seo-challenges-conclusion" set:html={copy.conclusionHtml} />}
    </div>
  </section>
</clinic-local-seo-challenges>

<script>
  import '../scripts/clinic-local-seo-challenges';
</script>
