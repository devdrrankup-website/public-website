import './styles/patient-medical-record-software-source-content.css';
import { metadata } from './data/patient-medical-record-software-metadata';
---

<Layout metadata={metadata} imagePreload={patientMedicalRecordSoftwareHeroPreload}>
  <Navbar />
  <main id="main-content" class="patient-medical-record-software-page" tabindex="-1">
    <PatientMedicalRecordSoftwareHero />
    <PatientMedicalRecordSoftwareChallengesSection />
    <PatientMedicalRecordSoftwareOutcomesSection />
    <PatientMedicalRecordSoftwareIntentSection />
    <PatientMedicalRecordSoftwareTrustSection />
    <PatientMedicalRecordSoftwareExpertiseSection />
    <PatientMedicalRecordSoftwareProcessSection />
    <PatientMedicalRecordSoftwareMappingSection />
    <PatientMedicalRecordSoftwareRelatedSection />
    <PatientMedicalRecordSoftwareStartingSection />
    <PatientMedicalRecordSoftwareExampleSection />
    <PatientMedicalRecordSoftwareProgressSection />
    <PatientMedicalRecordSoftwareWhySection />
    <PatientMedicalRecordSoftwareFaqSection />
    <PatientMedicalRecordSoftwareConsultationSection />
  </main>
  <Footer />
</Layout>
