---
// Destination-owned static page. Service-specific images are pending review before publication.
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import PatientMedicalRecordSoftwareHero from './components/PatientMedicalRecordSoftwareHero.astro';
import PatientMedicalRecordSoftwareChallengesSection from './components/PatientMedicalRecordSoftwareChallengesSection.astro';
import PatientMedicalRecordSoftwareOutcomesSection from './components/PatientMedicalRecordSoftwareOutcomesSection.astro';
import PatientMedicalRecordSoftwareIntentSection from './components/PatientMedicalRecordSoftwareIntentSection.astro';
import PatientMedicalRecordSoftwareTrustSection from './components/PatientMedicalRecordSoftwareTrustSection.astro';
import PatientMedicalRecordSoftwareExpertiseSection from './components/PatientMedicalRecordSoftwareExpertiseSection.astro';
import PatientMedicalRecordSoftwareProcessSection from './components/PatientMedicalRecordSoftwareProcessSection.astro';
import PatientMedicalRecordSoftwareMappingSection from './components/PatientMedicalRecordSoftwareMappingSection.astro';
import PatientMedicalRecordSoftwareRelatedSection from './components/PatientMedicalRecordSoftwareRelatedSection.astro';
import PatientMedicalRecordSoftwareStartingSection from './components/PatientMedicalRecordSoftwareStartingSection.astro';
import PatientMedicalRecordSoftwareExampleSection from './components/PatientMedicalRecordSoftwareExampleSection.astro';
import PatientMedicalRecordSoftwareProgressSection from './components/PatientMedicalRecordSoftwareProgressSection.astro';
import PatientMedicalRecordSoftwareWhySection from './components/PatientMedicalRecordSoftwareWhySection.astro';
import PatientMedicalRecordSoftwareFaqSection from './components/PatientMedicalRecordSoftwareFaqSection.astro';
import PatientMedicalRecordSoftwareConsultationSection from './components/PatientMedicalRecordSoftwareConsultationSection.astro';
import Footer from '../../components/Footer.astro';
import { patientMedicalRecordSoftwareHeroPreload } from './lib/patient-medical-record-software-hero-image';
