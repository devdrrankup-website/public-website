---
import { Image } from 'astro:assets';
import photo from '../../../assets/patient-medical-record-software/patient-medical-record-software-starting-v1.webp';
import { pageCopy } from '../data/patient-medical-record-software-source';
const copy = pageCopy.starting;
import '../styles/patient-medical-record-software-starting.css';
---
<patient-medical-record-software-starting class="patient-medical-record-software-starting-motion">
  <section id="patient-medical-record-software-starting" class="patient-medical-record-software-starting" aria-labelledby="patient-medical-record-software-starting-heading">
    <div class="section-container patient-medical-record-software-starting-layout">
      <h2 id="patient-medical-record-software-starting-heading" data-starting-entry>{copy.heading}</h2>
      <div class="patient-medical-record-software-starting-copy" data-starting-entry>
        <div class="patient-medical-record-software-source-content" set:html={copy.html} />
      </div>
      <figure class="patient-medical-record-software-starting-visual" data-starting-entry data-starting-visual>
        <Image src={photo} alt="Doctor and specialist planning medical record handling" title="Doctor and specialist planning medical record handling" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 540px, (min-width:640px) 320px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>
</patient-medical-record-software-starting>
<script>
  import '../scripts/patient-medical-record-software-starting';
</script>
