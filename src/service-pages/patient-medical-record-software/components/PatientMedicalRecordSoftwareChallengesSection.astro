---
import { Image } from 'astro:assets';
import photo from '../../../assets/patient-medical-record-software/patient-medical-record-software-challenges-v1.webp';
import { pageCopy } from '../data/patient-medical-record-software-source';
const copy = pageCopy.challenges;
import { challengeEditorial as editorial } from '../data/patient-medical-record-software-section-editorial';
import '../styles/patient-medical-record-software-challenges.css';
---

<patient-medical-record-software-challenges class="patient-medical-record-software-challenges">
  <section id="patient-medical-record-software-challenges" class="section-container patient-medical-record-software-challenges-layout" aria-labelledby="patient-medical-record-software-challenges-heading">
    <div class="patient-medical-record-software-challenges-editorial">
      <h2 id="patient-medical-record-software-challenges-heading">{copy.heading}</h2>
      <p class="patient-medical-record-software-challenges-introduction" set:html={editorial.introduction} />
      <div class="patient-medical-record-software-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Doctor reconciling patient record papers with digital information"
          title="Doctor reconciling patient record papers with digital information"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="patient-medical-record-software-challenges-details">
      <p id="patient-medical-record-software-challenges-list-heading" class="patient-medical-record-software-challenges-list-intro">{editorial.listIntro}</p>
      <ul class="patient-medical-record-software-challenges-list" role="list" aria-labelledby="patient-medical-record-software-challenges-list-heading" data-seo-challenges-motion>
        {editorial.points.map((paragraph, index) => <li>
          <span class="patient-medical-record-software-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={paragraph} />
        </li>)}
      </ul>
      <p class="patient-medical-record-software-challenges-conclusion">{editorial.conclusion}</p>
    </div>
  </section>
</patient-medical-record-software-challenges>

<script>
  import '../scripts/patient-medical-record-software-challenges';
</script>
