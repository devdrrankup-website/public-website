---
import { Image } from 'astro:assets';
import photo from '../../../assets/patient-medical-record-software/patient-medical-record-software-intent-v1.webp';
import { pageCopy } from '../data/patient-medical-record-software-source';
const copy = pageCopy.intent;
import '../styles/patient-medical-record-software-intent.css';
---
<patient-medical-record-software-intent class="patient-medical-record-software-intent">
  <section id="patient-medical-record-software-intent" class="section-container patient-medical-record-software-intent-layout" aria-labelledby="patient-medical-record-software-intent-heading">
    <div class="patient-medical-record-software-intent-copy" data-seo-intent-motion>
      <h2 id="patient-medical-record-software-intent-heading">{copy.heading}</h2>
      <div class="patient-medical-record-software-source-content" set:html={copy.html} />
    </div>
    <div class="patient-medical-record-software-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Doctor and staff checking a patient record screen in the chamber"
        title="Doctor and staff checking a patient record screen in the chamber" />
    </div>
  </section>
</patient-medical-record-software-intent>

<script>
  import '../scripts/patient-medical-record-software-intent';
</script>
