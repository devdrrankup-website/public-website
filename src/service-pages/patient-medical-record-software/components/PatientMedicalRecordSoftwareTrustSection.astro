---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import photo from '../../../assets/patient-medical-record-software/patient-medical-record-software-trust-v1.webp';
import { pageCopy } from '../data/patient-medical-record-software-source';
const copy = pageCopy.trust;
import '../styles/patient-medical-record-software-trust.css';
---

<patient-medical-record-software-trust class="patient-medical-record-software-trust-motion">
  <section id="patient-medical-record-software-trust" class="patient-medical-record-software-trust" aria-labelledby="patient-medical-record-software-trust-heading">
    <div class="section-container patient-medical-record-software-trust-layout">
      <h2 id="patient-medical-record-software-trust-heading">{copy.heading}</h2>
      <div class="patient-medical-record-software-trust-profile patient-medical-record-software-source-content" data-seo-trust-motion set:html={copy.firstHtml} />
      <div class="patient-medical-record-software-trust-photo" data-seo-trust-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76} loading="lazy" decoding="async"
          alt="Doctor and specialist verifying a private patient record"
          title="Doctor and specialist verifying a private patient record" />
      </div>
      <div class="patient-medical-record-software-trust-privacy" data-seo-trust-motion>
        <span class="patient-medical-record-software-trust-lock" aria-hidden="true"><Icon icon={LockKeyIcon} size={24} /></span>
        <div class="patient-medical-record-software-source-content" set:html={copy.restHtml} />
      </div>
    </div>
  </section>
</patient-medical-record-software-trust>

<script>
  import '../scripts/patient-medical-record-software-trust';
</script>
