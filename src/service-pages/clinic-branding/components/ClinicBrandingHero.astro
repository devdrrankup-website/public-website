---
import ActionIcon from '../../../components/ActionIcon.astro';
import { pageCopy } from '../data/clinic-branding-source';
const copy = pageCopy.hero;
import { clinicBrandingHeroImage as photo } from '../lib/clinic-branding-hero-image';
import '../styles/clinic-branding-hero.css';
---

<section class="clinic-branding-hero" aria-labelledby="clinic-branding-heading">
  <div class="section-container clinic-branding-hero-layout">
    <div class="clinic-branding-hero-copy">
      <h1 id="clinic-branding-heading">{copy.heading}</h1>
      <p class="clinic-branding-hero-tagline">{copy.tagline}</p>
      <div class="clinic-branding-hero-description">
        {copy.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      </div>
      <div class="clinic-branding-hero-actions" aria-label={`${copy.heading} options`}>
        <a class="button button-primary" href="/contact/">
          <span>{copy.primaryCta}</span><ActionIcon purpose="conversation" />
        </a>
        <a class="button button-secondary" href={copy.secondaryHref}>
          <span>{copy.secondaryCta}</span><ActionIcon purpose="conversation" />
        </a>
      </div>
    </div>
    <div class="clinic-branding-hero-visual">
      <div class="clinic-branding-hero-photo">
        <img src={photo.src} srcset={photo.srcset} sizes={photo.sizes}
          width={photo.width} height={photo.height}
          alt="Clinic owner and designers reviewing signs, patient materials and colours at a Bangladesh agency"
          title="Planning a consistent clinic brand identity"
          loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
</section>
