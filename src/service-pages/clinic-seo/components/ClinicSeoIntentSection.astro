---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-seo/clinic-seo-intent-v1.webp';
import { pageCopy } from '../data/clinic-seo-source';
const copy = pageCopy.intent;
import '../styles/clinic-seo-intent.css';
---
<clinic-seo-intent class="clinic-seo-intent">
  <section id="clinic-seo-intent" class="section-container clinic-seo-intent-layout" aria-labelledby="clinic-seo-intent-heading">
    <div class="clinic-seo-intent-copy" data-seo-intent-motion>
      <h2 id="clinic-seo-intent-heading">{copy.heading}</h2>
      <div class="clinic-seo-source-content" set:html={copy.html} />
    </div>
    <div class="clinic-seo-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Family reviewing clinic service pages and map locations from home"
        title="Family reviewing clinic service pages and map locations from home" />
    </div>
  </section>
</clinic-seo-intent>

<script>
  import '../scripts/clinic-seo-intent';
</script>
