---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-seo/clinic-seo-progress-v1.webp';
import { pageCopy } from '../data/clinic-seo-source';
const copy = pageCopy.progress;
import '../styles/clinic-seo-progress.css';
---
<clinic-seo-progress class="clinic-seo-progress-motion">
  <section id="clinic-seo-progress" class="clinic-seo-progress" aria-labelledby="clinic-seo-progress-heading">
    <div class="section-container clinic-seo-progress-layout">
      <h2 id="clinic-seo-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="clinic-seo-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="clinic-seo-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Search specialist reviewing a clinic visibility report on a laptop" title="Search specialist reviewing a clinic visibility report on a laptop" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="clinic-seo-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</clinic-seo-progress>
<script>
  import '../scripts/clinic-seo-progress';
</script>
