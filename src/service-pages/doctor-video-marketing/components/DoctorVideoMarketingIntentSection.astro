---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-video-marketing/doctor-video-marketing-intent-v1.webp';
import { pageCopy } from '../data/doctor-video-marketing-source';
const copy = pageCopy.intent;
import '../styles/doctor-video-marketing-intent.css';
---
<doctor-video-marketing-intent class="doctor-video-marketing-intent">
  <section id="doctor-video-marketing-intent" class="section-container doctor-video-marketing-intent-layout" aria-labelledby="doctor-video-marketing-intent-heading">
    <div class="doctor-video-marketing-intent-copy" data-seo-intent-motion>
      <h2 id="doctor-video-marketing-intent-heading">{copy.heading}</h2>
      <div class="doctor-video-marketing-source-content" set:html={copy.html} />
    </div>
    <div class="doctor-video-marketing-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Woman viewing a doctor video on her phone at home"
        title="Woman viewing a doctor video on her phone at home" />
    </div>
  </section>
</doctor-video-marketing-intent>

<script>
  import '../scripts/doctor-video-marketing-intent';
</script>
