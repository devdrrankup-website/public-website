---
import { Image } from 'astro:assets';
import { pageCopy } from '../data/doctor-video-marketing-source';
const copy = pageCopy.process;
import processBackground from '../../../assets/doctor-video-marketing/doctor-video-marketing-process-workflow-v1.webp';
import '../styles/doctor-video-marketing-process.css';
// Destination-owned copy of the approved For Doctors process composition.
const titleParts = (title: string) => [title.match(/^\d+\.\s+/)?.[0] ?? '', title.replace(/^\d+\.\s+/, '')];
---

<doctor-video-marketing-process class="doctor-video-marketing-process-motion">
  <section id="doctor-video-marketing-process" class="doctor-video-marketing-process" aria-labelledby="doctor-video-marketing-process-heading">
    <div class="doctor-video-marketing-process-background" aria-hidden="true">
      <Image src={processBackground} width={1024} widths={[480, 768, 1024]} sizes="100vw" format="webp" quality={40}
        alt="" title="Inside a real Bangladesh doctor chamber, a civilian camera operator and sound assistant prepare a modest video setup as the doctor reviews an outline; credible light stand, lens and sightlines." loading="lazy" decoding="async" />
    </div>
    <div class="doctor-video-marketing-process-atmosphere" aria-hidden="true"></div>
    <div class="section-container doctor-video-marketing-process-layout">
      <header class="doctor-video-marketing-process-header" data-seo-process-copy>
        <span class="doctor-video-marketing-process-range" aria-hidden="true">{`01—${String(copy.steps.length).padStart(2, '0')}`}</span>
        <h2 id="doctor-video-marketing-process-heading">{copy.heading}</h2>
        <div class="doctor-video-marketing-source-content" set:html={copy.introductionHtml} />
      </header>

      <div class="doctor-video-marketing-process-flow" role="list" aria-label={`${copy.steps.length} service steps`}>
        <svg class="doctor-video-marketing-process-route" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="doctor-video-marketing-process-route-gradient" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="100" y2="100">
              <stop offset="0" stop-color="#6131c6" />
              <stop offset="0.5" stop-color="#229f60" />
              <stop offset="1" stop-color="#6131c6" />
            </linearGradient>
          </defs>
          <path class="doctor-video-marketing-process-route-base" />
          <path class="doctor-video-marketing-process-route-progress" />
        </svg>

        {copy.steps.map((step, index) => (
          <div class="doctor-video-marketing-process-step" role="listitem" data-seo-process-step>
            <div class="doctor-video-marketing-process-node-column" aria-hidden="true">
              <span class="doctor-video-marketing-process-node"><span>{String(index + 1).padStart(2, '0')}</span></span>
              {index < copy.steps.length - 1 && <span class="doctor-video-marketing-process-connector"></span>}
            </div>
            <div class="doctor-video-marketing-process-copy" data-seo-process-copy>
              <h3><span>{titleParts(step.title)[0]}</span>{titleParts(step.title)[1]}</h3>
              <div class="doctor-video-marketing-source-content" set:html={step.html} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</doctor-video-marketing-process>

<script>
  import '../scripts/doctor-video-marketing-process';
</script>
