---
import Icon from '../../../components/Icon.astro';
import Add01Icon from '@hugeicons/core-free-icons/Add01Icon';
import { pageCopy } from '../data/doctor-video-marketing-source';
const copy = pageCopy.faq;
import '../styles/doctor-video-marketing-faq.css';
---
<doctor-video-marketing-faq class="doctor-video-marketing-faq-motion">
  <section id="doctor-video-marketing-faq" class="doctor-video-marketing-faq" aria-labelledby="doctor-video-marketing-faq-heading">
    <div class="section-container doctor-video-marketing-faq-layout">
      <header class="doctor-video-marketing-faq-header" data-faq-entry>
        <h2 id="doctor-video-marketing-faq-heading">{copy.heading}</h2>
        <div class="doctor-video-marketing-source-content" set:html={copy.preface} />
      </header>
      <div class="doctor-video-marketing-faq-list">
        {copy.items.map((item,index) => <article class="doctor-video-marketing-faq-item" data-faq-entry aria-labelledby={`doctor-video-marketing-faq-question-${index+1}`}>
          <h3 class="doctor-video-marketing-faq-question" id={`doctor-video-marketing-faq-question-${index+1}`}>
            <span class="doctor-video-marketing-faq-label">{item.question}</span>
            <span class="doctor-video-marketing-faq-toggle" aria-hidden="true"><Icon icon={Add01Icon} size={20} strokeWidth={1.8} /></span>
          </h3>
          <div class="doctor-video-marketing-faq-answer" id={`doctor-video-marketing-faq-answer-${index+1}`} role="region" aria-labelledby={`doctor-video-marketing-faq-question-${index+1}`}>
            <div class="doctor-video-marketing-source-content" set:html={item.answerHtml} />
          </div>
        </article>)}
      </div>
    </div>
  </section>
</doctor-video-marketing-faq>
<script>
  import '../scripts/doctor-video-marketing-faq';
</script>
