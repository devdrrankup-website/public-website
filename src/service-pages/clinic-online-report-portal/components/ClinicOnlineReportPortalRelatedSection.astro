---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import Arrow from '../../../components/Arrow.astro';
import MicroscopeIcon from '@hugeicons/core-free-icons/MicroscopeIcon';
import WebDesign01Icon from '@hugeicons/core-free-icons/WebDesign01Icon';
import CreditCardIcon from '@hugeicons/core-free-icons/CreditCardIcon';
import { pageCopy } from '../data/clinic-online-report-portal-source';
const copy = pageCopy.related;
import relatedImage0 from '../../../assets/pathology-reporting-software/pathology-reporting-software-related-preview-v1.webp';
import relatedImage1 from '../../../assets/diagnostic-management/diagnostic-management-related-preview-v1.webp';
import relatedImage2 from '../../../assets/clinic-website/clinic-website-related-preview-v1.webp';
import relatedImage3 from '../../../assets/clinic-billing-software/clinic-billing-software-related-preview-v1.webp';
import '../styles/clinic-online-report-portal-related.css';
const visuals = [
  { image: relatedImage0, icon: MicroscopeIcon, accent: '#BAE5FF', description: "A pathology laboratory supervisor reviews a neutral digital report layout at a lab workstation, with sample racks safely behind the screen and no results visible." },
  { image: relatedImage1, icon: MicroscopeIcon, accent: '#EEEDFE', description: "Inside a diagnostic centre, an administrator observes a technician moving sealed specimen tubes between clearly separate reception and processing trays." },
  { image: relatedImage2, icon: WebDesign01Icon, accent: '#FEF2CC', description: "A patient at home views a clinic website's departments and contact paths on a front-facing tablet, with the screen content kept generic and text unreadable." },
  { image: relatedImage3, icon: CreditCardIcon, accent: '#E4FFBD', description: "At a clinic checkout counter, a cashier prints an itemised blank receipt after verifying charge categories on a properly oriented workstation." },
];
---
<section id="clinic-online-report-portal-related" class="clinic-online-report-portal-related" aria-labelledby="clinic-online-report-portal-related-heading">
  <div class="section-container clinic-online-report-portal-related-container">
    <clinic-online-report-portal-related>
      <header class="clinic-online-report-portal-related-header" data-related-entry>
        <h2 id="clinic-online-report-portal-related-heading">{copy.heading}</h2>
        <div class="clinic-online-report-portal-source-content" set:html={copy.introductionHtml} />
      </header>
      <div class="clinic-online-report-portal-related-layout">
        <div class="clinic-online-report-portal-related-dock">
          <div class="clinic-online-report-portal-related-selectors" role="group" aria-label="Service image previews" hidden>
            {copy.services.map((service, index) => <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`related-${service.key}`} data-related-select={index}>
              <span>{service.name}</span>
            </button>)}
          </div>
          <div class="clinic-online-report-portal-related-stage" aria-hidden="true" hidden></div>
        </div>
        <div class="clinic-online-report-portal-related-details">
          <div class="clinic-online-report-portal-related-labels"><span>{copy.headers[0]}</span><span>{copy.headers[1]}</span></div>
          <dl class="clinic-online-report-portal-related-list">
            {copy.services.map((service, index) => <div class="clinic-online-report-portal-related-row" id={`related-${service.key}`} data-service={service.key}>
              <dt>
                <span class="clinic-online-report-portal-related-badge" style={`--related-accent:${visuals[index % visuals.length].accent}`}><Icon icon={visuals[index % visuals.length].icon} size={21} strokeWidth={1.8} /></span>
                <span class="clinic-online-report-portal-related-reveal" aria-hidden="true"></span>
                {service.href ? <a class="clinic-online-report-portal-related-name" href={service.href}>{service.name}</a>
                  : <span class="clinic-online-report-portal-related-name">{service.name}</span>}
                <span class="clinic-online-report-portal-related-arrow" aria-hidden="true"><Arrow /></span>
              </dt>
              <dd>
                <span>{service.responsibility}</span>
                <figure class="clinic-online-report-portal-related-photo">
                  <Image src={visuals[index % visuals.length].image} alt={visuals[index % visuals.length].description} title={visuals[index % visuals.length].description} width={960} widths={[360,640,960]} sizes="(min-width:1100px) 700px, (min-width:640px) 700px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
                  <figcaption>{service.name}</figcaption>
                </figure>
              </dd>
            </div>)}
          </dl>
          <div class="clinic-online-report-portal-related-note clinic-online-report-portal-source-content" set:html={copy.noteHtml} />
        </div>
      </div>
    </clinic-online-report-portal-related>
  </div>
</section>
<script>
  import '../scripts/clinic-online-report-portal-related';
</script>
