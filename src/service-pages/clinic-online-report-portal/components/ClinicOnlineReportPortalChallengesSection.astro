---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-online-report-portal/clinic-online-report-portal-challenges-v1.webp';
import { pageCopy } from '../data/clinic-online-report-portal-source';
const copy = pageCopy.challenges;
const introductionParagraph = copy.html.match(/^<p>([\s\S]*?)<\/p>/)?.[1] ?? '';
const detailParagraphs = Array.from(copy.html.matchAll(/<p>([\s\S]*?)<\/p>/g), match => match[1]).slice(1);
import '../styles/clinic-online-report-portal-challenges.css';
---

<clinic-online-report-portal-challenges class="clinic-online-report-portal-challenges">
  <section id="clinic-online-report-portal-challenges" class="section-container clinic-online-report-portal-challenges-layout" aria-labelledby="clinic-online-report-portal-challenges-heading">
    <div class="clinic-online-report-portal-challenges-editorial">
      <h2 id="clinic-online-report-portal-challenges-heading">{copy.heading}</h2>
      <p class="clinic-online-report-portal-challenges-introduction" set:html={introductionParagraph} />
      <div class="clinic-online-report-portal-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Clinic receptionist reconciling report requests and printed records"
          title="Clinic receptionist reconciling report requests and printed records"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="clinic-online-report-portal-challenges-details">
      <ul class="clinic-online-report-portal-challenges-list" role="list" data-seo-challenges-motion>
        {detailParagraphs.map((paragraph, index) => <li>
          <span class="clinic-online-report-portal-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={paragraph} />
        </li>)}
      </ul>
    </div>
  </section>
</clinic-online-report-portal-challenges>

<script>
  import '../scripts/clinic-online-report-portal-challenges';
</script>
