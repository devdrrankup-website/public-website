---
import ClinicOnlineReportPortalOutcomeVisual from './ClinicOnlineReportPortalOutcomeVisual.astro';
import { pageCopy } from '../data/clinic-online-report-portal-source';
const copy = pageCopy.outcomes;
import '../styles/clinic-online-report-portal-outcomes.css';
---
<clinic-online-report-portal-outcomes class="clinic-online-report-portal-outcomes">
  <section id="clinic-online-report-portal-outcomes" class="section-container" aria-labelledby="clinic-online-report-portal-outcomes-heading">
    <div class="clinic-online-report-portal-outcomes-heading">
      <h2 id="clinic-online-report-portal-outcomes-heading">{copy.heading}</h2>
      <div class="clinic-online-report-portal-outcomes-introduction clinic-online-report-portal-source-content" set:html={copy.before} />
    </div>
    <ul class="clinic-online-report-portal-outcomes-list" role="list">
      {copy.items.map((item, index) => <li class="clinic-online-report-portal-outcome" data-seo-outcomes-motion>
        <ClinicOnlineReportPortalOutcomeVisual index={index} />
        <p><strong>{item.label}</strong><span>{item.description}</span></p>
      </li>)}
    </ul>
    <div class="clinic-online-report-portal-outcomes-conclusion clinic-online-report-portal-source-content" set:html={copy.after} />
  </section>
</clinic-online-report-portal-outcomes>

<script>
  import '../scripts/clinic-online-report-portal-outcomes';
</script>
