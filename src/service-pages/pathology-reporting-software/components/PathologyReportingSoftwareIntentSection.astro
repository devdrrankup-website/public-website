---
import { Image } from 'astro:assets';
import photo from '../../../assets/pathology-reporting-software/pathology-reporting-software-intent-v1.webp';
import { pageCopy } from '../data/pathology-reporting-software-source';
const copy = pageCopy.intent;
import '../styles/pathology-reporting-software-intent.css';
---
<pathology-reporting-software-intent class="pathology-reporting-software-intent">
  <section id="pathology-reporting-software-intent" class="section-container pathology-reporting-software-intent-layout" aria-labelledby="pathology-reporting-software-intent-heading">
    <div class="pathology-reporting-software-intent-copy" data-seo-intent-motion>
      <h2 id="pathology-reporting-software-intent-heading">{copy.heading}</h2>
      <div class="pathology-reporting-software-source-content" set:html={copy.html} />
    </div>
    <div class="pathology-reporting-software-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Laboratory staff checking a pathology report on a front-facing monitor"
        title="Laboratory staff checking a pathology report on a front-facing monitor" />
    </div>
  </section>
</pathology-reporting-software-intent>

<script>
  import '../scripts/pathology-reporting-software-intent';
</script>
