---
import {linkOfficialGuidanceHtml} from '../../../lib/official-guidance';
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import photo from '../../../assets/pathology-reporting-software/pathology-reporting-software-trust-v1.webp';
import { pageCopy } from '../data/pathology-reporting-software-source';
const copy = pageCopy.trust;
const officialLinks = new Set<string>();
const trustFirstHtml = linkOfficialGuidanceHtml(copy.firstHtml, officialLinks);
const trustRestHtml = linkOfficialGuidanceHtml(copy.restHtml, officialLinks);
import '../styles/pathology-reporting-software-trust.css';
---

<pathology-reporting-software-trust class="pathology-reporting-software-trust-motion">
  <section id="pathology-reporting-software-trust" class="pathology-reporting-software-trust" aria-labelledby="pathology-reporting-software-trust-heading">
    <div class="section-container pathology-reporting-software-trust-layout">
      <h2 id="pathology-reporting-software-trust-heading">{copy.heading}</h2>
      <div class="pathology-reporting-software-trust-profile pathology-reporting-software-source-content" data-seo-trust-motion set:html={trustFirstHtml} />
      <div class="pathology-reporting-software-trust-photo" data-seo-trust-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76} loading="lazy" decoding="async"
          alt="Clinician and manager verifying a sample pathology report"
          title="Clinician and manager verifying a sample pathology report" />
      </div>
      <div class="pathology-reporting-software-trust-privacy" data-seo-trust-motion>
        <span class="pathology-reporting-software-trust-lock" aria-hidden="true"><Icon icon={LockKeyIcon} size={24} /></span>
        <div class="pathology-reporting-software-source-content" set:html={trustRestHtml} />
      </div>
    </div>
  </section>
</pathology-reporting-software-trust>

<script>
  import '../scripts/pathology-reporting-software-trust';
</script>
