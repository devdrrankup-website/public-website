---
import { Image } from 'astro:assets';
import photo from '../../../assets/pathology-reporting-software/pathology-reporting-software-challenges-v1.webp';
import { pageCopy } from '../data/pathology-reporting-software-source';
const copy = pageCopy.challenges;
import '../styles/pathology-reporting-software-challenges.css';
---

<pathology-reporting-software-challenges class="pathology-reporting-software-challenges">
  <section id="pathology-reporting-software-challenges" class="section-container pathology-reporting-software-challenges-layout" aria-labelledby="pathology-reporting-software-challenges-heading">
    <div class="pathology-reporting-software-challenges-editorial">
      <h2 id="pathology-reporting-software-challenges-heading">{copy.heading}</h2>
      <p class="pathology-reporting-software-challenges-introduction" set:html={copy.introductionHtml} />
      <div class="pathology-reporting-software-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Laboratory team reconciling pathology papers and computer records"
          title="Laboratory team reconciling pathology papers and computer records"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="pathology-reporting-software-challenges-details">
      {copy.preListHtml && <p class="pathology-reporting-software-challenges-prelist" set:html={copy.preListHtml} />}
      <p id="pathology-reporting-software-challenges-list-heading" class="pathology-reporting-software-challenges-list-intro" set:html={copy.listIntroductionHtml} />
      <ul class="pathology-reporting-software-challenges-list" role="list" aria-labelledby="pathology-reporting-software-challenges-list-heading" data-seo-challenges-motion>
        {copy.challengesHtml.map((challenge, index) => <li>
          <span class="pathology-reporting-software-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={challenge} />
        </li>)}
      </ul>
      {copy.conclusionHtml && <p class="pathology-reporting-software-challenges-conclusion" set:html={copy.conclusionHtml} />}
    </div>
  </section>
</pathology-reporting-software-challenges>

<script>
  import '../scripts/pathology-reporting-software-challenges';
</script>
