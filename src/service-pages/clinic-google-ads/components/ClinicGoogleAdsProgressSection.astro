---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-google-ads/clinic-google-ads-progress-v1.webp';
import { pageCopy } from '../data/clinic-google-ads-source';
const copy = pageCopy.progress;
import '../styles/clinic-google-ads-progress.css';
---
<clinic-google-ads-progress class="clinic-google-ads-progress-motion">
  <section id="clinic-google-ads-progress" class="clinic-google-ads-progress" aria-labelledby="clinic-google-ads-progress-heading">
    <div class="section-container clinic-google-ads-progress-layout">
      <h2 id="clinic-google-ads-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="clinic-google-ads-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="clinic-google-ads-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Advertising specialist reviewing an unlabeled clinic campaign report" title="Advertising specialist reviewing an unlabeled clinic campaign report" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="clinic-google-ads-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</clinic-google-ads-progress>
<script>
  import '../scripts/clinic-google-ads-progress';
</script>
