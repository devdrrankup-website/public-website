---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import photo from '../../../assets/hospital-website-development/hospital-website-development-trust-v1.webp';
import { pageCopy } from '../data/hospital-website-development-source';
const copy = pageCopy.trust;
import '../styles/hospital-website-development-trust.css';
---

<hospital-website-development-trust class="hospital-website-development-trust-motion">
  <section id="hospital-website-development-trust" class="hospital-website-development-trust" aria-labelledby="hospital-website-development-trust-heading">
    <div class="section-container hospital-website-development-trust-layout">
      <h2 id="hospital-website-development-trust-heading">{copy.heading}</h2>
      <div class="hospital-website-development-trust-profile hospital-website-development-source-content" data-seo-trust-motion set:html={copy.firstHtml} />
      <div class="hospital-website-development-trust-photo" data-seo-trust-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76} loading="lazy" decoding="async"
          alt="Clinician and manager verifying hospital website information"
          title="Clinician and manager verifying hospital website information" />
      </div>
      <div class="hospital-website-development-trust-privacy" data-seo-trust-motion>
        <span class="hospital-website-development-trust-lock" aria-hidden="true"><Icon icon={LockKeyIcon} size={24} /></span>
        <div class="hospital-website-development-source-content" set:html={copy.restHtml} />
      </div>
    </div>
  </section>
</hospital-website-development-trust>

<script>
  import '../scripts/hospital-website-development-trust';
</script>
