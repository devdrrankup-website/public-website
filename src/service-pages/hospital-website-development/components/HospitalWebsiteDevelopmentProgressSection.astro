---
import { Image } from 'astro:assets';
import photo from '../../../assets/hospital-website-development/hospital-website-development-progress-v1.webp';
import { pageCopy } from '../data/hospital-website-development-source';
const copy = pageCopy.progress;
import '../styles/hospital-website-development-progress.css';
---
<hospital-website-development-progress class="hospital-website-development-progress-motion">
  <section id="hospital-website-development-progress" class="hospital-website-development-progress" aria-labelledby="hospital-website-development-progress-heading">
    <div class="section-container hospital-website-development-progress-layout">
      <h2 id="hospital-website-development-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="hospital-website-development-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="hospital-website-development-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Hospital team reviewing a website report at the facility" title="Hospital team reviewing a website report at the facility" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="hospital-website-development-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</hospital-website-development-progress>
<script>
  import '../scripts/hospital-website-development-progress';
</script>
