import ClinicBillingSoftwareHero from './components/ClinicBillingSoftwareHero.astro';
import ClinicBillingSoftwareChallengesSection from './components/ClinicBillingSoftwareChallengesSection.astro';
import ClinicBillingSoftwareOutcomesSection from './components/ClinicBillingSoftwareOutcomesSection.astro';
import ClinicBillingSoftwareIntentSection from './components/ClinicBillingSoftwareIntentSection.astro';
import ClinicBillingSoftwareTrustSection from './components/ClinicBillingSoftwareTrustSection.astro';
import ClinicBillingSoftwareExpertiseSection from './components/ClinicBillingSoftwareExpertiseSection.astro';
import ClinicBillingSoftwareProcessSection from './components/ClinicBillingSoftwareProcessSection.astro';
import ClinicBillingSoftwareMappingSection from './components/ClinicBillingSoftwareMappingSection.astro';
import ClinicBillingSoftwareRelatedSection from './components/ClinicBillingSoftwareRelatedSection.astro';
import ClinicBillingSoftwareStartingSection from './components/ClinicBillingSoftwareStartingSection.astro';
import ClinicBillingSoftwareExampleSection from './components/ClinicBillingSoftwareExampleSection.astro';
import ClinicBillingSoftwareProgressSection from './components/ClinicBillingSoftwareProgressSection.astro';
import ClinicBillingSoftwareWhySection from './components/ClinicBillingSoftwareWhySection.astro';
import ClinicBillingSoftwareFaqSection from './components/ClinicBillingSoftwareFaqSection.astro';
import ClinicBillingSoftwareConsultationSection from './components/ClinicBillingSoftwareConsultationSection.astro';
