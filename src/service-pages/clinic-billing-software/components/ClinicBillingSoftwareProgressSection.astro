---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-billing-software/clinic-billing-software-progress-v1.webp';
import { pageCopy } from '../data/clinic-billing-software-source';
const copy = pageCopy.progress;
import '../styles/clinic-billing-software-progress.css';
---
<clinic-billing-software-progress class="clinic-billing-software-progress-motion">
  <section id="clinic-billing-software-progress" class="clinic-billing-software-progress" aria-labelledby="clinic-billing-software-progress-heading">
    <div class="section-container clinic-billing-software-progress-layout">
      <h2 id="clinic-billing-software-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="clinic-billing-software-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="clinic-billing-software-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Clinic team checking payment reports and printed records together" title="Clinic team checking payment reports and printed records together" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="clinic-billing-software-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</clinic-billing-software-progress>
<script>
  import '../scripts/clinic-billing-software-progress';
</script>
