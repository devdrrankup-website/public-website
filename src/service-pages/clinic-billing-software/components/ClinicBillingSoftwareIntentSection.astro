---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-billing-software/clinic-billing-software-intent-v1.webp';
import { pageCopy } from '../data/clinic-billing-software-source';
const copy = pageCopy.intent;
import '../styles/clinic-billing-software-intent.css';
---
<clinic-billing-software-intent class="clinic-billing-software-intent">
  <section id="clinic-billing-software-intent" class="section-container clinic-billing-software-intent-layout" aria-labelledby="clinic-billing-software-intent-heading">
    <div class="clinic-billing-software-intent-copy" data-seo-intent-motion>
      <h2 id="clinic-billing-software-intent-heading">{copy.heading}</h2>
      <div class="clinic-billing-software-source-content" set:html={copy.html} />
    </div>
    <div class="clinic-billing-software-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Clinic receptionist reviewing service charges at a front desk computer"
        title="Clinic receptionist reviewing service charges at a front desk computer" />
    </div>
  </section>
</clinic-billing-software-intent>

<script>
  import '../scripts/clinic-billing-software-intent';
</script>
