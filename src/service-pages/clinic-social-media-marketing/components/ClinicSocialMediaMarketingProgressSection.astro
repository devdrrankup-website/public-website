---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-social-media-marketing/clinic-social-media-marketing-progress-v1.webp';
import { pageCopy } from '../data/clinic-social-media-marketing-source';
const copy = pageCopy.progress;
import '../styles/clinic-social-media-marketing-progress.css';
---
<clinic-social-media-marketing-progress class="clinic-social-media-marketing-progress-motion">
  <section id="clinic-social-media-marketing-progress" class="clinic-social-media-marketing-progress" aria-labelledby="clinic-social-media-marketing-progress-heading">
    <div class="section-container clinic-social-media-marketing-progress-layout">
      <h2 id="clinic-social-media-marketing-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="clinic-social-media-marketing-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="clinic-social-media-marketing-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Marketing specialist reviewing a clinic social media report" title="Marketing specialist reviewing a clinic social media report" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="clinic-social-media-marketing-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</clinic-social-media-marketing-progress>
<script>
  import '../scripts/clinic-social-media-marketing-progress';
</script>
