---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-social-media-marketing/clinic-social-media-marketing-example-v1.webp';
import { pageCopy } from '../data/clinic-social-media-marketing-source';
const copy = pageCopy.example;
import '../styles/clinic-social-media-marketing-example.css';
---
<clinic-social-media-marketing-example class="clinic-social-media-marketing-example-motion">
  <section id="clinic-social-media-marketing-example" class="clinic-social-media-marketing-example" aria-labelledby="clinic-social-media-marketing-example-heading">
    <div class="section-container clinic-social-media-marketing-example-layout">
      <header class="clinic-social-media-marketing-example-header" data-example-entry>
        <h2 id="clinic-social-media-marketing-example-heading">{copy.heading}</h2>
        <span class="clinic-social-media-marketing-example-rule" data-example-rule aria-hidden="true"></span>
      </header>
      <figure class="clinic-social-media-marketing-example-photo" data-example-entry data-example-photo>
        <Image src={photo} alt="Doctor and staff member comparing social information on their phones" title="Doctor and staff member comparing social information on their phones" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <div class="clinic-social-media-marketing-example-copy">
        <div class="clinic-social-media-marketing-source-content" data-example-entry set:html={copy.html} />
      </div>
    </div>
  </section>
</clinic-social-media-marketing-example>
<script>
  import '../scripts/clinic-social-media-marketing-example';
</script>
