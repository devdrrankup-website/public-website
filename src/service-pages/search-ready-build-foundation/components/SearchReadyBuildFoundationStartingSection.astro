---
import { Image } from 'astro:assets';
import photo from '../../../assets/search-ready-build-foundation/search-ready-build-foundation-starting-v1.webp';
import { pageCopy } from '../data/search-ready-build-foundation-source';
const copy = pageCopy.starting;
import '../styles/search-ready-build-foundation-starting.css';
---
<search-ready-build-foundation-starting class="search-ready-build-foundation-starting-motion">
  <section id="search-ready-build-foundation-starting" class="search-ready-build-foundation-starting" aria-labelledby="search-ready-build-foundation-starting-heading">
    <div class="section-container search-ready-build-foundation-starting-layout">
      <h2 id="search-ready-build-foundation-starting-heading" data-starting-entry>{copy.heading}</h2>
      <div class="search-ready-build-foundation-starting-copy" data-starting-entry>
        <div class="search-ready-build-foundation-source-content" set:html={copy.html} />
      </div>
      <figure class="search-ready-build-foundation-starting-visual" data-starting-entry data-starting-visual>
        <Image src={photo} alt="Doctor and developer mapping the website structure" title="Doctor and developer mapping the website structure" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 540px, (min-width:640px) 320px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>
</search-ready-build-foundation-starting>
<script>
  import '../scripts/search-ready-build-foundation-starting';
</script>
