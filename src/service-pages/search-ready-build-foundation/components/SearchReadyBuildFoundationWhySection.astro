---
import Icon from '../../../components/Icon.astro';
import UserAccountIcon from '@hugeicons/core-free-icons/UserAccountIcon';
import WorkflowSquare01Icon from '@hugeicons/core-free-icons/WorkflowSquare01Icon';
import TaskEdit01Icon from '@hugeicons/core-free-icons/TaskEdit01Icon';
import { pageCopy } from '../data/search-ready-build-foundation-source';
const copy = pageCopy.why;
const reasons = Array.from(copy.before.matchAll(/<p>([\s\S]*?)<\/p>/g), match => match[1]);
import '../styles/search-ready-build-foundation-why.css';
const visuals = [
  { icon: UserAccountIcon, accent: '#E1FFB9' },
  { icon: WorkflowSquare01Icon, accent: '#BAE5FF' },
  { icon: TaskEdit01Icon, accent: '#EEEDFE' },
];
---
<search-ready-build-foundation-why class="search-ready-build-foundation-why-motion">
  <section id="search-ready-build-foundation-why" class="search-ready-build-foundation-why" aria-labelledby="search-ready-build-foundation-why-heading">
    <div class="section-container search-ready-build-foundation-why-layout">
      <h2 id="search-ready-build-foundation-why-heading" data-why-entry>{copy.heading}</h2>
      {copy.items.length > 0 && <div class="search-ready-build-foundation-source-content" set:html={copy.before} />}
      {copy.items.length > 0 && <ul class="search-ready-build-foundation-why-principles">
        {copy.items.map((principle,index) => <li data-why-entry data-why-row>
          <span class="search-ready-build-foundation-why-icon" data-why-icon style={`--why-accent:${visuals[index % visuals.length].accent}`} aria-hidden="true"><Icon icon={visuals[index % visuals.length].icon} size={24} strokeWidth={1.7} /></span>
          <p><strong>{principle.label}</strong>{' '}{principle.description}</p>
        </li>)}
      </ul>}
      {copy.items.length === 0 && <ul class="search-ready-build-foundation-why-principles">
        {reasons.map((reason,index) => <li data-why-entry data-why-row>
          <span class="search-ready-build-foundation-why-icon" data-why-icon style={`--why-accent:${visuals[index % visuals.length].accent}`} aria-hidden="true"><Icon icon={visuals[index % visuals.length].icon} size={24} strokeWidth={1.7} /></span>
          <p set:html={reason} />
        </li>)}
      </ul>}
      <div class="search-ready-build-foundation-source-content" set:html={copy.after} />
    </div>
  </section>
</search-ready-build-foundation-why>
<script>
  import '../scripts/search-ready-build-foundation-why';
</script>
