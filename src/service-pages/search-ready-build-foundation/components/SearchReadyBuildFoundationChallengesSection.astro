---
import { Image } from 'astro:assets';
import photo from '../../../assets/search-ready-build-foundation/search-ready-build-foundation-challenges-v1.webp';
import { pageCopy } from '../data/search-ready-build-foundation-source';
const copy = pageCopy.challenges;
import { challengeEditorial as editorial } from '../data/search-ready-build-foundation-section-editorial';
import '../styles/search-ready-build-foundation-challenges.css';
---

<search-ready-build-foundation-challenges class="search-ready-build-foundation-challenges">
  <section id="search-ready-build-foundation-challenges" class="section-container search-ready-build-foundation-challenges-layout" aria-labelledby="search-ready-build-foundation-challenges-heading">
    <div class="search-ready-build-foundation-challenges-editorial">
      <h2 id="search-ready-build-foundation-challenges-heading">{copy.heading}</h2>
      <p class="search-ready-build-foundation-challenges-introduction" set:html={editorial.introduction} />
      <div class="search-ready-build-foundation-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Doctor and team reviewing a website that is hard to navigate"
          title="Doctor and team reviewing a website that is hard to navigate"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="search-ready-build-foundation-challenges-details">
      <p id="search-ready-build-foundation-challenges-list-heading" class="search-ready-build-foundation-challenges-list-intro">{editorial.listIntro}</p>
      <ul class="search-ready-build-foundation-challenges-list" role="list" aria-labelledby="search-ready-build-foundation-challenges-list-heading" data-seo-challenges-motion>
        {editorial.points.map((paragraph, index) => <li>
          <span class="search-ready-build-foundation-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={paragraph} />
        </li>)}
      </ul>
      <p class="search-ready-build-foundation-challenges-conclusion">{editorial.conclusion}</p>
    </div>
  </section>
</search-ready-build-foundation-challenges>

<script>
  import '../scripts/search-ready-build-foundation-challenges';
</script>
