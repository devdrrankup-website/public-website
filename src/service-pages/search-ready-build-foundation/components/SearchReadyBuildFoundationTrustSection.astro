---
import {linkOfficialGuidanceHtml} from '../../../lib/official-guidance';
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import photo from '../../../assets/search-ready-build-foundation/search-ready-build-foundation-trust-v1.webp';
import { pageCopy } from '../data/search-ready-build-foundation-source';
const copy = pageCopy.trust;
const officialLinks = new Set<string>();
const trustFirstHtml = linkOfficialGuidanceHtml(copy.firstHtml, officialLinks);
const trustRestHtml = linkOfficialGuidanceHtml(copy.restHtml, officialLinks);
import '../styles/search-ready-build-foundation-trust.css';
---

<search-ready-build-foundation-trust class="search-ready-build-foundation-trust-motion">
  <section id="search-ready-build-foundation-trust" class="search-ready-build-foundation-trust" aria-labelledby="search-ready-build-foundation-trust-heading">
    <div class="section-container search-ready-build-foundation-trust-layout">
      <h2 id="search-ready-build-foundation-trust-heading">{copy.heading}</h2>
      <div class="search-ready-build-foundation-trust-profile search-ready-build-foundation-source-content" data-seo-trust-motion set:html={trustFirstHtml} />
      <div class="search-ready-build-foundation-trust-photo" data-seo-trust-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76} loading="lazy" decoding="async"
          alt="Doctor and specialist verifying patient-facing website information"
          title="Doctor and specialist verifying patient-facing website information" />
      </div>
      <div class="search-ready-build-foundation-trust-privacy" data-seo-trust-motion>
        <span class="search-ready-build-foundation-trust-lock" aria-hidden="true"><Icon icon={LockKeyIcon} size={24} /></span>
        <div class="search-ready-build-foundation-source-content" set:html={trustRestHtml} />
      </div>
    </div>
  </section>
</search-ready-build-foundation-trust>

<script>
  import '../scripts/search-ready-build-foundation-trust';
</script>
