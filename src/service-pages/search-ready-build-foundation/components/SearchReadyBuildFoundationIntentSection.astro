---
import { Image } from 'astro:assets';
import photo from '../../../assets/search-ready-build-foundation/search-ready-build-foundation-intent-v1.webp';
import { pageCopy } from '../data/search-ready-build-foundation-source';
const copy = pageCopy.intent;
import '../styles/search-ready-build-foundation-intent.css';
---
<search-ready-build-foundation-intent class="search-ready-build-foundation-intent">
  <section id="search-ready-build-foundation-intent" class="section-container search-ready-build-foundation-intent-layout" aria-labelledby="search-ready-build-foundation-intent-heading">
    <div class="search-ready-build-foundation-intent-copy" data-seo-intent-motion>
      <h2 id="search-ready-build-foundation-intent-heading">{copy.heading}</h2>
      <div class="search-ready-build-foundation-source-content" set:html={copy.html} />
    </div>
    <div class="search-ready-build-foundation-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Doctor and specialist checking the site navigation on a monitor"
        title="Doctor and specialist checking the site navigation on a monitor" />
    </div>
  </section>
</search-ready-build-foundation-intent>

<script>
  import '../scripts/search-ready-build-foundation-intent';
</script>
