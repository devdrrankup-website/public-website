import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ProfessionalProfileAuthorityHero from './components/ProfessionalProfileAuthorityHero.astro';
import ProfessionalProfileAuthorityChallengesSection from './components/ProfessionalProfileAuthorityChallengesSection.astro';
import ProfessionalProfileAuthorityOutcomesSection from './components/ProfessionalProfileAuthorityOutcomesSection.astro';
import ProfessionalProfileAuthorityIntentSection from './components/ProfessionalProfileAuthorityIntentSection.astro';
import ProfessionalProfileAuthorityTrustSection from './components/ProfessionalProfileAuthorityTrustSection.astro';
import ProfessionalProfileAuthorityExpertiseSection from './components/ProfessionalProfileAuthorityExpertiseSection.astro';
import ProfessionalProfileAuthorityProcessSection from './components/ProfessionalProfileAuthorityProcessSection.astro';
import ProfessionalProfileAuthorityMappingSection from './components/ProfessionalProfileAuthorityMappingSection.astro';
import ProfessionalProfileAuthorityRelatedSection from './components/ProfessionalProfileAuthorityRelatedSection.astro';
import ProfessionalProfileAuthorityStartingSection from './components/ProfessionalProfileAuthorityStartingSection.astro';
import ProfessionalProfileAuthorityExampleSection from './components/ProfessionalProfileAuthorityExampleSection.astro';
import ProfessionalProfileAuthorityProgressSection from './components/ProfessionalProfileAuthorityProgressSection.astro';
import ProfessionalProfileAuthorityWhySection from './components/ProfessionalProfileAuthorityWhySection.astro';
import ProfessionalProfileAuthorityFaqSection from './components/ProfessionalProfileAuthorityFaqSection.astro';
import ProfessionalProfileAuthorityConsultationSection from './components/ProfessionalProfileAuthorityConsultationSection.astro';
import Footer from '../../components/Footer.astro';
import { professionalProfileAuthorityHeroPreload } from './lib/professional-profile-authority-hero-image';
