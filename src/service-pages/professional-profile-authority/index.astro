<Layout metadata={metadata} imagePreload={professionalProfileAuthorityHeroPreload}>
  <Navbar />
  <main id="main-content" class="professional-profile-authority-page" tabindex="-1">
    <ProfessionalProfileAuthorityHero />
    <ProfessionalProfileAuthorityChallengesSection />
    <ProfessionalProfileAuthorityOutcomesSection />
    <ProfessionalProfileAuthorityIntentSection />
    <ProfessionalProfileAuthorityTrustSection />
    <ProfessionalProfileAuthorityExpertiseSection />
    <ProfessionalProfileAuthorityProcessSection />
    <ProfessionalProfileAuthorityMappingSection />
    <ProfessionalProfileAuthorityRelatedSection />
    <ProfessionalProfileAuthorityStartingSection />
    <ProfessionalProfileAuthorityExampleSection />
    <ProfessionalProfileAuthorityProgressSection />
    <ProfessionalProfileAuthorityWhySection />
    <ProfessionalProfileAuthorityFaqSection />
    <ProfessionalProfileAuthorityConsultationSection />
  </main>
  <Footer />
</Layout>
