---
import { Image } from 'astro:assets';
import photo from '../../../assets/professional-profile-authority/professional-profile-authority-progress-v1.webp';
import { pageCopy } from '../data/professional-profile-authority-source';
const copy = pageCopy.progress;
import '../styles/professional-profile-authority-progress.css';
---
<professional-profile-authority-progress class="professional-profile-authority-progress-motion">
  <section id="professional-profile-authority-progress" class="professional-profile-authority-progress" aria-labelledby="professional-profile-authority-progress-heading">
    <div class="section-container professional-profile-authority-progress-layout">
      <h2 id="professional-profile-authority-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="professional-profile-authority-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="professional-profile-authority-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Doctor and team reviewing profile information and reports" title="Doctor and team reviewing profile information and reports" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="professional-profile-authority-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</professional-profile-authority-progress>
<script>
  import '../scripts/professional-profile-authority-progress';
</script>
