---
import ActionIcon from '../../../components/ActionIcon.astro';
import { pageCopy } from '../data/professional-profile-authority-source';
const copy = pageCopy.hero;
import { professionalProfileAuthorityHeroImage as photo } from '../lib/professional-profile-authority-hero-image';
import '../styles/professional-profile-authority-hero.css';
---

<section class="professional-profile-authority-hero" aria-labelledby="professional-profile-authority-heading">
  <div class="section-container professional-profile-authority-hero-layout">
    <div class="professional-profile-authority-hero-copy">
      <h1 id="professional-profile-authority-heading">{copy.heading}</h1>
      <p class="professional-profile-authority-hero-tagline">{copy.tagline}</p>
      <div class="professional-profile-authority-hero-description">
        {copy.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      </div>
      <div class="professional-profile-authority-hero-actions" aria-label={`${copy.heading} options`}>
        <span class="button button-primary">
          <span>{copy.primaryCta}</span><ActionIcon purpose="conversation" />
        </span>
        {copy.secondaryHref ? <a class="button button-secondary" href={copy.secondaryHref}>
          <span>{copy.secondaryCta}</span><ActionIcon purpose="conversation" />
        </a> : <span class="button button-secondary">
          <span>{copy.secondaryCta}</span><ActionIcon purpose="conversation" />
        </span>}
      </div>
    </div>
    <div class="professional-profile-authority-hero-visual">
      <div class="professional-profile-authority-hero-photo">
        <img src={photo.src} srcset={photo.srcset} sizes={photo.sizes}
          width={photo.width} height={photo.height}
          alt="Doctor and content editor checking professional profile and chamber details"
          title="Reviewing a doctor professional profile"
          loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
</section>
