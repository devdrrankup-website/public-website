---
import { Image } from 'astro:assets';
import photo from '../../../assets/professional-profile-authority/professional-profile-authority-intent-v1.webp';
import { pageCopy } from '../data/professional-profile-authority-source';
const copy = pageCopy.intent;
import '../styles/professional-profile-authority-intent.css';
---
<professional-profile-authority-intent class="professional-profile-authority-intent">
  <section id="professional-profile-authority-intent" class="section-container professional-profile-authority-intent-layout" aria-labelledby="professional-profile-authority-intent-heading">
    <div class="professional-profile-authority-intent-copy" data-seo-intent-motion>
      <h2 id="professional-profile-authority-intent-heading">{copy.heading}</h2>
      <div class="professional-profile-authority-source-content" set:html={copy.html} />
    </div>
    <div class="professional-profile-authority-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Woman looking up a doctor professional profile on her phone at home"
        title="Woman looking up a doctor professional profile on her phone at home" />
    </div>
  </section>
</professional-profile-authority-intent>

<script>
  import '../scripts/professional-profile-authority-intent';
</script>
