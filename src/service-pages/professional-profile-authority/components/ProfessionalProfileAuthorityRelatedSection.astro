---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import Arrow from '../../../components/Arrow.astro';
import PaintBrush01Icon from '@hugeicons/core-free-icons/PaintBrush01Icon';
import WebDesign01Icon from '@hugeicons/core-free-icons/WebDesign01Icon';
import Search01Icon from '@hugeicons/core-free-icons/Search01Icon';
import { pageCopy } from '../data/professional-profile-authority-source';
const copy = pageCopy.related;
import relatedImage0 from '../../../assets/doctor-personal-branding/doctor-personal-branding-related-preview-v1.webp';
import relatedImage1 from '../../../assets/related-services/doctor-website-development-preview-v1.webp';
import relatedImage2 from '../../../assets/related-services/doctor-seo-preview-v1.webp';
import '../styles/professional-profile-authority-related.css';
const visuals = [
  { image: relatedImage0, icon: PaintBrush01Icon, accent: '#BAE5FF', description: "In a doctor's own chamber, a civilian photographer prepares a natural professional portrait while the doctor adjusts ordinary work attire, without awards or staged patients." },
  { image: relatedImage1, icon: WebDesign01Icon, accent: '#EEEDFE', description: "At a Bangladesh digital agency design studio, a civilian web designer and a doctor review large unbranded doctor-website wireframes showing profile, chamber and booking blocks, from the viewer's side." },
  { image: relatedImage2, icon: Search01Icon, accent: '#FEF2CC', description: "At home in Bangladesh, a prospective patient compares two doctor profile pages on a front-facing laptop." },
];
---
<section id="professional-profile-authority-related" class="professional-profile-authority-related" aria-labelledby="professional-profile-authority-related-heading">
  <div class="section-container professional-profile-authority-related-container">
    <professional-profile-authority-related>
      <header class="professional-profile-authority-related-header" data-related-entry>
        <h2 id="professional-profile-authority-related-heading">{copy.heading}</h2>
        <div class="professional-profile-authority-source-content" set:html={copy.introductionHtml} />
      </header>
      <div class="professional-profile-authority-related-layout">
        <div class="professional-profile-authority-related-dock">
          <div class="professional-profile-authority-related-selectors" role="group" aria-label="Service image previews" hidden>
            {copy.services.map((service, index) => <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`related-${service.key}`} data-related-select={index}>
              <span>{service.name}</span>
            </button>)}
          </div>
          <div class="professional-profile-authority-related-stage" aria-hidden="true" hidden></div>
        </div>
        <div class="professional-profile-authority-related-details">
          <div class="professional-profile-authority-related-labels"><span>{copy.headers[0]}</span><span>{copy.headers[1]}</span></div>
          <dl class="professional-profile-authority-related-list">
            {copy.services.map((service, index) => <div class="professional-profile-authority-related-row" id={`related-${service.key}`} data-service={service.key}>
              <dt>
                <span class="professional-profile-authority-related-badge" style={`--related-accent:${visuals[index % visuals.length].accent}`}><Icon icon={visuals[index % visuals.length].icon} size={21} strokeWidth={1.8} /></span>
                <span class="professional-profile-authority-related-reveal" aria-hidden="true"></span>
                {service.href ? <a class="professional-profile-authority-related-name" href={service.href}>{service.name}</a>
                  : <span class="professional-profile-authority-related-name">{service.name}</span>}
                <span class="professional-profile-authority-related-arrow" aria-hidden="true"><Arrow /></span>
              </dt>
              <dd>
                <span>{service.responsibility}</span>
                <figure class="professional-profile-authority-related-photo">
                  <Image src={visuals[index % visuals.length].image} alt={visuals[index % visuals.length].description} title={visuals[index % visuals.length].description} width={960} widths={[360,640,960]} sizes="(min-width:1100px) 700px, (min-width:640px) 700px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
                  <figcaption>{service.name}</figcaption>
                </figure>
              </dd>
            </div>)}
          </dl>
          <div class="professional-profile-authority-related-note professional-profile-authority-source-content" set:html={copy.noteHtml} />
        </div>
      </div>
    </professional-profile-authority-related>
  </div>
</section>
<script>
  import '../scripts/professional-profile-authority-related';
</script>
