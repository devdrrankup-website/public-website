---
import Icon from '../../../components/Icon.astro';
import Add01Icon from '@hugeicons/core-free-icons/Add01Icon';
import { pageCopy } from '../data/professional-profile-authority-source';
const copy = pageCopy.faq;
import '../styles/professional-profile-authority-faq.css';
---
<professional-profile-authority-faq class="professional-profile-authority-faq-motion">
  <section id="professional-profile-authority-faq" class="professional-profile-authority-faq" aria-labelledby="professional-profile-authority-faq-heading">
    <div class="section-container professional-profile-authority-faq-layout">
      <header class="professional-profile-authority-faq-header" data-faq-entry>
        <h2 id="professional-profile-authority-faq-heading">{copy.heading}</h2>
        <div class="professional-profile-authority-source-content" set:html={copy.preface} />
      </header>
      <div class="professional-profile-authority-faq-list">
        {copy.items.map((item,index) => <article class="professional-profile-authority-faq-item" data-faq-entry aria-labelledby={`professional-profile-authority-faq-question-${index+1}`}>
          <h3 class="professional-profile-authority-faq-question" id={`professional-profile-authority-faq-question-${index+1}`}>
            <span class="professional-profile-authority-faq-label">{item.question}</span>
            <span class="professional-profile-authority-faq-toggle" aria-hidden="true"><Icon icon={Add01Icon} size={20} strokeWidth={1.8} /></span>
          </h3>
          <div class="professional-profile-authority-faq-answer" id={`professional-profile-authority-faq-answer-${index+1}`} role="region" aria-labelledby={`professional-profile-authority-faq-question-${index+1}`}>
            <div class="professional-profile-authority-source-content" set:html={item.answerHtml} />
          </div>
        </article>)}
      </div>
    </div>
  </section>
</professional-profile-authority-faq>
<script>
  import '../scripts/professional-profile-authority-faq';
</script>
