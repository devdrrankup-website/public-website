---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-google-business-profile/doctor-google-business-profile-progress-v1.webp';
import { pageCopy } from '../data/doctor-google-business-profile-source';
const copy = pageCopy.progress;
import '../styles/doctor-google-business-profile-progress.css';
---
<doctor-google-business-profile-progress class="doctor-google-business-profile-progress-motion">
  <section id="doctor-google-business-profile-progress" class="doctor-google-business-profile-progress" aria-labelledby="doctor-google-business-profile-progress-heading">
    <div class="section-container doctor-google-business-profile-progress-layout">
      <h2 id="doctor-google-business-profile-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="doctor-google-business-profile-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="doctor-google-business-profile-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Specialist reviewing a doctor location report" title="Specialist reviewing a doctor location report" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="doctor-google-business-profile-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</doctor-google-business-profile-progress>
<script>
  import '../scripts/doctor-google-business-profile-progress';
</script>
