---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import photo from '../../../assets/doctor-google-business-profile/doctor-google-business-profile-trust-v1.webp';
import { pageCopy } from '../data/doctor-google-business-profile-source';
const copy = pageCopy.trust;
import '../styles/doctor-google-business-profile-trust.css';
---

<doctor-google-business-profile-trust class="doctor-google-business-profile-trust-motion">
  <section id="doctor-google-business-profile-trust" class="doctor-google-business-profile-trust" aria-labelledby="doctor-google-business-profile-trust-heading">
    <div class="section-container doctor-google-business-profile-trust-layout">
      <h2 id="doctor-google-business-profile-trust-heading">{copy.heading}</h2>
      <div class="doctor-google-business-profile-trust-profile doctor-google-business-profile-source-content" data-seo-trust-motion set:html={copy.firstHtml} />
      <div class="doctor-google-business-profile-trust-photo" data-seo-trust-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76} loading="lazy" decoding="async"
          alt="Doctor and specialist verifying practice listing details"
          title="Doctor and specialist verifying practice listing details" />
      </div>
      <div class="doctor-google-business-profile-trust-privacy" data-seo-trust-motion>
        <span class="doctor-google-business-profile-trust-lock" aria-hidden="true"><Icon icon={LockKeyIcon} size={24} /></span>
        <div class="doctor-google-business-profile-source-content" set:html={copy.restHtml} />
      </div>
    </div>
  </section>
</doctor-google-business-profile-trust>

<script>
  import '../scripts/doctor-google-business-profile-trust';
</script>
