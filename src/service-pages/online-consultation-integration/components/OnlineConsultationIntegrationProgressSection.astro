---
import { Image } from 'astro:assets';
import photo from '../../../assets/online-consultation-integration/online-consultation-integration-progress-v1.webp';
import { pageCopy } from '../data/online-consultation-integration-source';
const copy = pageCopy.progress;
import '../styles/online-consultation-integration-progress.css';
---
<online-consultation-integration-progress class="online-consultation-integration-progress-motion">
  <section id="online-consultation-integration-progress" class="online-consultation-integration-progress" aria-labelledby="online-consultation-integration-progress-heading">
    <div class="section-container online-consultation-integration-progress-layout">
      <h2 id="online-consultation-integration-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="online-consultation-integration-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="online-consultation-integration-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Doctor and team reviewing online consultation records" title="Doctor and team reviewing online consultation records" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="online-consultation-integration-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</online-consultation-integration-progress>
<script>
  import '../scripts/online-consultation-integration-progress';
</script>
