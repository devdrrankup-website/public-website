---
import {linkOfficialGuidanceHtml} from '../../../lib/official-guidance';
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import photo from '../../../assets/online-consultation-integration/online-consultation-integration-trust-v1.webp';
import { pageCopy } from '../data/online-consultation-integration-source';
const copy = pageCopy.trust;
const officialLinks = new Set<string>();
const trustFirstHtml = linkOfficialGuidanceHtml(copy.firstHtml, officialLinks);
const trustRestHtml = linkOfficialGuidanceHtml(copy.restHtml, officialLinks);
import '../styles/online-consultation-integration-trust.css';
---

<online-consultation-integration-trust class="online-consultation-integration-trust-motion">
  <section id="online-consultation-integration-trust" class="online-consultation-integration-trust" aria-labelledby="online-consultation-integration-trust-heading">
    <div class="section-container online-consultation-integration-trust-layout">
      <h2 id="online-consultation-integration-trust-heading">{copy.heading}</h2>
      <div class="online-consultation-integration-trust-profile online-consultation-integration-source-content" data-seo-trust-motion set:html={trustFirstHtml} />
      <div class="online-consultation-integration-trust-photo" data-seo-trust-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76} loading="lazy" decoding="async"
          alt="Doctor and specialist reviewing online consultation privacy details"
          title="Doctor and specialist reviewing online consultation privacy details" />
      </div>
      <div class="online-consultation-integration-trust-privacy" data-seo-trust-motion>
        <span class="online-consultation-integration-trust-lock" aria-hidden="true"><Icon icon={LockKeyIcon} size={24} /></span>
        <div class="online-consultation-integration-source-content" set:html={trustRestHtml} />
      </div>
    </div>
  </section>
</online-consultation-integration-trust>

<script>
  import '../scripts/online-consultation-integration-trust';
</script>
