---
import { Image } from 'astro:assets';
import photo from '../../../assets/online-consultation-integration/online-consultation-integration-intent-v1.webp';
import { pageCopy } from '../data/online-consultation-integration-source';
const copy = pageCopy.intent;
import '../styles/online-consultation-integration-intent.css';
---
<online-consultation-integration-intent class="online-consultation-integration-intent">
  <section id="online-consultation-integration-intent" class="section-container online-consultation-integration-intent-layout" aria-labelledby="online-consultation-integration-intent-heading">
    <div class="online-consultation-integration-intent-copy" data-seo-intent-motion>
      <h2 id="online-consultation-integration-intent-heading">{copy.heading}</h2>
      <div class="online-consultation-integration-source-content" set:html={copy.html} />
    </div>
    <div class="online-consultation-integration-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Woman viewing an online consultation option on her phone at home"
        title="Woman viewing an online consultation option on her phone at home" />
    </div>
  </section>
</online-consultation-integration-intent>

<script>
  import '../scripts/online-consultation-integration-intent';
</script>
