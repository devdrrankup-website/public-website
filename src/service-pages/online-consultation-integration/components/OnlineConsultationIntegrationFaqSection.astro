---
import Icon from '../../../components/Icon.astro';
import Add01Icon from '@hugeicons/core-free-icons/Add01Icon';
import { pageCopy } from '../data/online-consultation-integration-source';
const copy = pageCopy.faq;
import '../styles/online-consultation-integration-faq.css';
---
<online-consultation-integration-faq class="online-consultation-integration-faq-motion">
  <section id="online-consultation-integration-faq" class="online-consultation-integration-faq" aria-labelledby="online-consultation-integration-faq-heading">
    <div class="section-container online-consultation-integration-faq-layout">
      <header class="online-consultation-integration-faq-header" data-faq-entry>
        <h2 id="online-consultation-integration-faq-heading">{copy.heading}</h2>
        <div class="online-consultation-integration-source-content" set:html={copy.preface} />
      </header>
      <div class="online-consultation-integration-faq-list">
        {copy.items.map((item,index) => <article class="online-consultation-integration-faq-item" data-faq-entry aria-labelledby={`online-consultation-integration-faq-question-${index+1}`}>
          <h3 class="online-consultation-integration-faq-question" id={`online-consultation-integration-faq-question-${index+1}`}>
            <span class="online-consultation-integration-faq-label">{item.question}</span>
            <span class="online-consultation-integration-faq-toggle" aria-hidden="true"><Icon icon={Add01Icon} size={20} strokeWidth={1.8} /></span>
          </h3>
          <div class="online-consultation-integration-faq-answer" id={`online-consultation-integration-faq-answer-${index+1}`} role="region" aria-labelledby={`online-consultation-integration-faq-question-${index+1}`}>
            <div class="online-consultation-integration-source-content" set:html={item.answerHtml} />
          </div>
        </article>)}
      </div>
    </div>
  </section>
</online-consultation-integration-faq>
<script>
  import '../scripts/online-consultation-integration-faq';
</script>
