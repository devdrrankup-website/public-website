---
import { Image } from 'astro:assets';
import photo from '../../../assets/patient-appointment-management/patient-appointment-management-example-v1.webp';
import { pageCopy } from '../data/patient-appointment-management-source';
const copy = pageCopy.example;
import '../styles/patient-appointment-management-example.css';
---
<patient-appointment-management-example class="patient-appointment-management-example-motion">
  <section id="patient-appointment-management-example" class="patient-appointment-management-example" aria-labelledby="patient-appointment-management-example-heading">
    <div class="section-container patient-appointment-management-example-layout">
      <header class="patient-appointment-management-example-header" data-example-entry>
        <h2 id="patient-appointment-management-example-heading">{copy.heading}</h2>
        <span class="patient-appointment-management-example-rule" data-example-rule aria-hidden="true"></span>
      </header>
      <figure class="patient-appointment-management-example-photo" data-example-entry data-example-photo>
        <Image src={photo} alt="Doctor and staff reviewing a patient appointment in the chamber" title="Doctor and staff reviewing a patient appointment in the chamber" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <div class="patient-appointment-management-example-copy">
        <div class="patient-appointment-management-source-content" data-example-entry set:html={copy.html} />
      </div>
    </div>
  </section>
</patient-appointment-management-example>
<script>
  import '../scripts/patient-appointment-management-example';
</script>
