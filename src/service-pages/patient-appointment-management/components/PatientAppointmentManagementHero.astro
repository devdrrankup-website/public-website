---
import ActionIcon from '../../../components/ActionIcon.astro';
import { pageCopy } from '../data/patient-appointment-management-source';
const copy = pageCopy.hero;
import { patientAppointmentManagementHeroImage as photo } from '../lib/patient-appointment-management-hero-image';
import '../styles/patient-appointment-management-hero.css';
---

<section class="patient-appointment-management-hero" aria-labelledby="patient-appointment-management-heading">
  <div class="section-container patient-appointment-management-hero-layout">
    <div class="patient-appointment-management-hero-copy">
      <h1 id="patient-appointment-management-heading">{copy.heading}</h1>
      <p class="patient-appointment-management-hero-tagline">{copy.tagline}</p>
      <div class="patient-appointment-management-hero-description">
        {copy.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      </div>
      <div class="patient-appointment-management-hero-actions" aria-label={`${copy.heading} options`}>
        <a class="button button-primary" href="/contact/">
          <span>{copy.primaryCta}</span><ActionIcon purpose="conversation" />
        </a>
        <a class="button button-secondary" href={copy.secondaryHref}>
          <span>{copy.secondaryCta}</span><ActionIcon purpose="conversation" />
        </a>
      </div>
    </div>
    <div class="patient-appointment-management-hero-visual">
      <div class="patient-appointment-management-hero-photo">
        <img src={photo.src} srcset={photo.srcset} sizes={photo.sizes}
          width={photo.width} height={photo.height}
          alt="Chamber staff checking appointment arrivals and doctor sessions at reception"
          title="Coordinating patient appointments at reception"
          loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
</section>
