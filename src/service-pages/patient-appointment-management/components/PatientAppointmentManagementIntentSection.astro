---
import { Image } from 'astro:assets';
import photo from '../../../assets/patient-appointment-management/patient-appointment-management-intent-v1.webp';
import { pageCopy } from '../data/patient-appointment-management-source';
const copy = pageCopy.intent;
import '../styles/patient-appointment-management-intent.css';
---
<patient-appointment-management-intent class="patient-appointment-management-intent">
  <section id="patient-appointment-management-intent" class="section-container patient-appointment-management-intent-layout" aria-labelledby="patient-appointment-management-intent-heading">
    <div class="patient-appointment-management-intent-copy" data-seo-intent-motion>
      <h2 id="patient-appointment-management-intent-heading">{copy.heading}</h2>
      <div class="patient-appointment-management-source-content" set:html={copy.html} />
    </div>
    <div class="patient-appointment-management-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Woman checking a doctor appointment option on her phone at home"
        title="Woman checking a doctor appointment option on her phone at home" />
    </div>
  </section>
</patient-appointment-management-intent>

<script>
  import '../scripts/patient-appointment-management-intent';
</script>
