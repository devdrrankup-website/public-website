---
import { Image } from 'astro:assets';
import photo from '../../../assets/patient-appointment-management/patient-appointment-management-starting-v1.webp';
import { pageCopy } from '../data/patient-appointment-management-source';
const copy = pageCopy.starting;
import '../styles/patient-appointment-management-starting.css';
---
<patient-appointment-management-starting class="patient-appointment-management-starting-motion">
  <section id="patient-appointment-management-starting" class="patient-appointment-management-starting" aria-labelledby="patient-appointment-management-starting-heading">
    <div class="section-container patient-appointment-management-starting-layout">
      <h2 id="patient-appointment-management-starting-heading" data-starting-entry>{copy.heading}</h2>
      <div class="patient-appointment-management-starting-copy" data-starting-entry>
        <div class="patient-appointment-management-source-content" set:html={copy.html} />
      </div>
      <figure class="patient-appointment-management-starting-visual" data-starting-entry data-starting-visual>
        <Image src={photo} alt="Doctor and specialist planning patient appointment handling" title="Doctor and specialist planning patient appointment handling" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 540px, (min-width:640px) 320px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>
</patient-appointment-management-starting>
<script>
  import '../scripts/patient-appointment-management-starting';
</script>
