---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-website/clinic-website-challenges-v1.webp';
import { pageCopy } from '../data/clinic-website-source';
const copy = pageCopy.challenges;
import { challengeEditorial as editorial } from '../data/clinic-website-section-editorial';
import '../styles/clinic-website-challenges.css';
---

<clinic-website-challenges class="clinic-website-challenges">
  <section id="clinic-website-challenges" class="section-container clinic-website-challenges-layout" aria-labelledby="clinic-website-challenges-heading">
    <div class="clinic-website-challenges-editorial">
      <h2 id="clinic-website-challenges-heading">{copy.heading}</h2>
      <p class="clinic-website-challenges-introduction" set:html={editorial.introduction} />
      <div class="clinic-website-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Clinic staff comparing website information against printed records"
          title="Clinic staff comparing website information against printed records"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="clinic-website-challenges-details">
      <p id="clinic-website-challenges-list-heading" class="clinic-website-challenges-list-intro">{editorial.listIntro}</p>
      <ul class="clinic-website-challenges-list" role="list" aria-labelledby="clinic-website-challenges-list-heading" data-seo-challenges-motion>
        {editorial.points.map((paragraph, index) => <li>
          <span class="clinic-website-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={paragraph} />
        </li>)}
      </ul>
      <p class="clinic-website-challenges-conclusion">{editorial.conclusion}</p>
    </div>
  </section>
</clinic-website-challenges>

<script>
  import '../scripts/clinic-website-challenges';
</script>
