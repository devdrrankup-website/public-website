---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-website/clinic-website-progress-v1.webp';
import { pageCopy } from '../data/clinic-website-source';
const copy = pageCopy.progress;
import '../styles/clinic-website-progress.css';
---
<clinic-website-progress class="clinic-website-progress-motion">
  <section id="clinic-website-progress" class="clinic-website-progress" aria-labelledby="clinic-website-progress-heading">
    <div class="section-container clinic-website-progress-layout">
      <h2 id="clinic-website-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="clinic-website-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="clinic-website-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Clinic team reviewing website reports together at reception" title="Clinic team reviewing website reports together at reception" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="clinic-website-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</clinic-website-progress>
<script>
  import '../scripts/clinic-website-progress';
</script>
