---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-social-media-marketing/doctor-social-media-marketing-starting-v1.webp';
import { pageCopy } from '../data/doctor-social-media-marketing-source';
const copy = pageCopy.starting;
import '../styles/doctor-social-media-marketing-starting.css';
---
<doctor-social-media-marketing-starting class="doctor-social-media-marketing-starting-motion">
  <section id="doctor-social-media-marketing-starting" class="doctor-social-media-marketing-starting" aria-labelledby="doctor-social-media-marketing-starting-heading">
    <div class="section-container doctor-social-media-marketing-starting-layout">
      <h2 id="doctor-social-media-marketing-starting-heading" data-starting-entry>{copy.heading}</h2>
      <div class="doctor-social-media-marketing-starting-copy" data-starting-entry>
        <div class="doctor-social-media-marketing-source-content" set:html={copy.html} />
      </div>
      <figure class="doctor-social-media-marketing-starting-visual" data-starting-entry data-starting-visual>
        <Image src={photo} alt="Doctor and marketer planning social media content" title="Doctor and marketer planning social media content" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 540px, (min-width:640px) 320px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>
</doctor-social-media-marketing-starting>
<script>
  import '../scripts/doctor-social-media-marketing-starting';
</script>
