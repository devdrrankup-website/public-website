---
import { Image } from 'astro:assets';
import photo from '../../../assets/diagnostic-management/diagnostic-management-intent-v1.webp';
import { pageCopy } from '../data/diagnostic-management-source';
const copy = pageCopy.intent;
import '../styles/diagnostic-management-intent.css';
---
<diagnostic-management-intent class="diagnostic-management-intent">
  <section id="diagnostic-management-intent" class="section-container diagnostic-management-intent-layout" aria-labelledby="diagnostic-management-intent-heading">
    <div class="diagnostic-management-intent-copy" data-seo-intent-motion>
      <h2 id="diagnostic-management-intent-heading">{copy.heading}</h2>
      <div class="diagnostic-management-source-content" set:html={copy.html} />
    </div>
    <div class="diagnostic-management-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Laboratory staff checking a diagnostic workflow on a front-facing monitor"
        title="Laboratory staff checking a diagnostic workflow on a front-facing monitor" />
    </div>
  </section>
</diagnostic-management-intent>

<script>
  import '../scripts/diagnostic-management-intent';
</script>
