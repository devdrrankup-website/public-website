---
import { Image } from 'astro:assets';
import photo from '../../../assets/diagnostic-management/diagnostic-management-example-v1.webp';
import { pageCopy } from '../data/diagnostic-management-source';
const copy = pageCopy.example;
import '../styles/diagnostic-management-example.css';
---
<diagnostic-management-example class="diagnostic-management-example-motion">
  <section id="diagnostic-management-example" class="diagnostic-management-example" aria-labelledby="diagnostic-management-example-heading">
    <div class="section-container diagnostic-management-example-layout">
      <header class="diagnostic-management-example-header" data-example-entry>
        <h2 id="diagnostic-management-example-heading">{copy.heading}</h2>
        <span class="diagnostic-management-example-rule" data-example-rule aria-hidden="true"></span>
      </header>
      <figure class="diagnostic-management-example-photo" data-example-entry data-example-photo>
        <Image src={photo} alt="Laboratory staff checking a sample handoff against a computer record" title="Laboratory staff checking a sample handoff against a computer record" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <div class="diagnostic-management-example-copy">
        <div class="diagnostic-management-source-content" data-example-entry set:html={copy.html} />
      </div>
    </div>
  </section>
</diagnostic-management-example>
<script>
  import '../scripts/diagnostic-management-example';
</script>
