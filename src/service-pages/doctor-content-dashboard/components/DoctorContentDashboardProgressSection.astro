---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-content-dashboard/doctor-content-dashboard-progress-v1.webp';
import { pageCopy } from '../data/doctor-content-dashboard-source';
const copy = pageCopy.progress;
import '../styles/doctor-content-dashboard-progress.css';
---
<doctor-content-dashboard-progress class="doctor-content-dashboard-progress-motion">
  <section id="doctor-content-dashboard-progress" class="doctor-content-dashboard-progress" aria-labelledby="doctor-content-dashboard-progress-heading">
    <div class="section-container doctor-content-dashboard-progress-layout">
      <h2 id="doctor-content-dashboard-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="doctor-content-dashboard-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="doctor-content-dashboard-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Doctor and team reviewing a content dashboard report" title="Doctor and team reviewing a content dashboard report" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="doctor-content-dashboard-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</doctor-content-dashboard-progress>
<script>
  import '../scripts/doctor-content-dashboard-progress';
</script>
