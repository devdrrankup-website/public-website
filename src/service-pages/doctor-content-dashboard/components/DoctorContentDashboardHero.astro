---
import ActionIcon from '../../../components/ActionIcon.astro';
import { pageCopy } from '../data/doctor-content-dashboard-source';
const copy = pageCopy.hero;
import { doctorContentDashboardHeroImage as photo } from '../lib/doctor-content-dashboard-hero-image';
import '../styles/doctor-content-dashboard-hero.css';
---

<section class="doctor-content-dashboard-hero" aria-labelledby="doctor-content-dashboard-heading">
  <div class="section-container doctor-content-dashboard-hero-layout">
    <div class="doctor-content-dashboard-hero-copy">
      <h1 id="doctor-content-dashboard-heading">{copy.heading}</h1>
      <p class="doctor-content-dashboard-hero-tagline">{copy.tagline}</p>
      <div class="doctor-content-dashboard-hero-description">
        {copy.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      </div>
      <div class="doctor-content-dashboard-hero-actions" aria-label={`${copy.heading} options`}>
        <span class="button button-primary">
          <span>{copy.primaryCta}</span><ActionIcon purpose="conversation" />
        </span>
        {copy.secondaryHref ? <a class="button button-secondary" href={copy.secondaryHref}>
          <span>{copy.secondaryCta}</span><ActionIcon purpose="conversation" />
        </a> : <span class="button button-secondary">
          <span>{copy.secondaryCta}</span><ActionIcon purpose="conversation" />
        </span>}
      </div>
    </div>
    <div class="doctor-content-dashboard-hero-visual">
      <div class="doctor-content-dashboard-hero-photo">
        <img src={photo.src} srcset={photo.srcset} sizes={photo.sizes}
          width={photo.width} height={photo.height}
          alt="Sirajul Islam and a colleague reviewing doctor profile updates at an agency workstation"
          title="Planning a doctor content dashboard"
          loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
</section>
