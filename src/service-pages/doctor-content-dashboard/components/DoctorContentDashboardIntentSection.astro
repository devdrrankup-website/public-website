---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-content-dashboard/doctor-content-dashboard-intent-v1.webp';
import { pageCopy } from '../data/doctor-content-dashboard-source';
const copy = pageCopy.intent;
import '../styles/doctor-content-dashboard-intent.css';
---
<doctor-content-dashboard-intent class="doctor-content-dashboard-intent">
  <section id="doctor-content-dashboard-intent" class="section-container doctor-content-dashboard-intent-layout" aria-labelledby="doctor-content-dashboard-intent-heading">
    <div class="doctor-content-dashboard-intent-copy" data-seo-intent-motion>
      <h2 id="doctor-content-dashboard-intent-heading">{copy.heading}</h2>
      <div class="doctor-content-dashboard-source-content" set:html={copy.html} />
    </div>
    <div class="doctor-content-dashboard-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Doctor and staff member reviewing a website dashboard in the chamber"
        title="Doctor and staff member reviewing a website dashboard in the chamber" />
    </div>
  </section>
</doctor-content-dashboard-intent>

<script>
  import '../scripts/doctor-content-dashboard-intent';
</script>
