---
import Icon from '../../../components/Icon.astro';
import UserAccountIcon from '@hugeicons/core-free-icons/UserAccountIcon';
import WorkflowSquare01Icon from '@hugeicons/core-free-icons/WorkflowSquare01Icon';
import TaskEdit01Icon from '@hugeicons/core-free-icons/TaskEdit01Icon';
import { pageCopy } from '../data/hospital-social-media-marketing-source';
import '../styles/hospital-social-media-marketing-why.css';
const copy = pageCopy.why;
const reasons = copy.items;
const visuals = [
  { icon: UserAccountIcon, accent: '#E1FFB9' },
  { icon: WorkflowSquare01Icon, accent: '#BAE5FF' },
  { icon: TaskEdit01Icon, accent: '#EEEDFE' },
];
---
<hospital-social-media-marketing-why class="hospital-social-media-marketing-why-motion">
  <section id="hospital-social-media-marketing-why" class="hospital-social-media-marketing-why" aria-labelledby="hospital-social-media-marketing-why-heading">
    <div class="section-container hospital-social-media-marketing-why-layout">
      <h2 id="hospital-social-media-marketing-why-heading" data-why-entry>{copy.heading}</h2>
      <div class="hospital-social-media-marketing-why-body">
        <ul class="hospital-social-media-marketing-why-principles">
          {reasons.map((principle,index) => <li data-why-entry data-why-row>
            <span class="hospital-social-media-marketing-why-icon" data-why-icon style={`--why-accent:${visuals[index % visuals.length].accent}`} aria-hidden="true"><Icon icon={visuals[index % visuals.length].icon} size={24} strokeWidth={1.7} /></span>
            <p><strong>{principle.label}</strong>{' '}{principle.description}</p>
          </li>)}
        </ul>
      </div>
    </div>
  </section>
</hospital-social-media-marketing-why>
<script>
  import '../scripts/hospital-social-media-marketing-why';
</script>
