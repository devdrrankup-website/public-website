---
import { Image } from 'astro:assets';
import photo from '../../../assets/patient-fee-management/patient-fee-management-challenges-v1.webp';
import { pageCopy } from '../data/patient-fee-management-source';
const copy = pageCopy.challenges;
import { challengeEditorial as editorial } from '../data/patient-fee-management-section-editorial';
import '../styles/patient-fee-management-challenges.css';
---

<patient-fee-management-challenges class="patient-fee-management-challenges">
  <section id="patient-fee-management-challenges" class="section-container patient-fee-management-challenges-layout" aria-labelledby="patient-fee-management-challenges-heading">
    <div class="patient-fee-management-challenges-editorial">
      <h2 id="patient-fee-management-challenges-heading">{copy.heading}</h2>
      <p class="patient-fee-management-challenges-introduction" set:html={editorial.introduction} />
      <div class="patient-fee-management-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Doctor and staff checking receipts and fee records in a chamber"
          title="Doctor and staff checking receipts and fee records in a chamber"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="patient-fee-management-challenges-details">
      <p id="patient-fee-management-challenges-list-heading" class="patient-fee-management-challenges-list-intro">{editorial.listIntro}</p>
      <ul class="patient-fee-management-challenges-list" role="list" aria-labelledby="patient-fee-management-challenges-list-heading" data-seo-challenges-motion>
        {editorial.points.map((paragraph, index) => <li>
          <span class="patient-fee-management-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={paragraph} />
        </li>)}
      </ul>
      <p class="patient-fee-management-challenges-conclusion">{editorial.conclusion}</p>
    </div>
  </section>
</patient-fee-management-challenges>

<script>
  import '../scripts/patient-fee-management-challenges';
</script>
