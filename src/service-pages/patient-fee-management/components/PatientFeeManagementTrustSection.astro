---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import photo from '../../../assets/patient-fee-management/patient-fee-management-trust-v1.webp';
import { pageCopy } from '../data/patient-fee-management-source';
const copy = pageCopy.trust;
import '../styles/patient-fee-management-trust.css';
---

<patient-fee-management-trust class="patient-fee-management-trust-motion">
  <section id="patient-fee-management-trust" class="patient-fee-management-trust" aria-labelledby="patient-fee-management-trust-heading">
    <div class="section-container patient-fee-management-trust-layout">
      <h2 id="patient-fee-management-trust-heading">{copy.heading}</h2>
      <div class="patient-fee-management-trust-profile patient-fee-management-source-content" data-seo-trust-motion set:html={copy.firstHtml} />
      <div class="patient-fee-management-trust-photo" data-seo-trust-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76} loading="lazy" decoding="async"
          alt="Doctor and manager verifying fee information and privacy"
          title="Doctor and manager verifying fee information and privacy" />
      </div>
      <div class="patient-fee-management-trust-privacy" data-seo-trust-motion>
        <span class="patient-fee-management-trust-lock" aria-hidden="true"><Icon icon={LockKeyIcon} size={24} /></span>
        <div class="patient-fee-management-source-content" set:html={copy.restHtml} />
      </div>
    </div>
  </section>
</patient-fee-management-trust>

<script>
  import '../scripts/patient-fee-management-trust';
</script>
