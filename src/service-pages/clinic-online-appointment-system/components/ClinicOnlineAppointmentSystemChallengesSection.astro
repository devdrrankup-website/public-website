---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-online-appointment-system/clinic-online-appointment-system-challenges-v1.webp';
import { pageCopy } from '../data/clinic-online-appointment-system-source';
const copy = pageCopy.challenges;
import { challengeEditorial as editorial } from '../data/clinic-online-appointment-system-section-editorial';
import '../styles/clinic-online-appointment-system-challenges.css';
---

<clinic-online-appointment-system-challenges class="clinic-online-appointment-system-challenges">
  <section id="clinic-online-appointment-system-challenges" class="section-container clinic-online-appointment-system-challenges-layout" aria-labelledby="clinic-online-appointment-system-challenges-heading">
    <div class="clinic-online-appointment-system-challenges-editorial">
      <h2 id="clinic-online-appointment-system-challenges-heading">{copy.heading}</h2>
      <p class="clinic-online-appointment-system-challenges-introduction" set:html={editorial.introduction} />
      <div class="clinic-online-appointment-system-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Receptionist reconciling appointment papers and phone calls at a clinic"
          title="Receptionist reconciling appointment papers and phone calls at a clinic"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="clinic-online-appointment-system-challenges-details">
      <p id="clinic-online-appointment-system-challenges-list-heading" class="clinic-online-appointment-system-challenges-list-intro">{editorial.listIntro}</p>
      <ul class="clinic-online-appointment-system-challenges-list" role="list" aria-labelledby="clinic-online-appointment-system-challenges-list-heading" data-seo-challenges-motion>
        {editorial.points.map((paragraph, index) => <li>
          <span class="clinic-online-appointment-system-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={paragraph} />
        </li>)}
      </ul>
      <p class="clinic-online-appointment-system-challenges-conclusion">{editorial.conclusion}</p>
    </div>
  </section>
</clinic-online-appointment-system-challenges>

<script>
  import '../scripts/clinic-online-appointment-system-challenges';
</script>
