---
import Icon from '../../../components/Icon.astro';
import UserAccountIcon from '@hugeicons/core-free-icons/UserAccountIcon';
import WorkflowSquare01Icon from '@hugeicons/core-free-icons/WorkflowSquare01Icon';
import TaskEdit01Icon from '@hugeicons/core-free-icons/TaskEdit01Icon';
import { pageCopy } from '../data/clinic-online-appointment-system-source';
import { whyEditorial } from '../data/clinic-online-appointment-system-section-editorial';
import '../styles/clinic-online-appointment-system-why.css';
const copy = pageCopy.why;
const reasons = whyEditorial;
const visuals = [
  { icon: UserAccountIcon, accent: '#E1FFB9' },
  { icon: WorkflowSquare01Icon, accent: '#BAE5FF' },
  { icon: TaskEdit01Icon, accent: '#EEEDFE' },
];
---
<clinic-online-appointment-system-why class="clinic-online-appointment-system-why-motion">
  <section id="clinic-online-appointment-system-why" class="clinic-online-appointment-system-why" aria-labelledby="clinic-online-appointment-system-why-heading">
    <div class="section-container clinic-online-appointment-system-why-layout">
      <h2 id="clinic-online-appointment-system-why-heading" data-why-entry>{copy.heading}</h2>
      <div class="clinic-online-appointment-system-why-body">
        <ul class="clinic-online-appointment-system-why-principles">
          {reasons.map((principle,index) => <li data-why-entry data-why-row>
            <span class="clinic-online-appointment-system-why-icon" data-why-icon style={`--why-accent:${visuals[index % visuals.length].accent}`} aria-hidden="true"><Icon icon={visuals[index % visuals.length].icon} size={24} strokeWidth={1.7} /></span>
            <p><strong>{principle.label}</strong>{' '}{principle.description}</p>
          </li>)}
        </ul>
        <a class="button button-secondary" href="/about/" data-why-entry>About Dr RankUP</a>
      </div>
    </div>
  </section>
</clinic-online-appointment-system-why>
<script>
  import '../scripts/clinic-online-appointment-system-why';
</script>
