---
import { Image } from 'astro:assets';
import photo from '../../../assets/appointment-booking-integration/patient-chooses-session-at-home-v1.webp';
import { pageCopy } from '../data/appointment-booking-integration-source';
const copy = pageCopy.intent;
import '../styles/appointment-booking-integration-intent.css';
---
<appointment-booking-integration-intent class="appointment-booking-integration-intent">
  <section id="appointment-booking-integration-intent" class="section-container appointment-booking-integration-intent-layout" aria-labelledby="appointment-booking-integration-intent-heading">
    <div class="appointment-booking-integration-intent-copy" data-seo-intent-motion>
      <h2 id="appointment-booking-integration-intent-heading">{copy.heading}</h2>
      <div class="appointment-booking-integration-source-content" set:html={copy.html} />
    </div>
    <div class="appointment-booking-integration-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Man choosing a doctor appointment session on his phone at home"
        title="Patient selecting a doctor appointment session from home" />
    </div>
  </section>
</appointment-booking-integration-intent>

<script>
  import '../scripts/appointment-booking-integration-intent';
</script>
