---
import { Image } from 'astro:assets';
import photo from '../../../assets/appointment-booking-integration/appointment-operations-review-v1.webp';
import { pageCopy } from '../data/appointment-booking-integration-source';
const copy = pageCopy.progress;
import '../styles/appointment-booking-integration-progress.css';
---
<appointment-booking-integration-progress class="appointment-booking-integration-progress-motion">
  <section id="appointment-booking-integration-progress" class="appointment-booking-integration-progress" aria-labelledby="appointment-booking-integration-progress-heading">
    <div class="section-container appointment-booking-integration-progress-layout">
      <h2 id="appointment-booking-integration-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="appointment-booking-integration-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="appointment-booking-integration-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Software analyst and receptionist reviewing appointment status and form results" title="Reviewing booking handoff and request outcomes" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="appointment-booking-integration-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</appointment-booking-integration-progress>
<script>
  import '../scripts/appointment-booking-integration-progress';
</script>
