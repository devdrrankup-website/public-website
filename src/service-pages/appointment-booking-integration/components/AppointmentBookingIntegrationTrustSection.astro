---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import photo from '../../../assets/appointment-booking-integration/booking-privacy-review-v1.webp';
import { pageCopy } from '../data/appointment-booking-integration-source';
const copy = pageCopy.trust;
import '../styles/appointment-booking-integration-trust.css';
---

<appointment-booking-integration-trust class="appointment-booking-integration-trust-motion">
  <section id="appointment-booking-integration-trust" class="appointment-booking-integration-trust" aria-labelledby="appointment-booking-integration-trust-heading">
    <div class="section-container appointment-booking-integration-trust-layout">
      <h2 id="appointment-booking-integration-trust-heading">{copy.heading}</h2>
      <div class="appointment-booking-integration-trust-profile appointment-booking-integration-source-content" data-seo-trust-motion set:html={copy.firstHtml} />
      <div class="appointment-booking-integration-trust-photo" data-seo-trust-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76} loading="lazy" decoding="async"
          alt="Doctor and chamber manager reviewing an appointment privacy procedure"
          title="Reviewing which patient details a booking form needs" />
      </div>
      <div class="appointment-booking-integration-trust-privacy" data-seo-trust-motion>
        <span class="appointment-booking-integration-trust-lock" aria-hidden="true"><Icon icon={LockKeyIcon} size={24} /></span>
        <div class="appointment-booking-integration-source-content" set:html={copy.restHtml} />
      </div>
    </div>
  </section>
</appointment-booking-integration-trust>

<script>
  import '../scripts/appointment-booking-integration-trust';
</script>
