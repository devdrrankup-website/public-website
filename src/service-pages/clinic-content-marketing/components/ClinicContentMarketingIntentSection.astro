---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-content-marketing/clinic-content-marketing-intent-v1.webp';
import { pageCopy } from '../data/clinic-content-marketing-source';
const copy = pageCopy.intent;
import '../styles/clinic-content-marketing-intent.css';
---
<clinic-content-marketing-intent class="clinic-content-marketing-intent">
  <section id="clinic-content-marketing-intent" class="section-container clinic-content-marketing-intent-layout" aria-labelledby="clinic-content-marketing-intent-heading">
    <div class="clinic-content-marketing-intent-copy" data-seo-intent-motion>
      <h2 id="clinic-content-marketing-intent-heading">{copy.heading}</h2>
      <div class="clinic-content-marketing-source-content" set:html={copy.html} />
    </div>
    <div class="clinic-content-marketing-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Woman comparing clinic information on a laptop at home"
        title="Woman comparing clinic information on a laptop at home" />
    </div>
  </section>
</clinic-content-marketing-intent>

<script>
  import '../scripts/clinic-content-marketing-intent';
</script>
