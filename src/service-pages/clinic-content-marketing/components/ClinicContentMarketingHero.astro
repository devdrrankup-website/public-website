---
import ActionIcon from '../../../components/ActionIcon.astro';
import { pageCopy } from '../data/clinic-content-marketing-source';
const copy = pageCopy.hero;
import { clinicContentMarketingHeroImage as photo } from '../lib/clinic-content-marketing-hero-image';
import '../styles/clinic-content-marketing-hero.css';
---

<section class="clinic-content-marketing-hero" aria-labelledby="clinic-content-marketing-heading">
  <div class="section-container clinic-content-marketing-hero-layout">
    <div class="clinic-content-marketing-hero-copy">
      <h1 id="clinic-content-marketing-heading">{copy.heading}</h1>
      <p class="clinic-content-marketing-hero-tagline">{copy.tagline}</p>
      <div class="clinic-content-marketing-hero-description">
        {copy.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      </div>
      <div class="clinic-content-marketing-hero-actions" aria-label={`${copy.heading} options`}>
        <a class="button button-primary" href="/contact/">
          <span>{copy.primaryCta}</span><ActionIcon purpose="conversation" />
        </a>
        <a class="button button-secondary" href={copy.secondaryHref}>
          <span>{copy.secondaryCta}</span><ActionIcon purpose="conversation" />
        </a>
      </div>
    </div>
    <div class="clinic-content-marketing-hero-visual">
      <div class="clinic-content-marketing-hero-photo">
        <img src={photo.src} srcset={photo.srcset} sizes={photo.sizes}
          width={photo.width} height={photo.height}
          alt="Doctor and content specialist reviewing patient information in a clinic meeting room"
          title="Checking clinic content before publication"
          loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
</section>
