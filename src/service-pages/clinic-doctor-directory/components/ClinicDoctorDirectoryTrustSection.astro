---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import photo from '../../../assets/clinic-doctor-directory/clinic-doctor-directory-trust-v1.webp';
import { pageCopy } from '../data/clinic-doctor-directory-source';
const copy = pageCopy.trust;
import '../styles/clinic-doctor-directory-trust.css';
---

<clinic-doctor-directory-trust class="clinic-doctor-directory-trust-motion">
  <section id="clinic-doctor-directory-trust" class="clinic-doctor-directory-trust" aria-labelledby="clinic-doctor-directory-trust-heading">
    <div class="section-container clinic-doctor-directory-trust-layout">
      <h2 id="clinic-doctor-directory-trust-heading">{copy.heading}</h2>
      <div class="clinic-doctor-directory-trust-profile clinic-doctor-directory-source-content" data-seo-trust-motion set:html={copy.firstHtml} />
      <div class="clinic-doctor-directory-trust-photo" data-seo-trust-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76} loading="lazy" decoding="async"
          alt="Clinician and manager checking professional details before publication"
          title="Clinician and manager checking professional details before publication" />
      </div>
      <div class="clinic-doctor-directory-trust-privacy" data-seo-trust-motion>
        <span class="clinic-doctor-directory-trust-lock" aria-hidden="true"><Icon icon={LockKeyIcon} size={24} /></span>
        <div class="clinic-doctor-directory-source-content" set:html={copy.restHtml} />
      </div>
    </div>
  </section>
</clinic-doctor-directory-trust>

<script>
  import '../scripts/clinic-doctor-directory-trust';
</script>
