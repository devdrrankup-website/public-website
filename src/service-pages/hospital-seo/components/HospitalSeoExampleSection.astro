---
import { Image } from 'astro:assets';
import photo from '../../../assets/hospital-seo/hospital-seo-example-v1.webp';
import { pageCopy } from '../data/hospital-seo-source';
const copy = pageCopy.example;
import '../styles/hospital-seo-example.css';
---
<hospital-seo-example class="hospital-seo-example-motion">
  <section id="hospital-seo-example" class="hospital-seo-example" aria-labelledby="hospital-seo-example-heading">
    <div class="section-container hospital-seo-example-layout">
      <header class="hospital-seo-example-header" data-example-entry>
        <h2 id="hospital-seo-example-heading">{copy.heading}</h2>
        <span class="hospital-seo-example-rule" data-example-rule aria-hidden="true"></span>
      </header>
      <figure class="hospital-seo-example-photo" data-example-entry data-example-photo>
        <Image src={photo} alt="Family exploring hospital services on a laptop at home" title="Family exploring hospital services on a laptop at home" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <div class="hospital-seo-example-copy">
        <div class="hospital-seo-source-content" data-example-entry set:html={copy.html} />
      </div>
    </div>
  </section>
</hospital-seo-example>
<script>
  import '../scripts/hospital-seo-example';
</script>
