---
import {linkOfficialGuidanceHtml} from '../../../lib/official-guidance';
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import photo from '../../../assets/hospital-seo/hospital-seo-trust-v1.webp';
import { pageCopy } from '../data/hospital-seo-source';
const copy = pageCopy.trust;
const officialLinks = new Set<string>();
const trustFirstHtml = linkOfficialGuidanceHtml(copy.firstHtml, officialLinks);
const trustRestHtml = linkOfficialGuidanceHtml(copy.restHtml, officialLinks);
import '../styles/hospital-seo-trust.css';
---

<hospital-seo-trust class="hospital-seo-trust-motion">
  <section id="hospital-seo-trust" class="hospital-seo-trust" aria-labelledby="hospital-seo-trust-heading">
    <div class="section-container hospital-seo-trust-layout">
      <h2 id="hospital-seo-trust-heading">{copy.heading}</h2>
      <div class="hospital-seo-trust-profile hospital-seo-source-content" data-seo-trust-motion set:html={trustFirstHtml} />
      <div class="hospital-seo-trust-photo" data-seo-trust-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76} loading="lazy" decoding="async"
          alt="Clinician and manager verifying hospital service information"
          title="Clinician and manager verifying hospital service information" />
      </div>
      <div class="hospital-seo-trust-privacy" data-seo-trust-motion>
        <span class="hospital-seo-trust-lock" aria-hidden="true"><Icon icon={LockKeyIcon} size={24} /></span>
        <div class="hospital-seo-source-content" set:html={trustRestHtml} />
      </div>
    </div>
  </section>
</hospital-seo-trust>

<script>
  import '../scripts/hospital-seo-trust';
</script>
