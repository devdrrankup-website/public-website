---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import Arrow from '../../../components/Arrow.astro';
import Hospital01Icon from '@hugeicons/core-free-icons/Hospital01Icon';
import Facebook01Icon from '@hugeicons/core-free-icons/Facebook01Icon';
import Megaphone01Icon from '@hugeicons/core-free-icons/Megaphone01Icon';
import { pageCopy } from '../data/hospital-seo-source';
const copy = pageCopy.related;
import relatedImage0 from '../../../assets/hospital-digital-marketing/hospital-digital-marketing-related-preview-v1.webp';
import relatedImage1 from '../../../assets/hospital-social-media-marketing/hospital-social-media-marketing-related-preview-v1.webp';
import relatedImage2 from '../../../assets/hospital-advertising/hospital-advertising-related-preview-v1.webp';
import '../styles/hospital-seo-related.css';
const visuals = [
  { image: relatedImage0, icon: Hospital01Icon, accent: '#BAE5FF', description: "At a hospital communications office, a civilian digital strategist and administrator review a department-information journey laid out as generic print cards." },
  { image: relatedImage1, icon: Facebook01Icon, accent: '#EEEDFE', description: "A hospital communications photographer documents a bright public waiting corridor with an administrator, with no patients or clinical procedures in frame." },
  { image: relatedImage2, icon: Megaphone01Icon, accent: '#FEF2CC', description: "At a hospital communications desk, a civilian designer selects a public-service campaign photograph while an administrator checks factual wording, no outcome promises." },
];
---
<section id="hospital-seo-related" class="hospital-seo-related" aria-labelledby="hospital-seo-related-heading">
  <div class="section-container hospital-seo-related-container">
    <hospital-seo-related>
      <header class="hospital-seo-related-header" data-related-entry>
        <h2 id="hospital-seo-related-heading">{copy.heading}</h2>
        <div class="hospital-seo-source-content" set:html={copy.introductionHtml} />
      </header>
      <div class="hospital-seo-related-layout">
        <div class="hospital-seo-related-dock">
          <div class="hospital-seo-related-selectors" role="group" aria-label="Service image previews" hidden>
            {copy.services.map((service, index) => <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`related-${service.key}`} data-related-select={index}>
              <span>{service.name}</span>
            </button>)}
          </div>
          <div class="hospital-seo-related-stage" aria-hidden="true" hidden></div>
        </div>
        <div class="hospital-seo-related-details">
          <div class="hospital-seo-related-labels"><span>{copy.headers[0]}</span><span>{copy.headers[1]}</span></div>
          <dl class="hospital-seo-related-list">
            {copy.services.map((service, index) => <div class="hospital-seo-related-row" id={`related-${service.key}`} data-service={service.key}>
              <dt>
                <span class="hospital-seo-related-badge" style={`--related-accent:${visuals[index % visuals.length].accent}`}><Icon icon={visuals[index % visuals.length].icon} size={21} strokeWidth={1.8} /></span>
                <span class="hospital-seo-related-reveal" aria-hidden="true"></span>
                {service.href ? <a class="hospital-seo-related-name" href={service.href}>{service.name}</a>
                  : <span class="hospital-seo-related-name">{service.name}</span>}
                <span class="hospital-seo-related-arrow" aria-hidden="true"><Arrow /></span>
              </dt>
              <dd>
                <span>{service.responsibility}</span>
                <figure class="hospital-seo-related-photo">
                  <Image src={visuals[index % visuals.length].image} alt={visuals[index % visuals.length].description} title={visuals[index % visuals.length].description} width={960} widths={[360,640,960]} sizes="(min-width:1100px) 700px, (min-width:640px) 700px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
                  <figcaption>{service.name}</figcaption>
                </figure>
              </dd>
            </div>)}
          </dl>
          <div class="hospital-seo-related-note hospital-seo-source-content" set:html={copy.noteHtml} />
        </div>
      </div>
    </hospital-seo-related>
  </div>
</section>
<script>
  import '../scripts/hospital-seo-related';
</script>
