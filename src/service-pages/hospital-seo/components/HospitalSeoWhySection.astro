---
import Icon from '../../../components/Icon.astro';
import UserAccountIcon from '@hugeicons/core-free-icons/UserAccountIcon';
import WorkflowSquare01Icon from '@hugeicons/core-free-icons/WorkflowSquare01Icon';
import TaskEdit01Icon from '@hugeicons/core-free-icons/TaskEdit01Icon';
import { pageCopy } from '../data/hospital-seo-source';
const copy = pageCopy.why;
import '../styles/hospital-seo-why.css';
const visuals = [
  { icon: UserAccountIcon, accent: '#E1FFB9' },
  { icon: WorkflowSquare01Icon, accent: '#BAE5FF' },
  { icon: TaskEdit01Icon, accent: '#EEEDFE' },
];
---
<hospital-seo-why class="hospital-seo-why-motion">
  <section id="hospital-seo-why" class="hospital-seo-why" aria-labelledby="hospital-seo-why-heading">
    <div class="section-container hospital-seo-why-layout">
      <h2 id="hospital-seo-why-heading" data-why-entry>{copy.heading}</h2>
      <div class="hospital-seo-source-content" set:html={copy.before} />
      {copy.items.length > 0 && <ul class="hospital-seo-why-principles">
        {copy.items.map((principle,index) => <li data-why-entry data-why-row>
          <span class="hospital-seo-why-icon" data-why-icon style={`--why-accent:${visuals[index % visuals.length].accent}`} aria-hidden="true"><Icon icon={visuals[index % visuals.length].icon} size={24} strokeWidth={1.7} /></span>
          <p><strong>{principle.label}</strong>{' '}{principle.description}</p>
        </li>)}
      </ul>}
      <div class="hospital-seo-source-content" set:html={copy.after} />
    </div>
  </section>
</hospital-seo-why>
<script>
  import '../scripts/hospital-seo-why';
</script>
