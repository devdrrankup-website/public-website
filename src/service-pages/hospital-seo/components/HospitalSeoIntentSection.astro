---
import { Image } from 'astro:assets';
import photo from '../../../assets/hospital-seo/hospital-seo-intent-v1.webp';
import { pageCopy } from '../data/hospital-seo-source';
const copy = pageCopy.intent;
import '../styles/hospital-seo-intent.css';
---
<hospital-seo-intent class="hospital-seo-intent">
  <section id="hospital-seo-intent" class="section-container hospital-seo-intent-layout" aria-labelledby="hospital-seo-intent-heading">
    <div class="hospital-seo-intent-copy" data-seo-intent-motion>
      <h2 id="hospital-seo-intent-heading">{copy.heading}</h2>
      <div class="hospital-seo-source-content" set:html={copy.html} />
    </div>
    <div class="hospital-seo-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Man looking up hospital specialists on a laptop and phone at home"
        title="Man looking up hospital specialists on a laptop and phone at home" />
    </div>
  </section>
</hospital-seo-intent>

<script>
  import '../scripts/hospital-seo-intent';
</script>
