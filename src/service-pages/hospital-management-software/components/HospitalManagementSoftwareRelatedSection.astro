---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import Arrow from '../../../components/Arrow.astro';
import UserGroupIcon from '@hugeicons/core-free-icons/UserGroupIcon';
import Calendar03Icon from '@hugeicons/core-free-icons/Calendar03Icon';
import Hospital01Icon from '@hugeicons/core-free-icons/Hospital01Icon';
import DatabaseIcon from '@hugeicons/core-free-icons/DatabaseIcon';
import MicroscopeIcon from '@hugeicons/core-free-icons/MicroscopeIcon';
import CreditCardIcon from '@hugeicons/core-free-icons/CreditCardIcon';
import PackageIcon from '@hugeicons/core-free-icons/PackageIcon';
import { pageCopy } from '../data/hospital-management-software-source';
const copy = pageCopy.related;
import receptionPhoto from '../../../assets/related-services/reception-patient-registration-preview-v1.webp';
import schedulingPhoto from '../../../assets/related-services/appointment-doctor-scheduling-preview-v1.webp';
import admissionPhoto from '../../../assets/related-services/admission-transfer-discharge-preview-v1.webp';
import wardsPhoto from '../../../assets/related-services/ward-room-bed-management-preview-v1.webp';
import diagnosticPhoto from '../../../assets/related-services/diagnostic-pathology-workflow-preview-v1.webp';
import billingPhoto from '../../../assets/related-services/billing-internal-accounts-preview-v1.webp';
import inventoryPhoto from '../../../assets/related-services/store-inventory-procurement-preview-v1.webp';
import '../styles/hospital-management-software-related.css';
const visuals = [
  { image: receptionPhoto, icon: UserGroupIcon, accent: '#BAE5FF', description: "At a hospital reception before opening, two administrative staff rehearse registration handoff using blank forms and a front-facing workstation, no patients or records." },
  { image: schedulingPhoto, icon: Calendar03Icon, accent: '#EEEDFE', description: "At a hospital scheduling desk, two administrative coordinators align an unmarked weekly consultant roster with appointment blocks on a front-facing monitor." },
  { image: admissionPhoto, icon: Hospital01Icon, accent: '#FEF2CC', description: "At a hospital admissions office, a staff coordinator traces a patient transfer route on a blank floor plan with a ward nurse." },
  { image: wardsPhoto, icon: DatabaseIcon, accent: '#E4FFBD', description: "At a hospital nurse station, a ward coordinator checks available room signs and a plain bed-capacity board with a second staff member." },
  { image: diagnosticPhoto, icon: MicroscopeIcon, accent: '#F7E4FB', description: "Inside a hospital pathology laboratory, a technician and diagnostics administrator trace a sealed sample handoff beside realistic sample racks and a neutral computer shown from behind." },
  { image: billingPhoto, icon: CreditCardIcon, accent: '#BAE5FF', description: "At a hospital accounts desk, two civilian finance staff reconcile blank itemised invoices and payment-category folders with a rear-facing computer." },
  { image: inventoryPhoto, icon: PackageIcon, accent: '#BAE5FF', description: "In a hospital supplies storeroom, a storekeeper and procurement staff count sealed boxes on orderly shelves while checking an unmarked stock sheet." },
];
---
<section id="hospital-management-software-related" class="hospital-management-software-related" aria-labelledby="hospital-management-software-related-heading">
  <div class="section-container hospital-management-software-related-container">
    <hospital-management-software-related>
      <header class="hospital-management-software-related-header" data-related-entry>
        <h2 id="hospital-management-software-related-heading">{copy.heading}</h2>
        <div class="hospital-management-software-source-content" set:html={copy.introductionHtml} />
      </header>
      <div class="hospital-management-software-related-layout">
        <div class="hospital-management-software-related-dock">
          <div class="hospital-management-software-related-selectors" role="group" aria-label="Service image previews" hidden>
            {copy.services.map((service, index) => <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`related-${service.key}`} data-related-select={index}>
              <span>{service.name}</span>
            </button>)}
          </div>
          <div class="hospital-management-software-related-stage" aria-hidden="true" hidden></div>
        </div>
        <div class="hospital-management-software-related-details">
          <div class="hospital-management-software-related-labels"><span>{copy.headers[0]}</span><span>{copy.headers[1]}</span></div>
          <dl class="hospital-management-software-related-list">
            {copy.services.map((service, index) => <div class="hospital-management-software-related-row" id={`related-${service.key}`} data-service={service.key}>
              <dt>
                <span class="hospital-management-software-related-badge" style={`--related-accent:${visuals[index % visuals.length].accent}`}><Icon icon={visuals[index % visuals.length].icon} size={21} strokeWidth={1.8} /></span>
                <span class="hospital-management-software-related-reveal" aria-hidden="true"></span>
                {service.href ? <a class="hospital-management-software-related-name" href={service.href}>{service.name}</a>
                  : <span class="hospital-management-software-related-name">{service.name}</span>}
                <span class="hospital-management-software-related-arrow" aria-hidden="true"><Arrow /></span>
              </dt>
              <dd>
                <span>{service.responsibility}</span>
                <figure class="hospital-management-software-related-photo">
                  <Image src={visuals[index % visuals.length].image} alt={visuals[index % visuals.length].description} title={visuals[index % visuals.length].description} width={960} widths={[360,640,960]} sizes="(min-width:1100px) 700px, (min-width:640px) 700px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
                  <figcaption>{service.name}</figcaption>
                </figure>
              </dd>
            </div>)}
          </dl>
          <div class="hospital-management-software-related-note hospital-management-software-source-content" set:html={copy.noteHtml} />
        </div>
      </div>
    </hospital-management-software-related>
  </div>
</section>
<script>
  import '../scripts/hospital-management-software-related';
</script>
