---
import { Image } from 'astro:assets';
import photo from '../../../assets/hospital-management-software/hospital-management-software-intent-v1.webp';
import { pageCopy } from '../data/hospital-management-software-source';
const copy = pageCopy.intent;
import '../styles/hospital-management-software-intent.css';
---
<hospital-management-software-intent class="hospital-management-software-intent">
  <section id="hospital-management-software-intent" class="section-container hospital-management-software-intent-layout" aria-labelledby="hospital-management-software-intent-heading">
    <div class="hospital-management-software-intent-copy" data-seo-intent-motion>
      <h2 id="hospital-management-software-intent-heading">{copy.heading}</h2>
      <div class="hospital-management-software-source-content" set:html={copy.html} />
    </div>
    <div class="hospital-management-software-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Hospital staff checking admission and service records on a computer"
        title="Hospital staff checking admission and service records on a computer" />
    </div>
  </section>
</hospital-management-software-intent>

<script>
  import '../scripts/hospital-management-software-intent';
</script>
