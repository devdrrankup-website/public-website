---
import { Image } from 'astro:assets';
import photo from '../../../assets/hospital-management-software/hospital-management-software-challenges-v1.webp';
import { pageCopy } from '../data/hospital-management-software-source';
import { challengeEditorial as editorial } from '../data/hospital-management-software-section-editorial';
const copy = pageCopy.challenges;
import '../styles/hospital-management-software-challenges.css';
---

<hospital-management-software-challenges class="hospital-management-software-challenges">
  <section id="hospital-management-software-challenges" class="section-container hospital-management-software-challenges-layout" aria-labelledby="hospital-management-software-challenges-heading">
    <div class="hospital-management-software-challenges-editorial">
      <h2 id="hospital-management-software-challenges-heading">{copy.heading}</h2>
      <p class="hospital-management-software-challenges-introduction" set:html={copy.introductionHtml} />
      <div class="hospital-management-software-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Hospital reception and clinical teams reconciling paper records"
          title="Hospital reception and clinical teams reconciling paper records"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="hospital-management-software-challenges-details">
      {copy.preListHtml && <p class="hospital-management-software-challenges-prelist" set:html={copy.preListHtml} />}
      <p id="hospital-management-software-challenges-list-heading" class="hospital-management-software-challenges-list-intro" set:html={copy.listIntroductionHtml} />
      <ul class="hospital-management-software-challenges-list" role="list" aria-labelledby="hospital-management-software-challenges-list-heading" data-seo-challenges-motion>
        {editorial.points.map((challenge, index) => <li>
          <span class="hospital-management-software-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={challenge} />
        </li>)}
      </ul>
      {copy.conclusionHtml && <p class="hospital-management-software-challenges-conclusion" set:html={copy.conclusionHtml} />}
    </div>
  </section>
</hospital-management-software-challenges>

<script>
  import '../scripts/hospital-management-software-challenges';
</script>
