---
import { Image } from 'astro:assets';
import expertPortrait from '../../../assets/team/monwara-moni-studio-v2.webp';
import { pageCopy } from '../data/doctor-facebook-marketing-source';
const copy = pageCopy.expertise;
const paragraphs = Array.from(copy.html.matchAll(/<p>([\s\S]*?)<\/p>/g), match => match[1]);
const principleSentences = paragraphs.slice(1).flatMap(paragraph => paragraph.split(/(?<=[.!?])\s+(?=[A-Z])/));
import '../styles/doctor-facebook-marketing-expertise.css';
---
<doctor-facebook-marketing-expertise class="doctor-facebook-marketing-expertise-motion">
  <section id="doctor-facebook-marketing-expertise" class="doctor-facebook-marketing-expertise" aria-labelledby="doctor-facebook-marketing-expertise-heading">
    <div class="section-container doctor-facebook-marketing-expertise-layout">
      <h2 id="doctor-facebook-marketing-expertise-heading">{copy.heading}</h2>
      <figure class="doctor-facebook-marketing-expertise-portrait">
        <div class="doctor-facebook-marketing-expertise-photo">
          <Image src={expertPortrait} widths={[320, 480, 640, 960]} width={1254} height={1254}
            sizes="(min-width: 1100px) min(40vw, 480px), (min-width: 640px) min(36vw, 360px), min(calc(100vw - 32px), 360px)"
            format="webp" quality={80} loading="lazy" decoding="async"
            alt="Monwara Moni in a navy blazer against a grey studio background"
            title="Monwara Moni — Dr RankUP specialist"
            data-expertise-reveal="portrait" />
        </div>
        <figcaption data-expertise-reveal="copy">{copy.founder}</figcaption>
      </figure>
      <div class="doctor-facebook-marketing-expertise-record">
        <p class="doctor-facebook-marketing-expertise-context" data-expertise-reveal="copy" set:html={paragraphs[0]} />
      </div>
      <div class="doctor-facebook-marketing-expertise-principles">
        <span class="doctor-facebook-marketing-expertise-rule" data-expertise-reveal="rule" aria-hidden="true"></span>
        <ul role="list">
          {principleSentences.map((sentence, index) => <li data-expertise-reveal="copy" data-expertise-delay={Math.min(index * 60, 100)} set:html={sentence} />)}
        </ul>
      </div>
    </div>
  </section>
</doctor-facebook-marketing-expertise>
<script>
  import '../scripts/doctor-facebook-marketing-expertise';
</script>
