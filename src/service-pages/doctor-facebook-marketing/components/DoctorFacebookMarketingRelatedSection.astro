---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import Arrow from '../../../components/Arrow.astro';
import Facebook01Icon from '@hugeicons/core-free-icons/Facebook01Icon';
import NoteEditIcon from '@hugeicons/core-free-icons/NoteEditIcon';
import PaintBrush01Icon from '@hugeicons/core-free-icons/PaintBrush01Icon';
import { pageCopy } from '../data/doctor-facebook-marketing-source';
const copy = pageCopy.related;
import relatedImage0 from '../../../assets/doctor-social-media-marketing/doctor-social-media-marketing-related-preview-v1.webp';
import relatedImage1 from '../../../assets/doctor-facebook-ads/doctor-facebook-ads-related-preview-v1.webp';
import relatedImage2 from '../../../assets/doctor-content-marketing/doctor-content-marketing-related-preview-v1.webp';
import relatedImage3 from '../../../assets/doctor-personal-branding/doctor-personal-branding-related-preview-v1.webp';
import '../styles/doctor-facebook-marketing-related.css';
const visuals = [
  { image: relatedImage0, icon: Facebook01Icon, accent: '#BAE5FF', description: "In a doctor's chamber after consultations, a civilian content specialist frames a factual portrait photo while the doctor checks the publication plan." },
  { image: relatedImage1, icon: Facebook01Icon, accent: '#EEEDFE', description: "An agency advertising specialist and doctor compare two neutral creative layouts on a front-facing monitor, with no metrics, endorsements or platform logo." },
  { image: relatedImage2, icon: NoteEditIcon, accent: '#FEF2CC', description: "At an agency editing desk, a civilian editor and doctor review a patient-education article proof with source notes, no readable health claim." },
  { image: relatedImage3, icon: PaintBrush01Icon, accent: '#E4FFBD', description: "In a doctor's own chamber, a civilian photographer prepares a natural professional portrait while the doctor adjusts ordinary work attire, without awards or staged patients." },
];
---
<section id="doctor-facebook-marketing-related" class="doctor-facebook-marketing-related" aria-labelledby="doctor-facebook-marketing-related-heading">
  <div class="section-container doctor-facebook-marketing-related-container">
    <doctor-facebook-marketing-related>
      <header class="doctor-facebook-marketing-related-header" data-related-entry>
        <h2 id="doctor-facebook-marketing-related-heading">{copy.heading}</h2>
        <div class="doctor-facebook-marketing-source-content" set:html={copy.introductionHtml} />
      </header>
      <div class="doctor-facebook-marketing-related-layout">
        <div class="doctor-facebook-marketing-related-dock">
          <div class="doctor-facebook-marketing-related-selectors" role="group" aria-label="Service image previews" hidden>
            {copy.services.map((service, index) => <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`related-${service.key}`} data-related-select={index}>
              <span>{service.name}</span>
            </button>)}
          </div>
          <div class="doctor-facebook-marketing-related-stage" aria-hidden="true" hidden></div>
        </div>
        <div class="doctor-facebook-marketing-related-details">
          <div class="doctor-facebook-marketing-related-labels"><span>{copy.headers[0]}</span><span>{copy.headers[1]}</span></div>
          <dl class="doctor-facebook-marketing-related-list">
            {copy.services.map((service, index) => <div class="doctor-facebook-marketing-related-row" id={`related-${service.key}`} data-service={service.key}>
              <dt>
                <span class="doctor-facebook-marketing-related-badge" style={`--related-accent:${visuals[index % visuals.length].accent}`}><Icon icon={visuals[index % visuals.length].icon} size={21} strokeWidth={1.8} /></span>
                <span class="doctor-facebook-marketing-related-reveal" aria-hidden="true"></span>
                {service.href ? <a class="doctor-facebook-marketing-related-name" href={service.href}>{service.name}</a>
                  : <span class="doctor-facebook-marketing-related-name">{service.name}</span>}
                <span class="doctor-facebook-marketing-related-arrow" aria-hidden="true"><Arrow /></span>
              </dt>
              <dd>
                <span>{service.responsibility}</span>
                <figure class="doctor-facebook-marketing-related-photo">
                  <Image src={visuals[index % visuals.length].image} alt={visuals[index % visuals.length].description} title={visuals[index % visuals.length].description} width={960} widths={[360,640,960]} sizes="(min-width:1100px) 700px, (min-width:640px) 700px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
                  <figcaption>{service.name}</figcaption>
                </figure>
              </dd>
            </div>)}
          </dl>
          <div class="doctor-facebook-marketing-related-note doctor-facebook-marketing-source-content" set:html={copy.noteHtml} />
        </div>
      </div>
    </doctor-facebook-marketing-related>
  </div>
</section>
<script>
  import '../scripts/doctor-facebook-marketing-related';
</script>
