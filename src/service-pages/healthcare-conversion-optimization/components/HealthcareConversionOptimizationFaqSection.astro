---
import Icon from '../../../components/Icon.astro';
import Add01Icon from '@hugeicons/core-free-icons/Add01Icon';
import { pageCopy } from '../data/healthcare-conversion-optimization-source';
const copy = pageCopy.faq;
import '../styles/healthcare-conversion-optimization-faq.css';
---
<healthcare-conversion-optimization-faq class="healthcare-conversion-optimization-faq-motion">
  <section id="healthcare-conversion-optimization-faq" class="healthcare-conversion-optimization-faq" aria-labelledby="healthcare-conversion-optimization-faq-heading">
    <div class="section-container healthcare-conversion-optimization-faq-layout">
      <header class="healthcare-conversion-optimization-faq-header" data-faq-entry>
        <h2 id="healthcare-conversion-optimization-faq-heading">{copy.heading}</h2>
        <div class="healthcare-conversion-optimization-source-content" set:html={copy.preface} />
      </header>
      <div class="healthcare-conversion-optimization-faq-list">
        {copy.items.map((item,index) => <article class="healthcare-conversion-optimization-faq-item" data-faq-entry aria-labelledby={`healthcare-conversion-optimization-faq-question-${index+1}`}>
          <h3 class="healthcare-conversion-optimization-faq-question" id={`healthcare-conversion-optimization-faq-question-${index+1}`}>
            <span class="healthcare-conversion-optimization-faq-label">{item.question}</span>
            <span class="healthcare-conversion-optimization-faq-toggle" aria-hidden="true"><Icon icon={Add01Icon} size={20} strokeWidth={1.8} /></span>
          </h3>
          <div class="healthcare-conversion-optimization-faq-answer" id={`healthcare-conversion-optimization-faq-answer-${index+1}`} role="region" aria-labelledby={`healthcare-conversion-optimization-faq-question-${index+1}`}>
            <div class="healthcare-conversion-optimization-source-content" set:html={item.answerHtml} />
          </div>
        </article>)}
      </div>
    </div>
  </section>
</healthcare-conversion-optimization-faq>
<script>
  import '../scripts/healthcare-conversion-optimization-faq';
</script>
