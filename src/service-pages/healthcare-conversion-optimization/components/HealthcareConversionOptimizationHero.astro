---
import ActionIcon from '../../../components/ActionIcon.astro';
import { pageCopy } from '../data/healthcare-conversion-optimization-source';
const copy = pageCopy.hero;
import { healthcareConversionOptimizationHeroImage as photo } from '../lib/healthcare-conversion-optimization-hero-image';
import '../styles/healthcare-conversion-optimization-hero.css';
---

<section class="healthcare-conversion-optimization-hero" aria-labelledby="healthcare-conversion-optimization-heading">
  <div class="section-container healthcare-conversion-optimization-hero-layout">
    <div class="healthcare-conversion-optimization-hero-copy">
      <h1 id="healthcare-conversion-optimization-heading">{copy.heading}</h1>
      <p class="healthcare-conversion-optimization-hero-tagline">{copy.tagline}</p>
      <div class="healthcare-conversion-optimization-hero-description">
        {copy.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      </div>
      <div class="healthcare-conversion-optimization-hero-actions" aria-label={`${copy.heading} options`}>
        <span class="button button-primary">
          <span>{copy.primaryCta}</span><ActionIcon purpose="conversation" />
        </span>
        {copy.secondaryHref ? <a class="button button-secondary" href={copy.secondaryHref}>
          <span>{copy.secondaryCta}</span><ActionIcon purpose="conversation" />
        </a> : <span class="button button-secondary">
          <span>{copy.secondaryCta}</span><ActionIcon purpose="conversation" />
        </span>}
      </div>
    </div>
    <div class="healthcare-conversion-optimization-hero-visual">
      <div class="healthcare-conversion-optimization-hero-photo">
        <img src={photo.src} srcset={photo.srcset} sizes={photo.sizes}
          width={photo.width} height={photo.height}
          alt="Clinic operations lead and website designer reviewing desktop and mobile healthcare pages"
          title="Clinic operations lead and website designer reviewing desktop and mobile healthcare pages"
          loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
</section>
