---
import { Image } from 'astro:assets';
import photo from '../../../assets/healthcare-marketing-services/healthcare-conversion-optimization/intent-v1.webp';
import { pageCopy } from '../data/healthcare-conversion-optimization-source';
const copy = pageCopy.intent;
import '../styles/healthcare-conversion-optimization-intent.css';
---
<healthcare-conversion-optimization-intent class="healthcare-conversion-optimization-intent">
  <section id="healthcare-conversion-optimization-intent" class="section-container healthcare-conversion-optimization-intent-layout" aria-labelledby="healthcare-conversion-optimization-intent-heading">
    <div class="healthcare-conversion-optimization-intent-copy" data-seo-intent-motion>
      <h2 id="healthcare-conversion-optimization-intent-heading">{copy.heading}</h2>
      <div class="healthcare-conversion-optimization-source-content" set:html={copy.html} />
    </div>
    <div class="healthcare-conversion-optimization-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Woman checking a healthcare service and contact page on her phone at home"
        title="Woman checking a healthcare service and contact page on her phone at home" />
    </div>
  </section>
</healthcare-conversion-optimization-intent>

<script>
  import '../scripts/healthcare-conversion-optimization-intent';
</script>
