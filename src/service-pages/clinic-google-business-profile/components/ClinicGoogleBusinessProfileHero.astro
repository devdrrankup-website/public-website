---
import ActionIcon from '../../../components/ActionIcon.astro';
import { pageCopy } from '../data/clinic-google-business-profile-source';
const copy = pageCopy.hero;
import { clinicGoogleBusinessProfileHeroImage as photo } from '../lib/clinic-google-business-profile-hero-image';
import '../styles/clinic-google-business-profile-hero.css';
---

<section class="clinic-google-business-profile-hero" aria-labelledby="clinic-google-business-profile-heading">
  <div class="section-container clinic-google-business-profile-hero-layout">
    <div class="clinic-google-business-profile-hero-copy">
      <h1 id="clinic-google-business-profile-heading">{copy.heading}</h1>
      <p class="clinic-google-business-profile-hero-tagline">{copy.tagline}</p>
      <div class="clinic-google-business-profile-hero-description">
        {copy.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      </div>
      <div class="clinic-google-business-profile-hero-actions" aria-label={`${copy.heading} options`}>
        <a class="button button-primary" href="/contact/">
          <span>{copy.primaryCta}</span><ActionIcon purpose="conversation" />
        </a>
        <a class="button button-secondary" href={copy.secondaryHref}>
          <span>{copy.secondaryCta}</span><ActionIcon purpose="conversation" />
        </a>
      </div>
    </div>
    <div class="clinic-google-business-profile-hero-visual">
      <div class="clinic-google-business-profile-hero-photo">
        <img src={photo.src} srcset={photo.srcset} sizes={photo.sizes}
          width={photo.width} height={photo.height}
          alt="Clinic manager checking a map location against the clinic entrance in Bangladesh"
          title="Verifying a clinic location listing"
          loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
</section>
