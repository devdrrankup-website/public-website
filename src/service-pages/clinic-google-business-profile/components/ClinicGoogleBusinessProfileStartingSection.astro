---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-google-business-profile/clinic-google-business-profile-starting-v1.webp';
import { pageCopy } from '../data/clinic-google-business-profile-source';
const copy = pageCopy.starting;
import '../styles/clinic-google-business-profile-starting.css';
---
<clinic-google-business-profile-starting class="clinic-google-business-profile-starting-motion">
  <section id="clinic-google-business-profile-starting" class="clinic-google-business-profile-starting" aria-labelledby="clinic-google-business-profile-starting-heading">
    <div class="section-container clinic-google-business-profile-starting-layout">
      <h2 id="clinic-google-business-profile-starting-heading" data-starting-entry>{copy.heading}</h2>
      <div class="clinic-google-business-profile-starting-copy" data-starting-entry>
        <div class="clinic-google-business-profile-source-content" set:html={copy.html} />
      </div>
      <figure class="clinic-google-business-profile-starting-visual" data-starting-entry data-starting-visual>
        <Image src={photo} alt="Clinic manager and specialist discussing location details on a laptop" title="Clinic manager and specialist discussing location details on a laptop" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 540px, (min-width:640px) 320px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>
</clinic-google-business-profile-starting>
<script>
  import '../scripts/clinic-google-business-profile-starting';
</script>
