---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import Arrow from '../../../components/Arrow.astro';
import Location04Icon from '@hugeicons/core-free-icons/Location04Icon';
import Search01Icon from '@hugeicons/core-free-icons/Search01Icon';
import PaintBrush01Icon from '@hugeicons/core-free-icons/PaintBrush01Icon';
import { pageCopy } from '../data/clinic-google-business-profile-source';
const copy = pageCopy.related;
import relatedImage0 from '../../../assets/clinic-local-seo/clinic-local-seo-related-preview-v1.webp';
import relatedImage1 from '../../../assets/clinic-seo/clinic-seo-related-preview-v1.webp';
import relatedImage2 from '../../../assets/clinic-branding/clinic-branding-related-preview-v1.webp';
import '../styles/clinic-google-business-profile-related.css';
const visuals = [
  { image: relatedImage0, icon: Location04Icon, accent: '#BAE5FF', description: "A patient at home checks the correct location and entrance of a nearby clinic on a front-facing phone, with a simple nonliteral map and no invented address." },
  { image: relatedImage1, icon: Search01Icon, accent: '#EEEDFE', description: "At home in Bangladesh, a prospective patient uses a correctly oriented laptop to compare a clinic's service and location information before deciding whom to contact." },
  { image: relatedImage2, icon: PaintBrush01Icon, accent: '#FEF2CC', description: "A civilian designer studies blank clinic signage mockups mounted in an actual reception corridor, with a clinic manager checking legibility from a distance." },
];
---
<section id="clinic-google-business-profile-related" class="clinic-google-business-profile-related" aria-labelledby="clinic-google-business-profile-related-heading">
  <div class="section-container clinic-google-business-profile-related-container">
    <clinic-google-business-profile-related>
      <header class="clinic-google-business-profile-related-header" data-related-entry>
        <h2 id="clinic-google-business-profile-related-heading">{copy.heading}</h2>
        <div class="clinic-google-business-profile-source-content" set:html={copy.introductionHtml} />
      </header>
      <div class="clinic-google-business-profile-related-layout">
        <div class="clinic-google-business-profile-related-dock">
          <div class="clinic-google-business-profile-related-selectors" role="group" aria-label="Service image previews" hidden>
            {copy.services.map((service, index) => <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`related-${service.key}`} data-related-select={index}>
              <span>{service.name}</span>
            </button>)}
          </div>
          <div class="clinic-google-business-profile-related-stage" aria-hidden="true" hidden></div>
        </div>
        <div class="clinic-google-business-profile-related-details">
          <div class="clinic-google-business-profile-related-labels"><span>{copy.headers[0]}</span><span>{copy.headers[1]}</span></div>
          <dl class="clinic-google-business-profile-related-list">
            {copy.services.map((service, index) => <div class="clinic-google-business-profile-related-row" id={`related-${service.key}`} data-service={service.key}>
              <dt>
                <span class="clinic-google-business-profile-related-badge" style={`--related-accent:${visuals[index % visuals.length].accent}`}><Icon icon={visuals[index % visuals.length].icon} size={21} strokeWidth={1.8} /></span>
                <span class="clinic-google-business-profile-related-reveal" aria-hidden="true"></span>
                {service.href ? <a class="clinic-google-business-profile-related-name" href={service.href}>{service.name}</a>
                  : <span class="clinic-google-business-profile-related-name">{service.name}</span>}
                <span class="clinic-google-business-profile-related-arrow" aria-hidden="true"><Arrow /></span>
              </dt>
              <dd>
                <span>{service.responsibility}</span>
                <figure class="clinic-google-business-profile-related-photo">
                  <Image src={visuals[index % visuals.length].image} alt={visuals[index % visuals.length].description} title={visuals[index % visuals.length].description} width={960} widths={[360,640,960]} sizes="(min-width:1100px) 700px, (min-width:640px) 700px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
                  <figcaption>{service.name}</figcaption>
                </figure>
              </dd>
            </div>)}
          </dl>
          <div class="clinic-google-business-profile-related-note clinic-google-business-profile-source-content" set:html={copy.noteHtml} />
        </div>
      </div>
    </clinic-google-business-profile-related>
  </div>
</section>
<script>
  import '../scripts/clinic-google-business-profile-related';
</script>
