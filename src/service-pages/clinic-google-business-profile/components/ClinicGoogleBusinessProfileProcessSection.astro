---
import { Image } from 'astro:assets';
import { pageCopy } from '../data/clinic-google-business-profile-source';
const copy = pageCopy.process;
import processBackground from '../../../assets/clinic-google-business-profile/clinic-google-business-profile-process-workflow-v1.webp';
import '../styles/clinic-google-business-profile-process.css';
// Destination-owned copy of the approved For Doctors process composition.
const titleParts = (title: string) => [title.match(/^\d+\.\s+/)?.[0] ?? '', title.replace(/^\d+\.\s+/, '')];
---

<clinic-google-business-profile-process class="clinic-google-business-profile-process-motion">
  <section id="clinic-google-business-profile-process" class="clinic-google-business-profile-process" aria-labelledby="clinic-google-business-profile-process-heading">
    <div class="clinic-google-business-profile-process-background" aria-hidden="true">
      <Image src={processBackground} width={1024} widths={[480, 768, 1024]} sizes="100vw" format="webp" quality={40}
        alt="" title="At a real clinic entrance, an administrator checks opening hours and entrance photographs against a printed location checklist, with no fake signage or fabricated listing." loading="lazy" decoding="async" />
    </div>
    <div class="clinic-google-business-profile-process-atmosphere" aria-hidden="true"></div>
    <div class="section-container clinic-google-business-profile-process-layout">
      <header class="clinic-google-business-profile-process-header" data-seo-process-copy>
        <span class="clinic-google-business-profile-process-range" aria-hidden="true">{`01—${String(copy.steps.length).padStart(2, '0')}`}</span>
        <h2 id="clinic-google-business-profile-process-heading">{copy.heading}</h2>
        <div class="clinic-google-business-profile-source-content" set:html={copy.introductionHtml} />
      </header>

      <div class="clinic-google-business-profile-process-flow" role="list" aria-label={`${copy.steps.length} service steps`}>
        <svg class="clinic-google-business-profile-process-route" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="clinic-google-business-profile-process-route-gradient" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="100" y2="100">
              <stop offset="0" stop-color="#6131c6" />
              <stop offset="0.5" stop-color="#229f60" />
              <stop offset="1" stop-color="#6131c6" />
            </linearGradient>
          </defs>
          <path class="clinic-google-business-profile-process-route-base" />
          <path class="clinic-google-business-profile-process-route-progress" />
        </svg>

        {copy.steps.map((step, index) => (
          <div class="clinic-google-business-profile-process-step" role="listitem" data-seo-process-step>
            <div class="clinic-google-business-profile-process-node-column" aria-hidden="true">
              <span class="clinic-google-business-profile-process-node"><span>{String(index + 1).padStart(2, '0')}</span></span>
              {index < copy.steps.length - 1 && <span class="clinic-google-business-profile-process-connector"></span>}
            </div>
            <div class="clinic-google-business-profile-process-copy" data-seo-process-copy>
              <h3><span>{titleParts(step.title)[0]}</span>{titleParts(step.title)[1]}</h3>
              <div class="clinic-google-business-profile-source-content" set:html={step.html} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</clinic-google-business-profile-process>

<script>
  import '../scripts/clinic-google-business-profile-process';
</script>
