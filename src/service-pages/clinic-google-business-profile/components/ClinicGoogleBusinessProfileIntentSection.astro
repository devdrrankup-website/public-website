---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-google-business-profile/clinic-google-business-profile-intent-v1.webp';
import { pageCopy } from '../data/clinic-google-business-profile-source';
const copy = pageCopy.intent;
import '../styles/clinic-google-business-profile-intent.css';
---
<clinic-google-business-profile-intent class="clinic-google-business-profile-intent">
  <section id="clinic-google-business-profile-intent" class="section-container clinic-google-business-profile-intent-layout" aria-labelledby="clinic-google-business-profile-intent-heading">
    <div class="clinic-google-business-profile-intent-copy" data-seo-intent-motion>
      <h2 id="clinic-google-business-profile-intent-heading">{copy.heading}</h2>
      <div class="clinic-google-business-profile-source-content" set:html={copy.html} />
    </div>
    <div class="clinic-google-business-profile-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Man checking a clinic location on his phone at home"
        title="Man checking a clinic location on his phone at home" />
    </div>
  </section>
</clinic-google-business-profile-intent>

<script>
  import '../scripts/clinic-google-business-profile-intent';
</script>
