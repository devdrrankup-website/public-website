---
import ActionIcon from '../../../components/ActionIcon.astro';
import { pageCopy } from '../data/healthcare-audit-strategy-source';
const copy = pageCopy.hero;
import { healthcareAuditStrategyHeroImage as photo } from '../lib/healthcare-audit-strategy-hero-image';
import '../styles/healthcare-audit-strategy-hero.css';
---

<section class="healthcare-audit-strategy-hero" aria-labelledby="healthcare-audit-strategy-heading">
  <div class="section-container healthcare-audit-strategy-hero-layout">
    <div class="healthcare-audit-strategy-hero-copy">
      <h1 id="healthcare-audit-strategy-heading">{copy.heading}</h1>
      <p class="healthcare-audit-strategy-hero-tagline">{copy.tagline}</p>
      <div class="healthcare-audit-strategy-hero-description">
        {copy.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      </div>
      <div class="healthcare-audit-strategy-hero-actions" aria-label={`${copy.heading} options`}>
        <a class="button button-primary" href="/contact/">
          <span>{copy.primaryCta}</span><ActionIcon purpose="conversation" />
        </a>
        <a class="button button-secondary" href={copy.secondaryHref}>
          <span>{copy.secondaryCta}</span><ActionIcon purpose="conversation" />
        </a>
      </div>
    </div>
    <div class="healthcare-audit-strategy-hero-visual">
      <div class="healthcare-audit-strategy-hero-photo">
        <img src={photo.src} srcset={photo.srcset} sizes={photo.sizes}
          width={photo.width} height={photo.height}
          alt="Healthcare strategists reviewing anonymous hospital pages and priorities in a Dhaka office"
          title="Healthcare strategists reviewing anonymous hospital pages and priorities in a Dhaka office"
          loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
</section>
