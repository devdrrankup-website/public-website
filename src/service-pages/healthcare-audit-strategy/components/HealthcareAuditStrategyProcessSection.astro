---
import { Image } from 'astro:assets';
import { pageCopy } from '../data/healthcare-audit-strategy-source';
const copy = pageCopy.process;
import processBackground from '../../../assets/healthcare-marketing-services/healthcare-audit-strategy/process-v1.webp';
import '../styles/healthcare-audit-strategy-process.css';
// Destination-owned copy of the approved For Doctors process composition.
const titleParts = (title: string) => [title.match(/^\d+\.\s+/)?.[0] ?? '', title.replace(/^\d+\.\s+/, '')];
---

<healthcare-audit-strategy-process class="healthcare-audit-strategy-process-motion">
  <section id="healthcare-audit-strategy-process" class="healthcare-audit-strategy-process" aria-labelledby="healthcare-audit-strategy-process-heading">
    <div class="healthcare-audit-strategy-process-background" aria-hidden="true">
      <Image src={processBackground} width={1024} widths={[480, 768, 1024]} sizes="100vw" format="webp" quality={40}
        alt="" title="Service specific healthcare marketing process background" loading="lazy" decoding="async" />
    </div>
    <div class="healthcare-audit-strategy-process-atmosphere" aria-hidden="true"></div>
    <div class="section-container healthcare-audit-strategy-process-layout">
      <header class="healthcare-audit-strategy-process-header" data-seo-process-copy>
        <span class="healthcare-audit-strategy-process-range" aria-hidden="true">{`01—${String(copy.steps.length).padStart(2, '0')}`}</span>
        <h2 id="healthcare-audit-strategy-process-heading">{copy.heading}</h2>
        <div class="healthcare-audit-strategy-source-content" set:html={copy.introductionHtml} />
      </header>

      <div class="healthcare-audit-strategy-process-flow" role="list" aria-label={`${copy.steps.length} service steps`}>
        <svg class="healthcare-audit-strategy-process-route" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="healthcare-audit-strategy-process-route-gradient" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="100" y2="100">
              <stop offset="0" stop-color="#6131c6" />
              <stop offset="0.5" stop-color="#229f60" />
              <stop offset="1" stop-color="#6131c6" />
            </linearGradient>
          </defs>
          <path class="healthcare-audit-strategy-process-route-base" d="M 16.667 12 H 50 H 83.333 H 98 V 58 H 83.333 H 50" />
          <g class="healthcare-audit-strategy-process-route-progress">
              <line class="healthcare-audit-strategy-process-route-horizontal" x1="16.667" y1="12" x2="50" y2="12" />
            <line class="healthcare-audit-strategy-process-route-horizontal" x1="50" y1="12" x2="83.333" y2="12" />
            <line class="healthcare-audit-strategy-process-route-horizontal" x1="83.333" y1="12" x2="98" y2="12" />
            <line class="healthcare-audit-strategy-process-route-vertical" x1="98" y1="12" x2="98" y2="58" />
            <line class="healthcare-audit-strategy-process-route-horizontal healthcare-audit-strategy-process-route-reverse" x1="98" y1="58" x2="83.333" y2="58" />
            <line class="healthcare-audit-strategy-process-route-horizontal healthcare-audit-strategy-process-route-reverse" x1="83.333" y1="58" x2="50" y2="58" />
          <line class="healthcare-audit-strategy-process-route-horizontal healthcare-audit-strategy-process-route-reverse" x1="50" y1="58" x2="16.667" y2="58" />
          </g>
        </svg>

        {copy.steps.map((step, index) => (
          <div class="healthcare-audit-strategy-process-step" role="listitem" data-seo-process-step>
            <div class="healthcare-audit-strategy-process-node-column" aria-hidden="true">
              <span class="healthcare-audit-strategy-process-node"><span>{String(index + 1).padStart(2, '0')}</span></span>
              {index < copy.steps.length - 1 && <span class="healthcare-audit-strategy-process-connector"></span>}
            </div>
            <div class="healthcare-audit-strategy-process-copy" data-seo-process-copy>
              <h3><span>{titleParts(step.title)[0]}</span>{titleParts(step.title)[1]}</h3>
              <div class="healthcare-audit-strategy-source-content" set:html={step.html} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</healthcare-audit-strategy-process>

<script>
  import '../scripts/healthcare-audit-strategy-process';
</script>
