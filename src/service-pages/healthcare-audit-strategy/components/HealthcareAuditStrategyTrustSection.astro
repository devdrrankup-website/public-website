---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import photo from '../../../assets/healthcare-marketing-services/healthcare-audit-strategy/trust-v1.webp';
import { pageCopy } from '../data/healthcare-audit-strategy-source';
const copy = pageCopy.trust;
import '../styles/healthcare-audit-strategy-trust.css';
---

<healthcare-audit-strategy-trust class="healthcare-audit-strategy-trust-motion">
  <section id="healthcare-audit-strategy-trust" class="healthcare-audit-strategy-trust" aria-labelledby="healthcare-audit-strategy-trust-heading">
    <div class="section-container healthcare-audit-strategy-trust-layout">
      <h2 id="healthcare-audit-strategy-trust-heading">{copy.heading}</h2>
      <div class="healthcare-audit-strategy-trust-profile healthcare-audit-strategy-source-content" data-seo-trust-motion set:html={copy.firstHtml} />
      <div class="healthcare-audit-strategy-trust-photo" data-seo-trust-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76} loading="lazy" decoding="async"
          alt="Clinician and strategist reviewing public healthcare information before approval"
          title="Clinician and strategist reviewing public healthcare information before approval" />
      </div>
      <div class="healthcare-audit-strategy-trust-privacy" data-seo-trust-motion>
        <span class="healthcare-audit-strategy-trust-lock" aria-hidden="true"><Icon icon={LockKeyIcon} size={24} /></span>
        <div class="healthcare-audit-strategy-source-content" set:html={copy.restHtml} />
      </div>
    </div>
  </section>
</healthcare-audit-strategy-trust>

<script>
  import '../scripts/healthcare-audit-strategy-trust';
</script>
