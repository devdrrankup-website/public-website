---
import { Image } from 'astro:assets';
import photo from '../../../assets/hospital-digital-marketing/hospital-digital-marketing-example-v1.webp';
import { pageCopy } from '../data/hospital-digital-marketing-source';
const copy = pageCopy.example;
import '../styles/hospital-digital-marketing-example.css';
---
<hospital-digital-marketing-example class="hospital-digital-marketing-example-motion">
  <section id="hospital-digital-marketing-example" class="hospital-digital-marketing-example" aria-labelledby="hospital-digital-marketing-example-heading">
    <div class="section-container hospital-digital-marketing-example-layout">
      <header class="hospital-digital-marketing-example-header" data-example-entry>
        <h2 id="hospital-digital-marketing-example-heading">{copy.heading}</h2>
        <span class="hospital-digital-marketing-example-rule" data-example-rule aria-hidden="true"></span>
      </header>
      <figure class="hospital-digital-marketing-example-photo" data-example-entry data-example-photo>
        <Image src={photo} alt="Receptionist showing hospital service details to a visitor" title="Receptionist showing hospital service details to a visitor" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <div class="hospital-digital-marketing-example-copy">
        <div class="hospital-digital-marketing-source-content" data-example-entry set:html={copy.html} />
      </div>
    </div>
  </section>
</hospital-digital-marketing-example>
<script>
  import '../scripts/hospital-digital-marketing-example';
</script>
