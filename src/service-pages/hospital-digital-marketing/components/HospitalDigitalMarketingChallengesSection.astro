---
import { Image } from 'astro:assets';
import photo from '../../../assets/hospital-digital-marketing/hospital-digital-marketing-challenges-v1.webp';
import { pageCopy } from '../data/hospital-digital-marketing-source';
const copy = pageCopy.challenges;
import '../styles/hospital-digital-marketing-challenges.css';
---

<hospital-digital-marketing-challenges class="hospital-digital-marketing-challenges">
  <section id="hospital-digital-marketing-challenges" class="section-container hospital-digital-marketing-challenges-layout" aria-labelledby="hospital-digital-marketing-challenges-heading">
    <div class="hospital-digital-marketing-challenges-editorial">
      <h2 id="hospital-digital-marketing-challenges-heading">{copy.heading}</h2>
      <p class="hospital-digital-marketing-challenges-introduction" set:html={copy.introductionHtml} />
      <div class="hospital-digital-marketing-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Hospital manager and staff comparing marketing information across screens"
          title="Hospital manager and staff comparing marketing information across screens"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="hospital-digital-marketing-challenges-details">
      {copy.preListHtml && <p class="hospital-digital-marketing-challenges-prelist" set:html={copy.preListHtml} />}
      <p id="hospital-digital-marketing-challenges-list-heading" class="hospital-digital-marketing-challenges-list-intro" set:html={copy.listIntroductionHtml} />
      <ul class="hospital-digital-marketing-challenges-list" role="list" aria-labelledby="hospital-digital-marketing-challenges-list-heading" data-seo-challenges-motion>
        {copy.challengesHtml.map((challenge, index) => <li>
          <span class="hospital-digital-marketing-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={challenge} />
        </li>)}
      </ul>
      {copy.conclusionHtml && <p class="hospital-digital-marketing-challenges-conclusion" set:html={copy.conclusionHtml} />}
    </div>
  </section>
</hospital-digital-marketing-challenges>

<script>
  import '../scripts/hospital-digital-marketing-challenges';
</script>
