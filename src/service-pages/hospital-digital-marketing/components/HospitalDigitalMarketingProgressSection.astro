---
import { Image } from 'astro:assets';
import photo from '../../../assets/hospital-digital-marketing/hospital-digital-marketing-progress-v1.webp';
import { pageCopy } from '../data/hospital-digital-marketing-source';
const copy = pageCopy.progress;
import '../styles/hospital-digital-marketing-progress.css';
---
<hospital-digital-marketing-progress class="hospital-digital-marketing-progress-motion">
  <section id="hospital-digital-marketing-progress" class="hospital-digital-marketing-progress" aria-labelledby="hospital-digital-marketing-progress-heading">
    <div class="section-container hospital-digital-marketing-progress-layout">
      <h2 id="hospital-digital-marketing-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="hospital-digital-marketing-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="hospital-digital-marketing-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Hospital manager and specialist reviewing a marketing report" title="Hospital manager and specialist reviewing a marketing report" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="hospital-digital-marketing-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</hospital-digital-marketing-progress>
<script>
  import '../scripts/hospital-digital-marketing-progress';
</script>
