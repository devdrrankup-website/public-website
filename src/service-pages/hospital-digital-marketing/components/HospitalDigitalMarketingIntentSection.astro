---
import { Image } from 'astro:assets';
import photo from '../../../assets/hospital-digital-marketing/hospital-digital-marketing-intent-v1.webp';
import { pageCopy } from '../data/hospital-digital-marketing-source';
const copy = pageCopy.intent;
import '../styles/hospital-digital-marketing-intent.css';
---
<hospital-digital-marketing-intent class="hospital-digital-marketing-intent">
  <section id="hospital-digital-marketing-intent" class="section-container hospital-digital-marketing-intent-layout" aria-labelledby="hospital-digital-marketing-intent-heading">
    <div class="hospital-digital-marketing-intent-copy" data-seo-intent-motion>
      <h2 id="hospital-digital-marketing-intent-heading">{copy.heading}</h2>
      <div class="hospital-digital-marketing-source-content" set:html={copy.html} />
    </div>
    <div class="hospital-digital-marketing-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Family looking up hospital services on a laptop at home"
        title="Family looking up hospital services on a laptop at home" />
    </div>
  </section>
</hospital-digital-marketing-intent>

<script>
  import '../scripts/hospital-digital-marketing-intent';
</script>
