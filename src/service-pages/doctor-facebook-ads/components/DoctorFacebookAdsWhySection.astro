---
import Icon from '../../../components/Icon.astro';
import UserAccountIcon from '@hugeicons/core-free-icons/UserAccountIcon';
import WorkflowSquare01Icon from '@hugeicons/core-free-icons/WorkflowSquare01Icon';
import TaskEdit01Icon from '@hugeicons/core-free-icons/TaskEdit01Icon';
import { pageCopy } from '../data/doctor-facebook-ads-source';
import { whyEditorial } from '../data/doctor-facebook-ads-section-editorial';
import '../styles/doctor-facebook-ads-why.css';
const copy = pageCopy.why;
const reasons = whyEditorial;
const visuals = [
  { icon: UserAccountIcon, accent: '#E1FFB9' },
  { icon: WorkflowSquare01Icon, accent: '#BAE5FF' },
  { icon: TaskEdit01Icon, accent: '#EEEDFE' },
];
---
<doctor-facebook-ads-why class="doctor-facebook-ads-why-motion">
  <section id="doctor-facebook-ads-why" class="doctor-facebook-ads-why" aria-labelledby="doctor-facebook-ads-why-heading">
    <div class="section-container doctor-facebook-ads-why-layout">
      <h2 id="doctor-facebook-ads-why-heading" data-why-entry>{copy.heading}</h2>
      <div class="doctor-facebook-ads-why-body">
        <ul class="doctor-facebook-ads-why-principles">
          {reasons.map((principle,index) => <li data-why-entry data-why-row>
            <span class="doctor-facebook-ads-why-icon" data-why-icon style={`--why-accent:${visuals[index % visuals.length].accent}`} aria-hidden="true"><Icon icon={visuals[index % visuals.length].icon} size={24} strokeWidth={1.7} /></span>
            <p><strong>{principle.label}</strong>{' '}{principle.description}</p>
          </li>)}
        </ul>
      </div>
    </div>
  </section>
</doctor-facebook-ads-why>
<script>
  import '../scripts/doctor-facebook-ads-why';
</script>
