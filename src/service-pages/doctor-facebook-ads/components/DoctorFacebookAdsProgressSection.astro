---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-facebook-ads/doctor-facebook-ads-progress-v1.webp';
import { pageCopy } from '../data/doctor-facebook-ads-source';
const copy = pageCopy.progress;
import '../styles/doctor-facebook-ads-progress.css';
---
<doctor-facebook-ads-progress class="doctor-facebook-ads-progress-motion">
  <section id="doctor-facebook-ads-progress" class="doctor-facebook-ads-progress" aria-labelledby="doctor-facebook-ads-progress-heading">
    <div class="section-container doctor-facebook-ads-progress-layout">
      <h2 id="doctor-facebook-ads-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="doctor-facebook-ads-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="doctor-facebook-ads-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Marketing specialist reviewing doctor advertising results" title="Marketing specialist reviewing doctor advertising results" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="doctor-facebook-ads-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</doctor-facebook-ads-progress>
<script>
  import '../scripts/doctor-facebook-ads-progress';
</script>
