import DoctorFacebookAdsOutcomesSection from './components/DoctorFacebookAdsOutcomesSection.astro';
import DoctorFacebookAdsIntentSection from './components/DoctorFacebookAdsIntentSection.astro';
import DoctorFacebookAdsTrustSection from './components/DoctorFacebookAdsTrustSection.astro';
import DoctorFacebookAdsExpertiseSection from './components/DoctorFacebookAdsExpertiseSection.astro';
import DoctorFacebookAdsProcessSection from './components/DoctorFacebookAdsProcessSection.astro';
import DoctorFacebookAdsMappingSection from './components/DoctorFacebookAdsMappingSection.astro';
import DoctorFacebookAdsRelatedSection from './components/DoctorFacebookAdsRelatedSection.astro';
import DoctorFacebookAdsStartingSection from './components/DoctorFacebookAdsStartingSection.astro';
import DoctorFacebookAdsExampleSection from './components/DoctorFacebookAdsExampleSection.astro';
