---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-content-marketing/doctor-content-marketing-challenges-v1.webp';
import { pageCopy } from '../data/doctor-content-marketing-source';
const copy = pageCopy.challenges;
import { challengeEditorial as editorial } from '../data/doctor-content-marketing-section-editorial';
import '../styles/doctor-content-marketing-challenges.css';
---

<doctor-content-marketing-challenges class="doctor-content-marketing-challenges">
  <section id="doctor-content-marketing-challenges" class="section-container doctor-content-marketing-challenges-layout" aria-labelledby="doctor-content-marketing-challenges-heading">
    <div class="doctor-content-marketing-challenges-editorial">
      <h2 id="doctor-content-marketing-challenges-heading">{copy.heading}</h2>
      <p class="doctor-content-marketing-challenges-introduction" set:html={editorial.introduction} />
      <div class="doctor-content-marketing-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Doctor and team comparing clinical information with website drafts"
          title="Doctor and team comparing clinical information with website drafts"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="doctor-content-marketing-challenges-details">
      <p id="doctor-content-marketing-challenges-list-heading" class="doctor-content-marketing-challenges-list-intro">{editorial.listIntro}</p>
      <ul class="doctor-content-marketing-challenges-list" role="list" aria-labelledby="doctor-content-marketing-challenges-list-heading" data-seo-challenges-motion>
        {editorial.points.map((paragraph, index) => <li>
          <span class="doctor-content-marketing-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={paragraph} />
        </li>)}
      </ul>
      <p class="doctor-content-marketing-challenges-conclusion">{editorial.conclusion}</p>
    </div>
  </section>
</doctor-content-marketing-challenges>

<script>
  import '../scripts/doctor-content-marketing-challenges';
</script>
