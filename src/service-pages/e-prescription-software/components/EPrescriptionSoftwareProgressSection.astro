---
import { Image } from 'astro:assets';
import photo from '../../../assets/e-prescription-software/e-prescription-software-progress-v1.webp';
import { pageCopy } from '../data/e-prescription-software-source';
const copy = pageCopy.progress;
import '../styles/e-prescription-software-progress.css';
---
<e-prescription-software-progress class="e-prescription-software-progress-motion">
  <section id="e-prescription-software-progress" class="e-prescription-software-progress" aria-labelledby="e-prescription-software-progress-heading">
    <div class="section-container e-prescription-software-progress-layout">
      <h2 id="e-prescription-software-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="e-prescription-software-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="e-prescription-software-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Doctor and team reviewing electronic prescription records" title="Doctor and team reviewing electronic prescription records" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="e-prescription-software-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</e-prescription-software-progress>
<script>
  import '../scripts/e-prescription-software-progress';
</script>
