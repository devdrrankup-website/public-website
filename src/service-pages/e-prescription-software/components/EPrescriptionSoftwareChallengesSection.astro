---
import { Image } from 'astro:assets';
import photo from '../../../assets/e-prescription-software/e-prescription-software-challenges-v1.webp';
import { pageCopy } from '../data/e-prescription-software-source';
const copy = pageCopy.challenges;
const introductionParagraph = copy.html.match(/^<p>([\s\S]*?)<\/p>/)?.[1] ?? '';
const detailParagraphs = Array.from(copy.html.matchAll(/<p>([\s\S]*?)<\/p>/g), match => match[1]).slice(1);
import '../styles/e-prescription-software-challenges.css';
---

<e-prescription-software-challenges class="e-prescription-software-challenges">
  <section id="e-prescription-software-challenges" class="section-container e-prescription-software-challenges-layout" aria-labelledby="e-prescription-software-challenges-heading">
    <div class="e-prescription-software-challenges-editorial">
      <h2 id="e-prescription-software-challenges-heading">{copy.heading}</h2>
      <p class="e-prescription-software-challenges-introduction" set:html={introductionParagraph} />
      <div class="e-prescription-software-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Doctor reviewing paper prescriptions with clinic staff"
          title="Doctor reviewing paper prescriptions with clinic staff"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="e-prescription-software-challenges-details">
      <ul class="e-prescription-software-challenges-list" role="list" data-seo-challenges-motion>
        {detailParagraphs.map((paragraph, index) => <li>
          <span class="e-prescription-software-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={paragraph} />
        </li>)}
      </ul>
    </div>
  </section>
</e-prescription-software-challenges>

<script>
  import '../scripts/e-prescription-software-challenges';
</script>
