---
import ActionIcon from '../../../components/ActionIcon.astro';
import { pageCopy } from '../data/e-prescription-software-source';
const copy = pageCopy.hero;
import { ePrescriptionSoftwareHeroImage as photo } from '../lib/e-prescription-software-hero-image';
import '../styles/e-prescription-software-hero.css';
---

<section class="e-prescription-software-hero" aria-labelledby="e-prescription-software-heading">
  <div class="section-container e-prescription-software-hero-layout">
    <div class="e-prescription-software-hero-copy">
      <h1 id="e-prescription-software-heading">{copy.heading}</h1>
      <p class="e-prescription-software-hero-tagline">{copy.tagline}</p>
      <div class="e-prescription-software-hero-description">
        {copy.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      </div>
      <div class="e-prescription-software-hero-actions" aria-label={`${copy.heading} options`}>
        <a class="button button-primary" href="/contact/">
          <span>{copy.primaryCta}</span><ActionIcon purpose="conversation" />
        </a>
        <a class="button button-secondary" href={copy.secondaryHref}>
          <span>{copy.secondaryCta}</span><ActionIcon purpose="conversation" />
        </a>
      </div>
    </div>
    <div class="e-prescription-software-hero-visual">
      <div class="e-prescription-software-hero-photo">
        <img src={photo.src} srcset={photo.srcset} sizes={photo.sizes}
          width={photo.width} height={photo.height}
          alt="Doctor entering a prescription on a desktop computer during a chamber consultation"
          title="Preparing an electronic prescription in a chamber"
          loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
</section>
