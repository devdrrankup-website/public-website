---
import { Image } from 'astro:assets';
import photo from '../../../assets/e-prescription-software/e-prescription-software-starting-v1.webp';
import { pageCopy } from '../data/e-prescription-software-source';
const copy = pageCopy.starting;
import '../styles/e-prescription-software-starting.css';
---
<e-prescription-software-starting class="e-prescription-software-starting-motion">
  <section id="e-prescription-software-starting" class="e-prescription-software-starting" aria-labelledby="e-prescription-software-starting-heading">
    <div class="section-container e-prescription-software-starting-layout">
      <h2 id="e-prescription-software-starting-heading" data-starting-entry>{copy.heading}</h2>
      <div class="e-prescription-software-starting-copy" data-starting-entry>
        <div class="e-prescription-software-source-content" set:html={copy.html} />
      </div>
      <figure class="e-prescription-software-starting-visual" data-starting-entry data-starting-visual>
        <Image src={photo} alt="Doctor and specialist mapping an electronic prescription workflow" title="Doctor and specialist mapping an electronic prescription workflow" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 540px, (min-width:640px) 320px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>
</e-prescription-software-starting>
<script>
  import '../scripts/e-prescription-software-starting';
</script>
