---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-google-ads/doctor-google-ads-challenges-v1.webp';
import { pageCopy } from '../data/doctor-google-ads-source';
const copy = pageCopy.challenges;
const introductionParagraph = copy.html.match(/^<p>([\s\S]*?)<\/p>/)?.[1] ?? '';
const detailParagraphs = Array.from(copy.html.matchAll(/<p>([\s\S]*?)<\/p>/g), match => match[1]).slice(1);
import '../styles/doctor-google-ads-challenges.css';
---

<doctor-google-ads-challenges class="doctor-google-ads-challenges">
  <section id="doctor-google-ads-challenges" class="section-container doctor-google-ads-challenges-layout" aria-labelledby="doctor-google-ads-challenges-heading">
    <div class="doctor-google-ads-challenges-editorial">
      <h2 id="doctor-google-ads-challenges-heading">{copy.heading}</h2>
      <p class="doctor-google-ads-challenges-introduction" set:html={introductionParagraph} />
      <div class="doctor-google-ads-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Doctor and assistant checking proposed search advertising information"
          title="Doctor and assistant checking proposed search advertising information"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="doctor-google-ads-challenges-details">
      <ul class="doctor-google-ads-challenges-list" role="list" data-seo-challenges-motion>
        {detailParagraphs.map((paragraph, index) => <li>
          <span class="doctor-google-ads-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={paragraph} />
        </li>)}
      </ul>
    </div>
  </section>
</doctor-google-ads-challenges>

<script>
  import '../scripts/doctor-google-ads-challenges';
</script>
