---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import Arrow from '../../../components/Arrow.astro';
import Search01Icon from '@hugeicons/core-free-icons/Search01Icon';
import Facebook01Icon from '@hugeicons/core-free-icons/Facebook01Icon';
import Location04Icon from '@hugeicons/core-free-icons/Location04Icon';
import { pageCopy } from '../data/doctor-google-ads-source';
const copy = pageCopy.related;
import relatedImage0 from '../../../assets/related-services/doctor-seo-preview-v1.webp';
import relatedImage1 from '../../../assets/doctor-facebook-ads/doctor-facebook-ads-related-preview-v1.webp';
import relatedImage2 from '../../../assets/doctor-local-seo/doctor-local-seo-related-preview-v1.webp';
import relatedImage3 from '../../../assets/doctor-google-business-profile/doctor-google-business-profile-related-preview-v1.webp';
import '../styles/doctor-google-ads-related.css';
const visuals = [
  { image: relatedImage0, icon: Search01Icon, accent: '#BAE5FF', description: "At home in Bangladesh, a prospective patient compares two doctor profile pages on a front-facing laptop." },
  { image: relatedImage1, icon: Facebook01Icon, accent: '#EEEDFE', description: "An agency advertising specialist and doctor compare two neutral creative layouts on a front-facing monitor, with no metrics, endorsements or platform logo." },
  { image: relatedImage2, icon: Location04Icon, accent: '#FEF2CC', description: "At home in Bangladesh, a patient checks the doctor's actual chamber area on a front-facing phone map while planning a visit; no invented address." },
  { image: relatedImage3, icon: Location04Icon, accent: '#E4FFBD', description: "At a doctor's chamber entrance, a civilian profile specialist photographs the doorway while an assistant checks the entrance details." },
];
---
<section id="doctor-google-ads-related" class="doctor-google-ads-related" aria-labelledby="doctor-google-ads-related-heading">
  <div class="section-container doctor-google-ads-related-container">
    <doctor-google-ads-related>
      <header class="doctor-google-ads-related-header" data-related-entry>
        <h2 id="doctor-google-ads-related-heading">{copy.heading}</h2>
        <div class="doctor-google-ads-source-content" set:html={copy.introductionHtml} />
      </header>
      <div class="doctor-google-ads-related-layout">
        <div class="doctor-google-ads-related-dock">
          <div class="doctor-google-ads-related-selectors" role="group" aria-label="Service image previews" hidden>
            {copy.services.map((service, index) => <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`related-${service.key}`} data-related-select={index}>
              <span>{service.name}</span>
            </button>)}
          </div>
          <div class="doctor-google-ads-related-stage" aria-hidden="true" hidden></div>
        </div>
        <div class="doctor-google-ads-related-details">
          <div class="doctor-google-ads-related-labels"><span>{copy.headers[0]}</span><span>{copy.headers[1]}</span></div>
          <dl class="doctor-google-ads-related-list">
            {copy.services.map((service, index) => <div class="doctor-google-ads-related-row" id={`related-${service.key}`} data-service={service.key}>
              <dt>
                <span class="doctor-google-ads-related-badge" style={`--related-accent:${visuals[index % visuals.length].accent}`}><Icon icon={visuals[index % visuals.length].icon} size={21} strokeWidth={1.8} /></span>
                <span class="doctor-google-ads-related-reveal" aria-hidden="true"></span>
                {service.href ? <a class="doctor-google-ads-related-name" href={service.href}>{service.name}</a>
                  : <span class="doctor-google-ads-related-name">{service.name}</span>}
                <span class="doctor-google-ads-related-arrow" aria-hidden="true"><Arrow /></span>
              </dt>
              <dd>
                <span>{service.responsibility}</span>
                <figure class="doctor-google-ads-related-photo">
                  <Image src={visuals[index % visuals.length].image} alt={visuals[index % visuals.length].description} title={visuals[index % visuals.length].description} width={960} widths={[360,640,960]} sizes="(min-width:1100px) 700px, (min-width:640px) 700px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
                  <figcaption>{service.name}</figcaption>
                </figure>
              </dd>
            </div>)}
          </dl>
          <div class="doctor-google-ads-related-note doctor-google-ads-source-content" set:html={copy.noteHtml} />
        </div>
      </div>
    </doctor-google-ads-related>
  </div>
</section>
<script>
  import '../scripts/doctor-google-ads-related';
</script>
