---
import {linkOfficialGuidanceHtml} from '../../../lib/official-guidance';
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import photo from '../../../assets/doctor-google-ads/doctor-google-ads-trust-v1.webp';
import { pageCopy } from '../data/doctor-google-ads-source';
const copy = pageCopy.trust;
const officialLinks = new Set<string>();
const trustFirstHtml = linkOfficialGuidanceHtml(copy.firstHtml, officialLinks);
const trustRestHtml = linkOfficialGuidanceHtml(copy.restHtml, officialLinks);
import '../styles/doctor-google-ads-trust.css';
---

<doctor-google-ads-trust class="doctor-google-ads-trust-motion">
  <section id="doctor-google-ads-trust" class="doctor-google-ads-trust" aria-labelledby="doctor-google-ads-trust-heading">
    <div class="section-container doctor-google-ads-trust-layout">
      <h2 id="doctor-google-ads-trust-heading">{copy.heading}</h2>
      <div class="doctor-google-ads-trust-profile doctor-google-ads-source-content" data-seo-trust-motion set:html={trustFirstHtml} />
      <div class="doctor-google-ads-trust-photo" data-seo-trust-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76} loading="lazy" decoding="async"
          alt="Doctor and specialist verifying the claims in a search advertisement"
          title="Doctor and specialist verifying the claims in a search advertisement" />
      </div>
      <div class="doctor-google-ads-trust-privacy" data-seo-trust-motion>
        <span class="doctor-google-ads-trust-lock" aria-hidden="true"><Icon icon={LockKeyIcon} size={24} /></span>
        <div class="doctor-google-ads-source-content" set:html={trustRestHtml} />
      </div>
    </div>
  </section>
</doctor-google-ads-trust>

<script>
  import '../scripts/doctor-google-ads-trust';
</script>
