---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-scheduling-software/doctor-scheduling-software-intent-v1.webp';
import { pageCopy } from '../data/doctor-scheduling-software-source';
const copy = pageCopy.intent;
import '../styles/doctor-scheduling-software-intent.css';
---
<doctor-scheduling-software-intent class="doctor-scheduling-software-intent">
  <section id="doctor-scheduling-software-intent" class="section-container doctor-scheduling-software-intent-layout" aria-labelledby="doctor-scheduling-software-intent-heading">
    <div class="doctor-scheduling-software-intent-copy" data-seo-intent-motion>
      <h2 id="doctor-scheduling-software-intent-heading">{copy.heading}</h2>
      <div class="doctor-scheduling-software-source-content" set:html={copy.html} />
    </div>
    <div class="doctor-scheduling-software-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Doctor checking a digital chamber schedule with an assistant"
        title="Doctor checking a digital chamber schedule with an assistant" />
    </div>
  </section>
</doctor-scheduling-software-intent>

<script>
  import '../scripts/doctor-scheduling-software-intent';
</script>
