---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import Arrow from '../../../components/Arrow.astro';
import Calendar03Icon from '@hugeicons/core-free-icons/Calendar03Icon';
import { pageCopy } from '../data/doctor-scheduling-software-source';
const copy = pageCopy.related;
import relatedImage0 from '../../../assets/patient-appointment-management/patient-appointment-management-related-preview-v1.webp';
import '../styles/doctor-scheduling-software-related.css';
const visuals = [
  { image: relatedImage0, icon: Calendar03Icon, accent: '#BAE5FF', description: "At a doctor's chamber reception, a receptionist welcomes a visitor while another staff member checks a clearly blank appointment list on the front of a tablet." },
];
---
<section id="doctor-scheduling-software-related" class="doctor-scheduling-software-related" aria-labelledby="doctor-scheduling-software-related-heading">
  <div class="section-container doctor-scheduling-software-related-container">
    <doctor-scheduling-software-related>
      <header class="doctor-scheduling-software-related-header" data-related-entry>
        <h2 id="doctor-scheduling-software-related-heading">{copy.heading}</h2>
        <div class="doctor-scheduling-software-source-content" set:html={copy.introductionHtml} />
      </header>
      <div class="doctor-scheduling-software-related-layout">
        <div class="doctor-scheduling-software-related-dock">
          <div class="doctor-scheduling-software-related-selectors" role="group" aria-label="Service image previews" hidden>
            {copy.services.map((service, index) => <button type="button" aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`related-${service.key}`} data-related-select={index}>
              <span>{service.name}</span>
            </button>)}
          </div>
          <div class="doctor-scheduling-software-related-stage" aria-hidden="true" hidden></div>
        </div>
        <div class="doctor-scheduling-software-related-details">
          <div class="doctor-scheduling-software-related-labels"><span>{copy.headers[0]}</span><span>{copy.headers[1]}</span></div>
          <dl class="doctor-scheduling-software-related-list">
            {copy.services.map((service, index) => <div class="doctor-scheduling-software-related-row" id={`related-${service.key}`} data-service={service.key}>
              <dt>
                <span class="doctor-scheduling-software-related-badge" style={`--related-accent:${visuals[index % visuals.length].accent}`}><Icon icon={visuals[index % visuals.length].icon} size={21} strokeWidth={1.8} /></span>
                <span class="doctor-scheduling-software-related-reveal" aria-hidden="true"></span>
                {service.href ? <a class="doctor-scheduling-software-related-name" href={service.href}>{service.name}</a>
                  : <span class="doctor-scheduling-software-related-name">{service.name}</span>}
                <span class="doctor-scheduling-software-related-arrow" aria-hidden="true"><Arrow /></span>
              </dt>
              <dd>
                <span>{service.responsibility}</span>
                <figure class="doctor-scheduling-software-related-photo">
                  <Image src={visuals[index % visuals.length].image} alt={visuals[index % visuals.length].description} title={visuals[index % visuals.length].description} width={960} widths={[360,640,960]} sizes="(min-width:1100px) 700px, (min-width:640px) 700px, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
                  <figcaption>{service.name}</figcaption>
                </figure>
              </dd>
            </div>)}
          </dl>
          <div class="doctor-scheduling-software-related-note doctor-scheduling-software-source-content" set:html={copy.noteHtml} />
        </div>
      </div>
    </doctor-scheduling-software-related>
  </div>
</section>
<script>
  import '../scripts/doctor-scheduling-software-related';
</script>
