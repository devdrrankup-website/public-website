---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-scheduling-software/doctor-scheduling-software-progress-v1.webp';
import { pageCopy } from '../data/doctor-scheduling-software-source';
const copy = pageCopy.progress;
import '../styles/doctor-scheduling-software-progress.css';
---
<doctor-scheduling-software-progress class="doctor-scheduling-software-progress-motion">
  <section id="doctor-scheduling-software-progress" class="doctor-scheduling-software-progress" aria-labelledby="doctor-scheduling-software-progress-heading">
    <div class="section-container doctor-scheduling-software-progress-layout">
      <h2 id="doctor-scheduling-software-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="doctor-scheduling-software-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="doctor-scheduling-software-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Clinic team reviewing scheduling records on a laptop" title="Clinic team reviewing scheduling records on a laptop" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="doctor-scheduling-software-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</doctor-scheduling-software-progress>
<script>
  import '../scripts/doctor-scheduling-software-progress';
</script>
