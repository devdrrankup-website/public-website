---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-local-seo/hridoy-local-search-review-v2.webp';
import { pageCopy } from '../data/doctor-local-seo-source';
const copy = pageCopy.progress;
import '../styles/doctor-local-seo-progress.css';
---
<doctor-local-seo-progress class="doctor-local-seo-progress-motion">
  <section id="doctor-local-seo-progress" class="doctor-local-seo-progress" aria-labelledby="doctor-local-seo-progress-heading">
    <div class="section-container doctor-local-seo-progress-layout">
      <h2 id="doctor-local-seo-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="doctor-local-seo-progress-baseline" data-progress-entry>{copy.paragraphs[0]}</p>
      <figure class="doctor-local-seo-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Hridoy Chowdhury comparing chamber listing details at an agency workstation" title="Hridoy Chowdhury comparing chamber listing details at an agency workstation" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="doctor-local-seo-progress-evidence" data-progress-entry>{copy.paragraphs[1]}</p>
    </div>
  </section>
</doctor-local-seo-progress>
<script>
  import '../scripts/doctor-local-seo-progress';
</script>
