---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-local-seo/patient-chamber-directions-v1.webp';
import { pageCopy } from '../data/doctor-local-seo-source';
const copy = pageCopy.intent;
import '../styles/doctor-local-seo-intent.css';
---
<doctor-local-seo-intent class="doctor-local-seo-intent">
  <section id="doctor-local-seo-intent" class="section-container doctor-local-seo-intent-layout" aria-labelledby="doctor-local-seo-intent-heading">
    <div class="doctor-local-seo-intent-copy" data-seo-intent-motion>
      <h2 id="doctor-local-seo-intent-heading">{copy.heading}</h2>
      <div class="doctor-local-seo-source-content" set:html={copy.html} />
    </div>
    <div class="doctor-local-seo-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Woman at home checking directions to a doctor's chamber on her phone in Dhaka"
        title="Checking chamber directions from home" />
    </div>
  </section>
</doctor-local-seo-intent>

<script>
  import '../scripts/doctor-local-seo-intent';
</script>
