---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-personal-branding/doctor-personal-branding-challenges-v1.webp';
import { pageCopy } from '../data/doctor-personal-branding-source';
const copy = pageCopy.challenges;
const introductionParagraph = copy.html.match(/^<p>([\s\S]*?)<\/p>/)?.[1] ?? '';
const detailHtml = copy.html.replace(/^<p>[\s\S]*?<\/p>/, '');
import '../styles/doctor-personal-branding-challenges.css';
---

<doctor-personal-branding-challenges class="doctor-personal-branding-challenges">
  <section id="doctor-personal-branding-challenges" class="section-container doctor-personal-branding-challenges-layout" aria-labelledby="doctor-personal-branding-challenges-heading">
    <div class="doctor-personal-branding-challenges-editorial">
      <h2 id="doctor-personal-branding-challenges-heading">{copy.heading}</h2>
      <p class="doctor-personal-branding-challenges-introduction" set:html={introductionParagraph} />
      <div class="doctor-personal-branding-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Doctor and specialist comparing online professional profile drafts"
          title="Doctor and specialist comparing online professional profile drafts"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="doctor-personal-branding-challenges-details doctor-personal-branding-source-content" set:html={detailHtml} />
  </section>
</doctor-personal-branding-challenges>

<script>
  import '../scripts/doctor-personal-branding-challenges';
</script>
