---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-personal-branding/doctor-personal-branding-progress-v1.webp';
import { pageCopy } from '../data/doctor-personal-branding-source';
const copy = pageCopy.progress;
import '../styles/doctor-personal-branding-progress.css';
---
<doctor-personal-branding-progress class="doctor-personal-branding-progress-motion">
  <section id="doctor-personal-branding-progress" class="doctor-personal-branding-progress" aria-labelledby="doctor-personal-branding-progress-heading">
    <div class="section-container doctor-personal-branding-progress-layout">
      <h2 id="doctor-personal-branding-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="doctor-personal-branding-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="doctor-personal-branding-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Specialist reviewing a doctor profile report and printed material" title="Specialist reviewing a doctor profile report and printed material" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="doctor-personal-branding-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</doctor-personal-branding-progress>
<script>
  import '../scripts/doctor-personal-branding-progress';
</script>
