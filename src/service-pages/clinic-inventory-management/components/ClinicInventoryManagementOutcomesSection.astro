---
import ClinicInventoryManagementOutcomeVisual from './ClinicInventoryManagementOutcomeVisual.astro';
import { pageCopy } from '../data/clinic-inventory-management-source';
const copy = pageCopy.outcomes;
import '../styles/clinic-inventory-management-outcomes.css';
---
<clinic-inventory-management-outcomes class="clinic-inventory-management-outcomes">
  <section id="clinic-inventory-management-outcomes" class="section-container" aria-labelledby="clinic-inventory-management-outcomes-heading">
    <div class="clinic-inventory-management-outcomes-heading">
      <h2 id="clinic-inventory-management-outcomes-heading">{copy.heading}</h2>
      <div class="clinic-inventory-management-outcomes-introduction clinic-inventory-management-source-content" set:html={copy.before} />
    </div>
    <ul class="clinic-inventory-management-outcomes-list" role="list">
      {copy.items.map((item, index) => <li class="clinic-inventory-management-outcome" data-seo-outcomes-motion>
        <ClinicInventoryManagementOutcomeVisual index={index} />
        <p><strong>{item.label}</strong><span>{item.description}</span></p>
      </li>)}
    </ul>
    <div class="clinic-inventory-management-outcomes-conclusion clinic-inventory-management-source-content" set:html={copy.after} />
  </section>
</clinic-inventory-management-outcomes>

<script>
  import '../scripts/clinic-inventory-management-outcomes';
</script>
