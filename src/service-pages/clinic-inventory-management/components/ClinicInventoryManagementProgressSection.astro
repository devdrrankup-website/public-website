---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-inventory-management/clinic-inventory-management-progress-v1.webp';
import { pageCopy } from '../data/clinic-inventory-management-source';
const copy = pageCopy.progress;
import '../styles/clinic-inventory-management-progress.css';
---
<clinic-inventory-management-progress class="clinic-inventory-management-progress-motion">
  <section id="clinic-inventory-management-progress" class="clinic-inventory-management-progress" aria-labelledby="clinic-inventory-management-progress-heading">
    <div class="section-container clinic-inventory-management-progress-layout">
      <h2 id="clinic-inventory-management-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="clinic-inventory-management-progress-baseline" data-progress-entry set:html={copy.paragraphsHtml[0]} />
      <figure class="clinic-inventory-management-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Clinic team reviewing stock records beside supply shelves" title="Clinic team reviewing stock records beside supply shelves" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="clinic-inventory-management-progress-evidence" data-progress-entry set:html={copy.paragraphsHtml[1]} />

    </div>
  </section>
</clinic-inventory-management-progress>
<script>
  import '../scripts/clinic-inventory-management-progress';
</script>
