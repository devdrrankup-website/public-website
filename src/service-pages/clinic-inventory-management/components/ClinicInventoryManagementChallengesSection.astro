---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-inventory-management/clinic-inventory-management-challenges-v1.webp';
import { pageCopy } from '../data/clinic-inventory-management-source';
const copy = pageCopy.challenges;
import '../styles/clinic-inventory-management-challenges.css';
---

<clinic-inventory-management-challenges class="clinic-inventory-management-challenges">
  <section id="clinic-inventory-management-challenges" class="section-container clinic-inventory-management-challenges-layout" aria-labelledby="clinic-inventory-management-challenges-heading">
    <div class="clinic-inventory-management-challenges-editorial">
      <h2 id="clinic-inventory-management-challenges-heading">{copy.heading}</h2>
      <p class="clinic-inventory-management-challenges-introduction" set:html={copy.introductionHtml} />
      <div class="clinic-inventory-management-challenges-photo" data-seo-challenges-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(41vw, 568px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76}
          alt="Clinic staff checking medicine stock against paper and computer records"
          title="Clinic staff checking medicine stock against paper and computer records"
          loading="lazy" decoding="async" />
      </div>
    </div>
    <div class="clinic-inventory-management-challenges-details">
      {copy.preListHtml && <p class="clinic-inventory-management-challenges-prelist" set:html={copy.preListHtml} />}
      <p id="clinic-inventory-management-challenges-list-heading" class="clinic-inventory-management-challenges-list-intro" set:html={copy.listIntroductionHtml} />
      <ul class="clinic-inventory-management-challenges-list" role="list" aria-labelledby="clinic-inventory-management-challenges-list-heading" data-seo-challenges-motion>
        {copy.challengesHtml.map((challenge, index) => <li>
          <span class="clinic-inventory-management-challenge-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span set:html={challenge} />
        </li>)}
      </ul>
      {copy.conclusionHtml && <p class="clinic-inventory-management-challenges-conclusion" set:html={copy.conclusionHtml} />}
    </div>
  </section>
</clinic-inventory-management-challenges>

<script>
  import '../scripts/clinic-inventory-management-challenges';
</script>
