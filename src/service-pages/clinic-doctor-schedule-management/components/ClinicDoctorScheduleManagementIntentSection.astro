---
import { Image } from 'astro:assets';
import photo from '../../../assets/clinic-doctor-schedule-management/clinic-doctor-schedule-management-intent-v1.webp';
import { pageCopy } from '../data/clinic-doctor-schedule-management-source';
const copy = pageCopy.intent;
import '../styles/clinic-doctor-schedule-management-intent.css';
---
<clinic-doctor-schedule-management-intent class="clinic-doctor-schedule-management-intent">
  <section id="clinic-doctor-schedule-management-intent" class="section-container clinic-doctor-schedule-management-intent-layout" aria-labelledby="clinic-doctor-schedule-management-intent-heading">
    <div class="clinic-doctor-schedule-management-intent-copy" data-seo-intent-motion>
      <h2 id="clinic-doctor-schedule-management-intent-heading">{copy.heading}</h2>
      <div class="clinic-doctor-schedule-management-source-content" set:html={copy.html} />
    </div>
    <div class="clinic-doctor-schedule-management-intent-photo" data-seo-intent-motion>
      <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
        sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
        format="webp" quality={76} loading="lazy" decoding="async"
        alt="Receptionist checking a doctor schedule on a clinic computer"
        title="Receptionist checking a doctor schedule on a clinic computer" />
    </div>
  </section>
</clinic-doctor-schedule-management-intent>

<script>
  import '../scripts/clinic-doctor-schedule-management-intent';
</script>
