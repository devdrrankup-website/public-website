---
import {Image} from 'astro:assets';
import communication from '../assets/responsibility/responsible-communication.png';
import telehealth from '../assets/responsibility/private-telehealth.png';
import {homepageResponsibility as content} from '../data/homepage-responsibility';
const sizes = '(min-width: 1340px) 589px, (min-width: 900px) calc((100vw - 128px) / 2), (min-width: 640px) calc(100vw - 56px), calc(100vw - 32px)';
const conclusionEmphasis = 'healthcare responsibilities.';
const conclusionStart = content.conclusion.slice(0,-conclusionEmphasis.length);
---
<responsible-healthcare>
  <section id="responsible-healthcare" class="responsibility-section" aria-labelledby="responsibility-heading">
    <div class="section-container responsibility-container">
      <header class="responsibility-introduction">
        <p class="responsibility-eyebrow">Responsible growth</p>
        <h2 id="responsibility-heading">{content.heading}</h2>
        <p class="responsibility-summary">{content.introduction}</p>
      </header>

      <div class="responsibility-principles">
        <article class="responsibility-principle" aria-labelledby="communication-heading">
          <header class="responsibility-title">
            <span class="responsibility-index" aria-hidden="true">01</span>
            <h3 id="communication-heading">{content.communication.heading}</h3>
          </header>
          <div class="responsibility-photo">
            <div class="responsibility-image-frame">
              <Image src={communication} alt="Bangladeshi doctor discussing written information with a patient in a clinic."
                title="Clear, responsible doctor–patient communication in Bangladesh"
                width={1200} height={900} widths={[320,480,640,960,1200]} sizes={sizes}
                format="webp" quality={80} loading="lazy" decoding="async"/>
            </div>
          </div>
          <div class="responsibility-copy">
            {content.communication.paragraphs.map((paragraph,index) => (
              <p class:list={{'responsibility-key-statement': index === 1}}>{paragraph}</p>
            ))}
          </div>
        </article>

        <article class="responsibility-principle responsibility-principle-reverse" aria-labelledby="privacy-heading">
          <header class="responsibility-title">
            <span class="responsibility-index" aria-hidden="true">02</span>
            <h3 id="privacy-heading">{content.privacy.heading}</h3>
          </header>
          <div class="responsibility-photo">
            <div class="responsibility-image-frame">
              <Image src={telehealth} alt="Bangladeshi doctor speaking with a woman through a private video consultation on a laptop."
                title="Private telehealth consultation in a Bangladesh clinic"
                width={1200} height={900} widths={[320,480,640,960,1200]} sizes={sizes}
                format="webp" quality={80} loading="lazy" decoding="async"/>
            </div>
          </div>
          <div class="responsibility-copy">
            <p>{content.privacy.introduction}</p>
            <div class="responsibility-considerations">
              <p>{content.privacy.considerationsIntroduction}</p>
              <ul aria-label="Telehealth and patient-data considerations">
                {content.privacy.considerations.map(item => <li>{item}</li>)}
              </ul>
            </div>
            <p>{content.privacy.guidance}</p>
          </div>
        </article>
      </div>

      <p class="responsibility-conclusion">{conclusionStart}<em>{conclusionEmphasis}</em></p>
    </div>
  </section>
</responsible-healthcare>

<style>
  responsible-healthcare { display: block; }
  .responsibility-section { padding-block: 32px 56px; color: var(--ink); background: linear-gradient(0deg, #eaf7ff, #eaf7ff00 56px); }
  .responsibility-container { max-width: 1250px; }
  .responsibility-introduction { display: grid; justify-items: center; gap: 18px; text-align: center; }
  .responsibility-eyebrow { margin: 0; color: var(--accent-green); font-size: 12px; font-weight: 650; line-height: 1.5; letter-spacing: .09em; text-transform: uppercase; }
  .responsibility-introduction h2 { max-width: 900px; margin: 0; font-size: clamp(30px,4vw,48px); font-weight: 650; line-height: 1.2; letter-spacing: -.035em; text-wrap: balance; }
  .responsibility-summary { max-width: 740px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.8; text-wrap: pretty; }
  .responsibility-principles { display: grid; gap: 40px; margin-top: 40px; }
  .responsibility-principle { display: grid; grid-template-areas: 'title' 'visual' 'copy'; gap: 24px; min-width: 0; }
  .responsibility-principle+.responsibility-principle { padding-top: 40px; border-top: 1px solid var(--accent-green-line); }
  .responsibility-title { grid-area: title; display: grid; gap: 12px; }
  .responsibility-index { color: var(--purple); font-size: 12px; font-weight: 600; line-height: 1.5; }
  .responsibility-title h3 { max-width: 560px; margin: 0; font-size: clamp(24px,2.3vw,32px); font-weight: 600; line-height: 1.3; letter-spacing: -.025em; text-wrap: pretty; }
  .responsibility-photo { grid-area: visual; align-self: center; min-width: 0; }
  .responsibility-image-frame { aspect-ratio: 4 / 3; overflow: clip; border-radius: 24px; background: #eeedfe; }
  .responsibility-image-frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .responsibility-copy { grid-area: copy; display: grid; align-content: start; gap: 20px; min-width: 0; }
  .responsibility-copy p { max-width: 620px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .responsibility-copy .responsibility-key-statement { padding-left: 18px; border-left: 2px solid #229f6066; color: var(--ink); font-weight: 550; }
  .responsibility-considerations { display: grid; gap: 14px; }
  .responsibility-considerations ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .responsibility-considerations li { --pill-accent: #bae5ff; --pill-surface: #bae5ff4d; max-width: 100%; padding: 6px 10px; border: 1px solid var(--pill-accent); border-radius: var(--control-radius); color: var(--ink); background: var(--pill-surface); font-size: 12px; font-weight: 550; line-height: 1.6; }
  .responsibility-considerations li:nth-child(2) { --pill-accent: #afa9ec; --pill-surface: #eeedfe; }
  .responsibility-considerations li:nth-child(3) { --pill-accent: #e1ffb9; --pill-surface: #e1ffb966; }
  .responsibility-considerations li:nth-child(4) { --pill-accent: #eddafa; --pill-surface: #eddafa66; }
  .responsibility-considerations li:nth-child(5) { --pill-accent: #fef2cc; --pill-surface: #fef2cc80; }
  .responsibility-conclusion { margin: 40px 0 0; padding: 18px 24px; border: 1px solid var(--accent-green-line); border-radius: 999px; color: var(--ink); background: linear-gradient(90deg,#e1ffb9 0%,#fff 50%,#e1ffb9 100%); font-size: clamp(15px,1.35vw,20px); font-weight: 500; line-height: 1.65; text-align: center; text-wrap: pretty; }
  .responsibility-conclusion em { margin-inline-start: .1em; color: var(--accent-green); font-family: Georgia,'Times New Roman',serif; font-size: 1.15em; font-weight: 600; }
  @media (min-width: 640px) {
    .responsibility-section { padding-block: 40px 72px; }
    .responsibility-introduction { gap: 20px; }
    .responsibility-summary,.responsibility-copy p { font-size: 16px; }
    .responsibility-principles { gap: 56px; margin-top: 56px; }
    .responsibility-principle+.responsibility-principle { padding-top: 56px; }
    .responsibility-considerations li { font-size: 13px; }
  }
  @media (min-width: 900px) {
    .responsibility-section { padding-block: 48px 96px; }
    .responsibility-summary { font-size: 17px; }
    .responsibility-principles { gap: 72px; margin-top: 72px; }
    .responsibility-principle { grid-template-columns: minmax(0,1fr) minmax(0,1fr); grid-template-rows: auto 1fr; grid-template-areas: 'visual title' 'visual copy'; column-gap: 72px; row-gap: 20px; align-items: start; }
    .responsibility-principle-reverse { grid-template-areas: 'title visual' 'copy visual'; }
    .responsibility-principle+.responsibility-principle { padding-top: 72px; }
    .responsibility-title { padding-top: 8px; }
    .responsibility-image-frame { border-radius: 32px; }
    .responsibility-conclusion { margin-top: 64px; }
  }
</style>
