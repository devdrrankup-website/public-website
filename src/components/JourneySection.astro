---
import { Image } from 'astro:assets';
import { homepageJourney } from '../data/homepage-journey';
import clinicScene from '../assets/bangladesh-journey-home-v2.png';
---

<healthcare-journey>
  <section id="healthcare-journey" class="journey-section" aria-labelledby="journey-heading">
    <div class="section-container journey-layout">
      <div class="journey-copy">
        <h2 id="journey-heading">{homepageJourney.heading}</h2>
        <p>{homepageJourney.introduction}</p>
        <ol class="journey-steps" role="list" aria-label="Healthcare discovery journey">
          {homepageJourney.steps.map((step, index) => (
            <li>
              {index > 0 && <span class="journey-step-arrow" aria-hidden="true">→</span>}
              <span class="journey-pill">{step}</span>
            </li>
          ))}
        </ol>
        <p>{homepageJourney.connection}</p>
      </div>
      <figure class="journey-photo">
        <div class="journey-image-frame">
          <Image
            src={clinicScene}
            width={1200}
            height={800}
            widths={[360, 540, 720, 960, 1200]}
            sizes="(min-width: 1365px) 560px, (min-width: 800px) calc(45vw - 54px), (min-width: 592px) 560px, calc(100vw - 32px)"
            format="webp"
            quality={80}
            loading="lazy"
            decoding="async"
            alt="Two Bangladeshi women review doctor, chamber and appointment information on a laptop at home."
            title="Finding and understanding healthcare options from home"
          />
        </div>
      </figure>
    </div>
  </section>
</healthcare-journey>

<style>
  healthcare-journey { display: block; }
  /* This exact top color also finishes the preceding sky-blue section. */
  .journey-section { padding-block: 48px; color: var(--ink); background: var(--journey-lavender-gradient); }
  .journey-layout { display: grid; align-items: center; gap: 28px; }
  .journey-copy { display: grid; gap: 20px; }
  .journey-copy h2 { max-width: 660px; margin: 0; font-size: clamp(28px, 4vw, 38px); font-weight: 650; line-height: 1.24; letter-spacing: -.035em; text-wrap: balance; }
  .journey-copy p { max-width: 660px; margin: 0; font-size: 16px; line-height: 1.75; }
  .journey-steps { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 8px; padding: 0; margin: 2px 0 0; list-style: none; }
  .journey-steps li { display: flex; align-items: center; gap: 8px; max-width: 100%; }
  .journey-step-arrow { flex: none; color: #6131c6; font-size: 18px; line-height: 1; }
  .journey-pill { display: inline-flex; align-items: center; min-height: 36px; padding: 7px 13px; border: 1px solid #6131c62b; border-radius: var(--control-radius); background: #ffffffb8; color: var(--ink); font-size: 13px; font-weight: 600; line-height: 1.5; }
  .journey-steps li:first-child .journey-pill { background: #bae5ff; border-color: #9ac9e8; }
  .journey-steps li:nth-child(4) .journey-pill { background: #fef2cc; border-color: #e2d4a6; }
  .journey-steps li:last-child .journey-pill { background: #e1ffb9; border-color: #b7d992; }
  .journey-photo { width: 100%; max-width: 560px; min-width: 0; margin: 0 auto; }
  .journey-image-frame { aspect-ratio: 3 / 2; overflow: clip; clip-path: inset(0% 0% round 5% 5% 5% 5%); }
  .journey-image-frame img { display: block; width: 100%; height: auto; }
  @media (min-width: 640px) {
    .journey-section { padding-block: 56px; }
    .journey-layout { gap: 32px; }
    .journey-copy { gap: 24px; }
  }
  @media (min-width: 800px) {
    .journey-section { padding-block: 64px; }
    .journey-layout { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 64px; }
    .journey-photo { margin-inline: auto 0; }
  }
</style>
