---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import HealthcareMarketingEntrance from './HealthcareMarketingEntrance.astro';
import Search01Icon from '@hugeicons/core-free-icons/Search01Icon';
import Location01Icon from '@hugeicons/core-free-icons/Location01Icon';
import UserAccountIcon from '@hugeicons/core-free-icons/UserAccountIcon';
import Calendar03Icon from '@hugeicons/core-free-icons/Calendar03Icon';
import CheckmarkCircle02Icon from '@hugeicons/core-free-icons/CheckmarkCircle02Icon';
import ShieldCheckIcon from '@hugeicons/core-free-icons/ShieldCheckIcon';
import Call02Icon from '@hugeicons/core-free-icons/Call02Icon';
import { healthcareMarketingBangladesh as copy } from '../../data/healthcare-marketing-bangladesh';
import background from '../../assets/healthcare-marketing/backgrounds/bangladesh-healthcare-discovery-v1.webp';
import '../../styles/healthcare-marketing-bangladesh.css';
const icons = [Search01Icon, UserAccountIcon, ShieldCheckIcon, Call02Icon];
---
<HealthcareMarketingEntrance class="healthcare-marketing-bangladesh-motion">
  <section id="healthcare-marketing-bangladesh" class="healthcare-marketing-bangladesh" aria-labelledby="healthcare-marketing-bangladesh-heading">
    <div class="healthcare-marketing-bangladesh-background" aria-hidden="true">
      <Image src={background} width={960} widths={[480, 768, 960]} sizes="100vw" format="webp" quality={35}
        alt="" title="Healthcare information search near a Bangladesh clinic district" loading="lazy" decoding="async" />
    </div>
    <div class="section-container healthcare-marketing-bangladesh-layout">
      <div class="healthcare-marketing-bangladesh-header">
        <h2 id="healthcare-marketing-bangladesh-heading">{copy.heading}</h2>
        <p>{copy.introduction}</p>
      </div>
      <div class="healthcare-marketing-bangladesh-path" data-discovery-motion>
        <ol role="list" aria-label="Healthcare information journey in Bangladesh">
          {copy.touchpoints.map((label, index) => <li>
            <span class="healthcare-marketing-bangladesh-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="healthcare-marketing-bangladesh-icon"><Icon icon={icons[index]} size={26} /></span>
            <span class="healthcare-marketing-bangladesh-label">{label}</span>
            {index < copy.touchpoints.length - 1 && <span class="healthcare-marketing-bangladesh-arrow" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" focusable="false"><path d="M2 7h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>}
          </li>)}
        </ol>
      </div>
      <p class="healthcare-marketing-bangladesh-conclusion">{copy.conclusion}</p>
    </div>
  </section>
</HealthcareMarketingEntrance>
