---
import { Image } from 'astro:assets';
import HealthcareMarketingEntrance from './HealthcareMarketingEntrance.astro';
import hridoy from '../../assets/team/founder-hridoy-chowdhury.jpeg';
import monwara from '../../assets/team/monwara-moni-studio-v2.png';
import sirajul from '../../assets/team/sirajul-islam-studio-v2.png';
import { healthcareMarketingSpecialists as copy } from '../../data/healthcare-marketing-specialists';
import '../../styles/healthcare-marketing-specialists.css';

const portraits = [hridoy, monwara, sirajul];
---
<HealthcareMarketingEntrance class="healthcare-marketing-specialists-motion">
  <section id="healthcare-marketing-specialists" class="healthcare-marketing-specialists" aria-labelledby="healthcare-marketing-specialists-heading">
    <div class="section-container healthcare-marketing-specialists-layout">
      <header class="healthcare-marketing-specialists-header" data-discovery-motion>
        <h2 id="healthcare-marketing-specialists-heading">{copy.heading}</h2>
      </header>

      <div class="healthcare-marketing-specialists-list">
        {copy.profiles.map((profile, index) => (
          <article class="healthcare-marketing-specialist" aria-labelledby={`${profile.id}-heading`} data-discovery-motion>
            <Image
              src={portraits[index]}
              alt={profile.alt}
              title={profile.title}
              width={128}
              widths={[64, 96, 128, 192]}
              sizes="(min-width: 1100px) 52px, (min-width: 640px) 64px, 54px"
              format="webp"
              quality={78}
              loading="lazy"
              decoding="async"
            />
            <div class="healthcare-marketing-specialist-copy">
              <h3 id={`${profile.id}-heading`}>
                <span>{profile.name}</span><span class="healthcare-marketing-specialist-separator" aria-hidden="true"> — </span><span>{profile.specialty}</span>
              </h3>
              <p>{profile.description}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="healthcare-marketing-specialists-conclusion">{copy.conclusion}</p>
    </div>
  </section>
</HealthcareMarketingEntrance>
