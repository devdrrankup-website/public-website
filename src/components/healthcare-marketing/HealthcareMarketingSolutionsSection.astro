---
import { Image } from 'astro:assets';
import HealthcareMarketingEntrance from './HealthcareMarketingEntrance.astro';
import Arrow from '../Arrow.astro';
import { healthcareMarketingSolutions as copy } from '../../data/healthcare-marketing-solutions';
import { healthcareMarketingSolutionVisuals as visuals } from '../../data/healthcare-marketing-solution-images';
import '../../styles/healthcare-marketing-solutions.css';
const groupVisuals = [visuals.slice(0, 2), visuals.slice(2, 5), visuals.slice(5)];
---
<section id="healthcare-marketing-solutions" class="healthcare-marketing-solutions" aria-labelledby="healthcare-marketing-solutions-heading">
  <div class="section-container healthcare-marketing-solutions-inner">
    <HealthcareMarketingEntrance>
      <header class="healthcare-marketing-solutions-header" data-discovery-motion>
        <h2 id="healthcare-marketing-solutions-heading">{copy.heading}</h2>
        <p>{copy.introduction}</p>
      </header>
    </HealthcareMarketingEntrance>
    <healthcare-marketing-solutions>
      <div class="healthcare-marketing-solutions-dock">
      <div class="healthcare-marketing-solutions-tabs" role="tablist" aria-label="Healthcare marketing channel categories" hidden>
        {copy.groups.map((group, index) => <button type="button" role="tab" id={`solution-tab-${group.id}`}
          aria-controls={`solution-panel-${group.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>
          <span>{group.heading}</span><span class="healthcare-marketing-solutions-count" aria-hidden="true">{group.services.length}</span>
        </button>)}
      </div>
        <div class="healthcare-marketing-solutions-stage" hidden></div>
      </div>
      <div class="healthcare-marketing-solutions-panels">
        {copy.groups.map((group, index) => <div id={`solution-panel-${group.id}`} class:list={['healthcare-marketing-solution-panel', { 'is-initially-hidden': index !== 0 }]} data-solution-panel>
          <p class="healthcare-marketing-solutions-group-heading">{group.heading}</p>
          <dl class="healthcare-marketing-solution-list">
            {group.services.map((service, serviceIndex) => <div class="healthcare-marketing-solution-row" data-service={groupVisuals[index][serviceIndex].key}>
              <dt>
                <span class="healthcare-marketing-solution-number" aria-hidden="true">{String(serviceIndex + 1).padStart(2, '0')}</span>
                <span class="healthcare-marketing-solution-reveal" aria-hidden="true"></span>
                <h3 class="healthcare-marketing-solution-name">{service.heading}</h3>
                <span class="healthcare-marketing-solution-arrow" aria-hidden="true"><Arrow /></span>
              </dt>
              <dd><p class="healthcare-marketing-solution-description">{service.segments.map((segment) => typeof segment === 'string' ? segment : <a href={segment.href}>{segment.label}</a>)}</p>
                <figure class="healthcare-marketing-solution-photo">
                  <Image src={groupVisuals[index][serviceIndex].src} width={960} widths={[360, 640, 960]}
                    sizes="(min-width: 1280px) 1152px, calc(100vw - 80px)"
                    format="webp" quality={75} alt={groupVisuals[index][serviceIndex].alt} title={groupVisuals[index][serviceIndex].alt} loading="lazy" decoding="async" />
                  <figcaption>{service.heading}</figcaption>
                </figure>
              </dd>
            </div>)}
          </dl>
        </div>)}
      </div>
    </healthcare-marketing-solutions>
  </div>
</section>
<noscript><style is:inline>
  #healthcare-marketing-solutions .healthcare-marketing-solution-panel.is-initially-hidden { display: block; }
</style></noscript>
<script>import '../../scripts/healthcare-marketing-solutions';</script>
