---
import HospitalEntrance from './HospitalEntrance.astro';
import { hospitalWhy as copy } from '../../data/for-hospital-why';
import '../../styles/hospital-why.css';
---
<HospitalEntrance class="hospital-why-motion">
  <section id="hospital-why" class="hospital-why" aria-labelledby="hospital-why-heading">
    <div class="hospital-why-glow" aria-hidden="true"></div>
    <div class="section-container hospital-why-layout">
      <header class="hospital-why-header" data-discovery-motion>
        <span class="hospital-why-range" aria-hidden="true">01—05</span>
        <h2 id="hospital-why-heading">{copy.heading}</h2>
        <a class="button button-secondary" href="/about/">About Dr RankUP</a>
      </header>

      <div class="hospital-why-principles">
        {copy.principles.map((principle, index) => (
          <article class="hospital-why-principle" aria-labelledby={`hospital-why-principle-${index + 1}`} data-discovery-motion>
            <span class="hospital-why-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 id={`hospital-why-principle-${index + 1}`}>{principle.title}</h3>
              <p>{principle.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</HospitalEntrance>
