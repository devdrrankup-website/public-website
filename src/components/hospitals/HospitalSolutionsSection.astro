---
import { Image } from 'astro:assets';
import HospitalEntrance from './HospitalEntrance.astro';
import ActionIcon from '../ActionIcon.astro';
import Arrow from '../Arrow.astro';
import { hospitalSolutions as copy } from '../../data/for-hospital-solutions';
import { hospitalSolutionVisuals as visuals } from '../../data/for-hospital-solution-images';
import { serviceRoutes } from '../../data/service-routes';
import '../../styles/hospital-solutions.css';
let visualOffset = 0;
const groupVisuals = copy.groups.map(group => { const groupImages = visuals.slice(visualOffset, visualOffset + group.services.length); visualOffset += group.services.length; return groupImages; });
const groupRoutes = ['/hospitals/digital-marketing/', '/hospitals/website-development/', '/hospitals/management-software/'];
---
<section id="hospital-solutions" class="hospital-solutions" aria-labelledby="hospital-solutions-heading">
  <div class="section-container hospital-solutions-inner">
    <HospitalEntrance>
      <header class="hospital-solutions-header" data-discovery-motion>
        <h2 id="hospital-solutions-heading">{copy.heading}</h2>
        <p>{copy.introduction}</p>
      </header>
    </HospitalEntrance>
    <hospital-solutions>
      <div class="hospital-solutions-dock">
      <div class="hospital-solutions-tabs" role="tablist" aria-label="Hospital solution categories" hidden>
        {copy.groups.map((group, index) => <button type="button" role="tab" id={`solution-tab-${group.id}`}
          aria-controls={`solution-panel-${group.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>
          <span>{group.heading}</span><span class="hospital-solutions-count" aria-hidden="true">{group.services.length}</span>
        </button>)}
      </div>
        <div class="hospital-solutions-stage" hidden></div>
      </div>
      <div class="hospital-solutions-panels">
        {copy.groups.map((group, index) => <div id={`solution-panel-${group.id}`} class:list={['hospital-solution-panel', { 'is-initially-hidden': index !== 0 }]} data-solution-panel>
          <h3 id={`solution-heading-${group.id}`}>{group.heading}</h3>{group.lead && <p class="hospital-solution-lead">{group.lead}</p>}
          <dl class="hospital-solution-list">
            {group.services.map(([name, description], serviceIndex) => <div class="hospital-solution-row" data-service={groupVisuals[index][serviceIndex].key}>
              <dt>
                <span class="hospital-solution-number" aria-hidden="true">{String(serviceIndex + 1).padStart(2, '0')}</span>
                <span class="hospital-solution-reveal" aria-hidden="true"></span>
                {serviceRoutes[groupVisuals[index][serviceIndex].key]
                  ? <a class="hospital-solution-name" href={serviceRoutes[groupVisuals[index][serviceIndex].key]}>{name}</a>
                  : <span class="hospital-solution-name">{name}</span>}
                <span class="hospital-solution-arrow" aria-hidden="true"><Arrow /></span>
              </dt>
              <dd><span class="hospital-solution-description">{description}</span>
                <figure class="hospital-solution-photo">
                  <Image src={groupVisuals[index][serviceIndex].src} width={960} widths={[360, 640, 960]}
                    sizes="(min-width: 1280px) 1152px, calc(100vw - 80px)"
                    format="webp" quality={75} alt={groupVisuals[index][serviceIndex].alt} title={groupVisuals[index][serviceIndex].alt} loading="lazy" decoding="async" />
                  <figcaption>{name}</figcaption>
                </figure>
              </dd>
            </div>)}
          </dl>
          <a class="hospital-solution-cta" href={groupRoutes[index]}>{group.cta}<ActionIcon purpose="conversation" /></a>
        </div>)}
      </div>
    </hospital-solutions>
  </div>
</section>
<noscript><style is:inline>
  #hospital-solutions .hospital-solution-panel.is-initially-hidden { display: block; }
</style></noscript>
<script>import '../../scripts/hospital-solutions';</script>
