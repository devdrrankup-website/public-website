---
import ClinicEntrance from './ClinicEntrance.astro';
import { clinicWhy as copy } from '../../data/for-clinic-why';
import '../../styles/clinic-why.css';
---
<ClinicEntrance class="clinic-why-motion">
  <section id="clinic-why" class="clinic-why" aria-labelledby="clinic-why-heading">
    <div class="clinic-why-glow" aria-hidden="true"></div>
    <div class="section-container clinic-why-layout">
      <header class="clinic-why-header" data-discovery-motion>
        <span class="clinic-why-range" aria-hidden="true">01—05</span>
        <h2 id="clinic-why-heading">{copy.heading}</h2>
        <a class="button button-secondary" href="/about/">About Dr RankUP</a>
      </header>

      <div class="clinic-why-principles">
        {copy.principles.map((principle, index) => (
          <article class="clinic-why-principle" aria-labelledby={`clinic-why-principle-${index + 1}`} data-discovery-motion>
            <span class="clinic-why-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 id={`clinic-why-principle-${index + 1}`}>{principle.title}</h3>
              <p>{principle.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</ClinicEntrance>
