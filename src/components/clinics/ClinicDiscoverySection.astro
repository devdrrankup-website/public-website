---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import ClinicEntrance from './ClinicEntrance.astro';
import Search01Icon from '@hugeicons/core-free-icons/Search01Icon';
import UserAccountIcon from '@hugeicons/core-free-icons/UserAccountIcon';
import ShieldCheckIcon from '@hugeicons/core-free-icons/ShieldCheckIcon';
import Calendar03Icon from '@hugeicons/core-free-icons/Calendar03Icon';
import photo from '../../assets/audience-hubs/clinic-discovery-v1.webp';
import { clinicDiscovery as copy } from '../../data/for-clinic-discovery';
import '../../styles/clinic-discovery.css';
const icons = [Search01Icon, UserAccountIcon, ShieldCheckIcon, Calendar03Icon];
---
<ClinicEntrance class="clinic-discovery">
  <section class="section-container" aria-labelledby="clinic-discovery-heading">
    <h2 id="clinic-discovery-heading">{copy.heading}</h2>
    <div class="clinic-discovery-editorial">
      <div class="clinic-discovery-copy">
        {copy.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        <div class="clinic-discovery-journey">
          {copy.goal && <p>{copy.goal}</p>}
          <ol aria-label="Patient discovery journey">
            {copy.journey.map((label, index) => <li>
              <span class="clinic-discovery-chip">{label}</span>
              {index < copy.journey.length - 1 && <span class="clinic-discovery-journey-arrow" aria-hidden="true">→</span>}
            </li>)}
          </ol>
        </div>
      </div>
      <div class="clinic-discovery-photo" data-discovery-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} sizes="(min-width: 1100px) min(43vw, 640px), (min-width: 640px) calc(100vw - 56px), calc(100vw - 32px)"
          format="webp" quality={78} width={1536} height={1024}
          alt="Person at home researching clinic information online in Bangladesh"
          title="Researching clinic information from home" loading="lazy" decoding="async" />
      </div>
    </div>
    <ol class="clinic-discovery-stages" aria-label="Four parts of a clear clinic presence">
      {copy.stages.map((stage, index) => <li data-discovery-motion>
        <div class="clinic-discovery-stage-marker"><span class="clinic-discovery-stage-icon"><Icon icon={icons[index]} size={25} /></span><span class="clinic-discovery-stage-number" aria-hidden="true">0{index + 1}</span></div>
        <div class="clinic-discovery-stage-copy"><h3>{stage.heading}</h3><p>{stage.description}</p></div>
      </li>)}
    </ol>
  </section>
</ClinicEntrance>
