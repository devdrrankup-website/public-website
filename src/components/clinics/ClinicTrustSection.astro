---
import {Image} from 'astro:assets';
import Icon from '../Icon.astro';
import ClinicEntrance from './ClinicEntrance.astro';
import UserAccountIcon from '@hugeicons/core-free-icons/UserAccountIcon';
import ShieldCheckIcon from '@hugeicons/core-free-icons/ShieldCheckIcon';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import Calendar03Icon from '@hugeicons/core-free-icons/Calendar03Icon';
import photo from '../../assets/audience-hubs/clinic-trust-v1.webp';
import {clinicTrust as copy} from '../../data/for-clinic-trust';
import '../../styles/clinic-trust.css';
const icons=[UserAccountIcon,ShieldCheckIcon,LockKeyIcon,Calendar03Icon];

---
<ClinicEntrance class="clinic-trust-motion">
  <section id="clinic-trust" class="clinic-trust" aria-labelledby="clinic-trust-heading">
    <div class="section-container">
      <header class="clinic-trust-header">
        <h2 id="clinic-trust-heading">{copy.heading}</h2>
        {copy.introduction && <p>{copy.introduction}</p>}
      </header>
      <div class="clinic-trust-layout">
        <div class="clinic-trust-visual">
          <figure class="clinic-trust-photo" data-discovery-motion>
            <Image src={photo} width={1536} height={1024} widths={[360,540,720,960,1200]}
              sizes="(min-width: 1100px) min(43vw, 640px), (min-width: 640px) 640px, calc(100vw - 32px)"
              format="webp" quality={78} loading="lazy" decoding="async"
              alt="Clinic and healthcare content specialist reviewing educational material in a chamber"
              title="Clinical content review in a clinic's chamber" />
          </figure>
        </div>
        <div class="clinic-trust-principles">
          {copy.principles.map((item,index)=><article class="clinic-trust-principle" aria-labelledby={`clinic-trust-principle-${index}`} data-discovery-motion>
            <span class="clinic-trust-icon"><Icon icon={icons[index]} size={26} /></span>
            <div><h3 id={`clinic-trust-principle-${index}`}>{item.heading}</h3>{item.paragraphs.map(paragraph=><p>{paragraph}</p>)}</div>
          </article>)}
        </div>
      </div>
      {copy.conclusion && <p class="clinic-trust-conclusion">{copy.conclusion}</p>}
    </div>
  </section>
</ClinicEntrance>
