---
import { Image } from 'astro:assets';
import { doctorProcess as copy } from '../../data/for-doctors-process';
import processBackground from '../../assets/for-doctors/doctor-process-workshop-background-v1.webp';
import '../../styles/doctor-process.css';
---

<doctor-process class="doctor-process-motion">
  <section id="doctor-process" class="doctor-process" aria-labelledby="doctor-process-heading">
    <div class="doctor-process-background" aria-hidden="true">
      <Image src={processBackground} width={1600} widths={[480, 768, 1024, 1600]} sizes="100vw" format="webp" quality={55}
        alt="" title="Doctor and digital team reviewing a healthcare growth workflow" loading="lazy" decoding="async" />
    </div>
    <div class="doctor-process-atmosphere" aria-hidden="true"></div>
    <div class="section-container doctor-process-layout">
      <header class="doctor-process-header" data-process-copy>
        <span class="doctor-process-range" aria-hidden="true">01—06</span>
        <h2 id="doctor-process-heading">{copy.heading}</h2>
      </header>

      <div class="doctor-process-flow" role="list" aria-label="Dr RankUP's six-step process">
        <svg class="doctor-process-route" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="doctor-process-route-gradient" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="100" y2="100">
              <stop offset="0" stop-color="#6131c6" />
              <stop offset="0.5" stop-color="#229f60" />
              <stop offset="1" stop-color="#6131c6" />
            </linearGradient>
          </defs>
          <path class="doctor-process-route-base" d="M 16.667 12 H 50 H 83.333 H 98 V 58 H 83.333 H 50 H 16.667" />
          <g class="doctor-process-route-progress">
            <line class="doctor-process-route-horizontal" x1="16.667" y1="12" x2="50" y2="12" />
            <line class="doctor-process-route-horizontal" x1="50" y1="12" x2="83.333" y2="12" />
            <line class="doctor-process-route-horizontal" x1="83.333" y1="12" x2="98" y2="12" />
            <line class="doctor-process-route-vertical" x1="98" y1="12" x2="98" y2="58" />
            <line class="doctor-process-route-horizontal doctor-process-route-reverse" x1="98" y1="58" x2="83.333" y2="58" />
            <line class="doctor-process-route-horizontal doctor-process-route-reverse" x1="83.333" y1="58" x2="50" y2="58" />
            <line class="doctor-process-route-horizontal doctor-process-route-reverse" x1="50" y1="58" x2="16.667" y2="58" />
          </g>
        </svg>

        {copy.steps.map((step, index) => (
          <div class="doctor-process-step" role="listitem" data-process-step style={`--process-index:${index}`}>
            <div class="doctor-process-node-column" aria-hidden="true">
              <span class="doctor-process-node"><span>{step.number}</span></span>
              {index < copy.steps.length - 1 && <span class="doctor-process-connector"></span>}
            </div>
            <div class="doctor-process-copy" data-process-copy>
              <h3><span>{step.number} — </span>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</doctor-process>

<script>
  import '../../scripts/doctor-process';
</script>
