---
import { Image } from 'astro:assets';
import Icon from '../../Icon.astro';
import LockKeyIcon from '@hugeicons/core-free-icons/LockKeyIcon';
import photo from '../../../assets/doctor-seo/clinical-review-doctor-seo-v1.webp';
import { doctorSeoTrust as copy } from '../../../data/doctor-seo-trust';
import '../../../styles/doctor-seo-trust.css';
---

<doctor-seo-trust class="doctor-seo-trust-motion">
  <section id="doctor-seo-trust" class="doctor-seo-trust" aria-labelledby="doctor-seo-trust-heading">
    <div class="section-container doctor-seo-trust-layout">
      <h2 id="doctor-seo-trust-heading">{copy.heading}</h2>
      <p class="doctor-seo-trust-profile" data-seo-trust-motion>{copy.paragraphs[0]}</p>
      <div class="doctor-seo-trust-photo" data-seo-trust-motion>
        <Image src={photo} widths={[360, 540, 720, 960, 1200]} width={1536} height={1024}
          sizes="(min-width: 1100px) min(43vw, 576px), (min-width: 640px) min(calc(100vw - 56px), 760px), calc(100vw - 32px)"
          format="webp" quality={76} loading="lazy" decoding="async"
          alt="Doctor and content editor reviewing printed health information in a chamber"
          title="Reviewing patient education content with a doctor" />
      </div>
      <div class="doctor-seo-trust-privacy" data-seo-trust-motion>
        <span class="doctor-seo-trust-lock" aria-hidden="true"><Icon icon={LockKeyIcon} size={24} /></span>
        <p>{copy.paragraphs[1]}</p>
      </div>
    </div>
  </section>
</doctor-seo-trust>

<script>
  import '../../../scripts/doctor-seo-trust';
</script>
