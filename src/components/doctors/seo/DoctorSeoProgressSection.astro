---
import { Image } from 'astro:assets';
import photo from '../../../assets/doctor-seo/progress/hridoy-search-review-v2.webp';
import { doctorSeoProgress as copy } from '../../../data/doctor-seo-progress';
import '../../../styles/doctor-seo-progress.css';
---
<doctor-seo-progress class="doctor-seo-progress-motion">
  <section id="doctor-seo-progress" class="doctor-seo-progress" aria-labelledby="doctor-seo-progress-heading">
    <div class="section-container doctor-seo-progress-layout">
      <h2 id="doctor-seo-progress-heading" data-progress-entry>{copy.heading}</h2>
      <p class="doctor-seo-progress-baseline" data-progress-entry>{copy.paragraphs[0]}</p>
      <figure class="doctor-seo-progress-photo" data-progress-entry data-progress-photo>
        <Image src={photo} alt="Hridoy Chowdhury reviewing search and website reports at an agency workstation" title="Hridoy Chowdhury reviewing search and website reports at an agency workstation" width={960} widths={[360,640,960]} sizes="(min-width:1100px) 640px, (min-width:640px) 50vw, calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" />
      </figure>
      <p class="doctor-seo-progress-evidence" data-progress-entry>{copy.paragraphs[1]}</p>
    </div>
  </section>
</doctor-seo-progress>
<script>
  import '../../../scripts/doctor-seo-progress';
</script>
