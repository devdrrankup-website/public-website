---
import {Image} from 'astro:assets';
import Arrow from './Arrow.astro';
import Icon from './Icon.astro';
import ArrowDown01Icon from '@hugeicons/core-free-icons/ArrowDown01Icon';
import {navigationVisuals,type NavigationMenu} from '../data/navigation';
interface Props {menu:NavigationMenu}
const {menu}=Astro.props;
const entries=menu.groups.flatMap(group=>group.items);
const key=(index:number)=>`nav-${menu.id}-preview-${index}`;
let entryIndex=0;
---
<details class="nav-menu" data-nav-menu>
  <summary class="nav-menu-summary">{menu.title}<Icon icon={ArrowDown01Icon} size={15}/></summary>
  <div class="mega-panel" role="region" aria-label={`${menu.title} menu`}>
    <div class="mega-content">
      <div class="mega-catalogue">
        <p class="mega-description">{menu.description}</p>
        <div class="mega-groups">
          {menu.groups.map(group=><details class="mega-category" open={menu.groups.length===1}>
            <summary class="mega-category-summary">
              <span class="mega-category-heading"><strong>{group.title}</strong></span>
              <span class="mega-category-control" aria-hidden="true"></span>
            </summary>
            <ul class="mega-services">
              {group.items.map(item=>{
                const index=entryIndex++;
                return <li class="mega-service" data-preview={key(index)}>
                  <span class="nav-preview-label" data-preview-label>
                    <span><strong>{item.title}</strong></span><Arrow size={17}/>
                  </span>
                </li>;
              })}
            </ul>
          </details>)}
        </div>
        <div class="mega-view-all"><span data-view-all-label>{menu.viewAll}<Arrow size={17}/></span></div>
      </div>
      <div class="mega-preview" role="group" aria-label={`${menu.title} image previews`}>
        <div class="mega-preview-stage">
          {entries.map((item,index)=>{
            const visual=navigationVisuals[item.visual];
            return <figure id={key(index)} class="mega-preview-figure" hidden={index!==0}>
              <div class="mega-preview-image">
                <Image src={visual.src} width={960} widths={[320,640,960]} sizes="(min-width: 1100px) 560px, (min-width: 640px) 500px, calc(100vw - 80px)"
                  format="webp" quality={76} alt={visual.alt} title={`${item.title} — Dr RankUP`} loading="lazy" decoding="async"/>
              </div>
              <figcaption><strong>{item.title}</strong><span>{item.description}</span></figcaption>
            </figure>;
          })}
        </div>
        <div class="mega-contact">
          <p>Let’s talk healthcare growth</p>
          <div><span class="mega-phone">01342114762</span><span class="mega-contact-label">contact@drrankup.com</span></div>
          <small>Doctors · Clinics · Hospitals · Bangladesh</small>
        </div>
      </div>
    </div>
  </div>
</details>
