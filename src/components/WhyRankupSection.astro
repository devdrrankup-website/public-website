---
import {Image} from 'astro:assets';
import brand from '../../public/brand/dr-rankup-icon.png';
import Icon from './Icon.astro';
import Tick02Icon from '@hugeicons/core-free-icons/Tick02Icon';
import Briefcase01Icon from '@hugeicons/core-free-icons/Briefcase01Icon';
import UserGroupIcon from '@hugeicons/core-free-icons/UserGroupIcon';
import UserIcon from '@hugeicons/core-free-icons/UserIcon';
import ComputerIcon from '@hugeicons/core-free-icons/ComputerIcon';
import {homepageWhy as content} from '../data/homepage-why';
const icons=[Briefcase01Icon,UserGroupIcon,UserIcon,ComputerIcon];
---
<why-rankup>
  <section id="why-dr-rankup" class="why-section" aria-labelledby="why-heading">
    <div class="section-container why-container">
      <header class="why-introduction">
        <h2 id="why-heading">Why <em>Dr RankUP</em></h2>
      </header>
      <p class="why-swipe" id="why-scroll-help">Swipe to compare all five areas</p>
      <div class="why-comparison-scroll" role="region" aria-label="Dr RankUP and alternative delivery models" aria-describedby="why-scroll-help why-context" tabindex="0">
        <table class="why-comparison">
          <caption class="sr-only">{content.heading}: how delivery models approach healthcare growth and technology</caption>
          <colgroup><col class="why-platform-column"/>{content.criteria.map(()=> <col/>)}</colgroup>
          <thead>
            <tr>
              <th scope="col">Approach</th>
              {content.criteria.map(criterion=><th scope="col"><h3>{criterion.heading}</h3></th>)}
            </tr>
          </thead>
          <tbody>
            <tr class="why-featured" data-why-row>
              <th scope="row">
                <div class="why-platform">
                  <span class="why-brand-icon"><Image src={brand} alt="" title="Dr RankUP brand icon" width={80} height={80} widths={[80,160,240]} sizes="(min-width: 1100px) 64px, 56px" format="webp" loading="lazy" decoding="async"/></span>
                  <div><strong>Dr RankUP</strong><p>{content.brandDescription}</p></div>
                </div>
              </th>
              {content.criteria.map(criterion=>(
                <td><Icon icon={Tick02Icon} size={32} strokeWidth={1.8}/><span class="sr-only">Included in our approach. </span><p class="why-criterion-description">{criterion.description}</p></td>
              ))}
            </tr>
            {content.alternatives.map((alternative,index)=>(
              <tr data-why-row>
                <th scope="row">
                  <div class="why-platform">
                    <span class="why-platform-icon"><Icon icon={icons[index]} size={30} strokeWidth={1.8}/></span>
                    <div><strong>{alternative.name}</strong><p>{alternative.description}</p></div>
                  </div>
                </th>
                {alternative.coverage.map(value=><td><span class="why-coverage">{value}</span></td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="why-context" id="why-context">{content.context}</p>
    </div>
  </section>
</why-rankup>

<style>
  why-rankup { display: block; background: #fff; }
  .why-section { --why-top-space: 56px; padding-block: var(--why-top-space) 56px; border-radius: 28px 28px 0 0; color: #fff; background: radial-gradient(ellipse at 50% 0%,#229f6040 0%,#229f6000 58%),linear-gradient(145deg,#0b1b12 0%,#0a0a0a 60%,#0c1b13 100%); }
  .why-container { max-width: 1250px; }
  .why-introduction { display: grid; justify-items: center; gap: 20px; text-align: center; }
  .why-introduction h2 { margin: 0; font-size: clamp(32px,4vw,50px); font-weight: 650; line-height: 1.25; letter-spacing: -.035em; text-wrap: balance; }
  .why-introduction em { font-family: Georgia,'Times New Roman',serif; font-style: italic; font-weight: 600; }
  .why-swipe { margin: 32px 0 12px; color: #c6d8ce; font-size: 12px; line-height: 1.5; text-align: right; }
  /* Reserve the entrance's 16px travel so it cannot create a nested vertical scroller. */
  .why-comparison-scroll { position: relative; max-width: 100%; overflow-x: auto; overflow-y: hidden; padding-bottom: 16px; scrollbar-width: thin; scrollbar-color: #63df9d #102019; border-radius: 4px; }
  .why-comparison-scroll:focus-visible { outline: 2px solid #bae5ff; outline-offset: 5px; }
  .why-comparison { width: 100%; min-width: 940px; table-layout: fixed; border-collapse: separate; border-spacing: 0; }
  .why-platform-column { width: 260px; }
  .why-comparison th { font-weight: 500; }
  .why-comparison thead th { padding: 0 12px 28px; vertical-align: middle; text-align: center; }
  .why-comparison thead th:first-child { padding-left: 24px; text-align: left; }
  .why-comparison h3 { margin: 0; font-size: 14px; font-weight: 600; line-height: 1.5; }
  .why-comparison tbody th,.why-comparison tbody td { padding: 28px 12px; border-bottom: 1px solid #ffffff1f; vertical-align: middle; }
  .why-comparison tbody th { padding-left: 24px; text-align: left; }
  .why-comparison tbody td { text-align: center; }
  .why-featured { background: radial-gradient(ellipse at 0% 100%,#229f6033,transparent 45%),linear-gradient(110deg,#10251b,#0b1711 55%,#153827); }
  .why-comparison .why-featured th,.why-comparison .why-featured td { border-top: 1px solid #63df9d; border-bottom: 1px solid #229f60; }
  .why-comparison .why-featured td { vertical-align: top; }
  .why-featured th:first-child { border-left: 1px solid #63df9d; border-radius: 28px 0 0 28px; }
  .why-featured td:last-child { border-right: 1px solid #63df9d; border-radius: 0 28px 28px 0; }
  .why-platform { display: flex; align-items: center; gap: 16px; }
  .why-platform strong { display: block; font-size: 18px; font-weight: 650; line-height: 1.4; letter-spacing: -.025em; }
  .why-platform p { margin: 10px 0 0; color: #d1dcd6; font-size: 14px; font-weight: 400; line-height: 1.75; }
  .why-brand-icon,.why-platform-icon { display: grid; place-items: center; flex-shrink: 0; width: 56px; height: 56px; border-radius: 14px; }
  .why-brand-icon { background: #fff; border: 1px solid #bae5ff; box-shadow: 0 0 24px #229f6033; }
  .why-brand-icon img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .why-platform-icon { color: #bae5ff; background: #102a35; border: 1px solid #bae5ff26; }
  .why-platform { align-items: flex-start; }
  .why-criterion-description { margin: 12px 0 0; color: #dce8e0; font-size: 12px; line-height: 1.75; }
  .why-coverage { display: inline-block; max-width: 100%; color: #d1dcd6; font-size: 13px; line-height: 1.6; }
  .why-context { margin: 20px 0 0; color: #b8cdc1; font-size: 12px; line-height: 1.7; }
  @media (min-width: 640px) {
    .why-section { --why-top-space: 72px; padding-bottom: 72px; border-radius: 36px 36px 0 0; }
    .why-swipe { margin-top: 40px; }
    .why-platform-column { width: 310px; }
  }
  @media (min-width: 1100px) {
    .why-section { --why-top-space: 88px; padding-bottom: 88px; }
    .why-swipe { display: none; }
    .why-comparison-scroll { margin-top: 48px; }
    .why-comparison { min-width: 0; }
    .why-comparison h3 { font-size: 16px; }
    .why-platform-column { width: 37%; }
    .why-comparison thead th { padding-bottom: 32px; }
    .why-comparison tbody th,.why-comparison tbody td { padding-block: 32px; }
    .why-comparison tbody th { padding-left: 32px; padding-right: 24px; }
    .why-platform { align-items: center; gap: 20px; }
    .why-platform strong { font-size: 22px; }
    .why-platform p { font-size: 15px; }
    .why-brand-icon,.why-platform-icon { width: 64px; height: 64px; border-radius: 16px; }
    .why-criterion-description { font-size: 13px; }
    .why-context { font-size: 13px; }
  }
  @media (min-width: 900px) {
    .why-section { border-radius: 40px 40px 0 0; }
  }
</style>
