---
import {Image} from 'astro:assets';
import CheckmarkCircle02Icon from '@hugeicons/core-free-icons/CheckmarkCircle02Icon';
import ArrowRight02Icon from '@hugeicons/core-free-icons/ArrowRight02Icon';
import hridoy from '../assets/team/founder-hridoy-chowdhury.jpeg';
import Icon from './Icon.astro';
import Arrow from './Arrow.astro';
import {homepageConsultation as content} from '../data/homepage-consultation';
import {forDoctorsConsultation} from '../data/for-doctors-consultation';
import {homepageSearchExpertise as expertise} from '../data/homepage-search-expertise';

interface Props { page?: 'homepage' | 'for-doctors' }
const {page = 'homepage'} = Astro.props;
const isDoctors = page === 'for-doctors';
const sectionId = isDoctors ? 'doctor-consultation' : 'consultation';
const headingId = `${sectionId}-heading`;
const primary = isDoctors ? forDoctorsConsultation.primary : content.primary;
const secondary = isDoctors ? forDoctorsConsultation.secondary : content.secondary;
---
<consultation-motion class:list={{'consultation-motion-doctors': isDoctors}}>
  <section id={sectionId} class:list={['consultation-section', {'consultation-doctors': isDoctors}]} aria-labelledby={headingId}>
    <div class="section-container consultation-grid">
      <div class="consultation-copy">
        <header class="consultation-introduction">
          {isDoctors ? (
            <>
              <h2 id={headingId}>Your Expertise Deserves a Digital Presence People and Search Systems Can <em>Understand</em></h2>
              <div class="consultation-doctor-description">
                {forDoctorsConsultation.paragraphs.map(paragraph => <p>{paragraph}</p>)}
              </div>
            </>
          ) : (
            <>
              <h2 id={headingId}>Your Expertise Deserves to Be <em>Discoverable</em></h2>
              <ul class="consultation-principles">
                {content.principles.map(principle => <li><Icon icon={CheckmarkCircle02Icon} size={21} /><span>{principle}</span></li>)}
              </ul>
              <p class="consultation-lead">{content.lead}</p>
              <ol class="consultation-journey" aria-label="Your digital presence journey">
                {content.journey.map((step,index) => <li>
                  <span class="consultation-journey-pill">{step}</span>
                  {index < content.journey.length - 1 && <span class="consultation-journey-arrow" aria-hidden="true">→</span>}
                </li>)}
              </ol>
              <p class="consultation-description">{content.description}</p>
            </>
          )}
        </header>
        <div class="consultation-contact">
          <div class="consultation-portrait">
            <Image src={hridoy} widths={[240,360,480]} sizes="(min-width: 640px) 220px, 180px" format="webp" quality={80}
              alt="Hridoy Chowdhury, Founder and SEO Consultant at Dr RankUP" title="Hridoy Chowdhury — Dr RankUP consultation"
              loading="lazy" decoding="async" />
          </div>
          <h3>{expertise.founder}</h3>
          <p>{expertise.role}, Dr RankUP</p>
          <span class="consultation-link">{primary}<Arrow size={18} /></span>
          {isDoctors
            ? <span class="consultation-solutions">{secondary}<Arrow size={18} /></span>
            : <a class="consultation-solutions" href="/healthcare-marketing/">{secondary}<Arrow size={18} /></a>}
        </div>
      </div>
      <healthcare-enquiry>
        <form class="consultation-form" aria-label={isDoctors ? 'Doctor consultation enquiry' : 'Healthcare consultation enquiry'} method="post" action={`#${sectionId}`}>
          <div class="consultation-field">
            <label for="enquiry-name">Full Name<span aria-hidden="true">*</span><span class="sr-only"> (required)</span></label>
            <input id="enquiry-name" name="name" autocomplete="name" placeholder="Your full name" maxlength="100" required />
          </div>
          <div class="consultation-field-pair">
            <div class="consultation-field">
              <label for="enquiry-email">Your Email <span class="consultation-optional">(optional)</span></label>
              <input id="enquiry-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" maxlength="254" />
            </div>
            <div class="consultation-field">
              <label for="enquiry-phone">Phone Number<span aria-hidden="true">*</span><span class="sr-only"> (required)</span></label>
              <input id="enquiry-phone" name="phone" type="tel" autocomplete="tel" placeholder="+880 1XXX XXXXXX" maxlength="30" required />
            </div>
          </div>
          <fieldset class="consultation-organization">
            <legend>I’m enquiring for <span>(optional)</span></legend>
            <div class="consultation-organization-options">
              {content.organizations.map((organization,index) => <label class="consultation-organization-option" for={`enquiry-organization-${index}`}>
                <input id={`enquiry-organization-${index}`} type="radio" name="organization" value={organization} />
                <span>{organization}</span>
              </label>)}
            </div>
          </fieldset>
          <div class="consultation-field">
            <label for="enquiry-details">Project Details<span aria-hidden="true">*</span><span class="sr-only"> (required)</span></label>
            <textarea id="enquiry-details" name="details" rows="4" placeholder="Tell us about your organization and what you’d like to improve…" maxlength="4000" aria-describedby="enquiry-details-hint" required></textarea>
            <p id="enquiry-details-hint" class="consultation-hint">Please share business needs only, without patient or medical information.</p>
          </div>
          <button class="consultation-submit" type="submit" disabled>Send enquiry <Icon icon={ArrowRight02Icon} size={24} /></button>
          <p class="consultation-status" role="status" aria-live="polite" aria-atomic="true"></p>
          <noscript><p class="consultation-hint">This form is a preview. Enquiries cannot be sent yet.</p></noscript>
        </form>
      </healthcare-enquiry>
    </div>
  </section>
</consultation-motion>

<style>
  consultation-motion { display: block; padding-top: 8px; background: #fff; }
  consultation-motion.consultation-motion-doctors { padding-top: 0; background: #f2f1fb; }
  .consultation-section { padding-block: 40px; border-radius: 28px 28px 0 0; color: #fff; background: radial-gradient(ellipse at 100% 0%,#229f606b,transparent 58%),#0a0a0a; }
  .consultation-grid { display: grid; gap: 48px; max-width: 1250px; }
  .consultation-copy { min-width: 0; }
  .consultation-introduction h2 { max-width: 550px; margin: 0 0 24px; font-size: clamp(32px,3.7vw,48px); font-weight: 650; line-height: 1.2; letter-spacing: -.035em; text-wrap: balance; }
  .consultation-introduction h2 em { font-family: Georgia,serif; font-weight: 400; }
  .consultation-lead { margin: 20px 0 12px; color: #e5ece9; font-size: 15px; line-height: 1.7; }
  .consultation-journey { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .consultation-journey li { --pill-accent: #bae5ff; --pill-border: #bae5ff70; --pill-surface: #bae5ff14; display: inline-flex; align-items: center; gap: 10px; max-width: 100%; }
  .consultation-journey li:nth-child(2) { --pill-accent: #eeedfe; --pill-border: #afa9ec99; --pill-surface: #afa9ec1f; }
  .consultation-journey li:nth-child(3) { --pill-accent: #eddafa; --pill-border: #eddafa70; --pill-surface: #eddafa14; }
  .consultation-journey li:nth-child(4) { --pill-accent: #fef2cc; --pill-border: #fef2cc70; --pill-surface: #fef2cc14; }
  .consultation-journey-pill { display: inline-flex; align-items: center; min-height: 36px; padding: 7px 12px; border: 1px solid var(--pill-border); border-radius: var(--control-radius); background: var(--pill-surface); color: var(--pill-accent); font-size: 12px; font-weight: 600; line-height: 1.5; }
  .consultation-journey-arrow { flex-shrink: 0; color: #bdcbc5; font-size: 16px; }
  .consultation-principles { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .consultation-principles li { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 550; line-height: 1.5; }
  .consultation-principles :global(svg) { color: #e1ffb9; }
  .consultation-description { max-width: 510px; margin: 20px 0 0; color: #bdcbc5; font-size: 14px; line-height: 1.8; }
  .consultation-doctor-description { display: grid; gap: 16px; max-width: 540px; }
  .consultation-doctor-description p { margin: 0; color: #dce5e0; font-size: 15px; line-height: 1.8; }
  .consultation-contact { margin-top: 32px; }
  .consultation-portrait { width: 180px; aspect-ratio: 1; overflow: clip; border-radius: 20px; background: #eeedfe; }
  .consultation-portrait img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .consultation-contact h3 { margin: 14px 0 4px; font-size: 23px; font-weight: 650; line-height: 1.3; letter-spacing: -.025em; }
  .consultation-contact > p { margin: 0 0 10px; color: #bdcbc5; font-size: 14px; line-height: 1.7; }
  .consultation-link,.consultation-solutions { display: flex; align-items: center; gap: 10px; width: fit-content; max-width: 100%; min-height: 44px; font-size: 14px; font-weight: 650; line-height: 1.5; }
  .consultation-link { color: #c7adff; }
  .consultation-solutions { color: #bae5ff; font-size: 13px; font-weight: 550; }
  .consultation-solutions:hover { text-decoration: underline; text-underline-offset: 4px; }
  healthcare-enquiry { display: block; min-width: 0; }
  .consultation-form { display: grid; align-content: start; gap: 26px; }
  .consultation-field { display: grid; min-width: 0; gap: 5px; }
  .consultation-field label,.consultation-organization legend { padding: 0; font-size: 17px; font-weight: 650; line-height: 1.5; }
  .consultation-optional { color: #bdcbc5; font-size: 12px; font-weight: 500; }
  .consultation-field input,.consultation-field textarea { display: block; box-sizing: border-box; width: 100%; min-width: 0; min-height: 48px; padding: 10px 0 14px; border: 0; border-bottom: 1px solid #a0b9ac66; border-radius: 0; background: transparent; color: #fff; font: inherit; font-size: 16px; line-height: 1.6; caret-color: #63df9d; }
  .consultation-field input::placeholder,.consultation-field textarea::placeholder { color: #bdcbc5; opacity: 1; }
  .consultation-field textarea { min-height: 135px; resize: vertical; }
  .consultation-field input:focus-visible,.consultation-field textarea:focus-visible { outline: 2px solid #63df9d; outline-offset: 5px; border-color: #63df9d; }
  .consultation-field-pair { display: grid; gap: 26px; min-width: 0; }
  .consultation-organization { min-width: 0; margin: 0; padding: 0; border: 0; }
  .consultation-organization legend > span { color: #bdcbc5; font-size: 12px; font-weight: 500; }
  .consultation-organization-options { display: flex; flex-wrap: wrap; gap: 12px; max-width: 520px; margin-top: 12px; }
  .consultation-organization-option { position: relative; max-width: 100%; cursor: pointer; }
  .consultation-organization-option input { position: absolute; width: 1px; height: 1px; margin: 0; clip-path: inset(50%); overflow: hidden; }
  .consultation-organization-option > span { display: flex; align-items: center; justify-content: center; min-height: 48px; padding: 10px 15px; border: 1px solid #a0b9ac66; border-radius: var(--control-radius); color: #dce5e0; font-size: 13px; line-height: 1.5; transition: background-color 160ms,border-color 160ms; }
  .consultation-organization-option:hover > span { border-color: #afa9ec; }
  .consultation-organization-option input:checked + span { background: #6131c64d; border-color: #afa9ec; color: #fff; }
  .consultation-organization-option input:focus-visible + span { outline: 2px solid #bae5ff; outline-offset: 4px; }
  .consultation-hint { margin: 6px 0 0; color: #bdcbc5; font-size: 12px; line-height: 1.7; }
  .consultation-submit { display: inline-flex; align-items: center; justify-content: center; justify-self: start; gap: 14px; min-height: 54px; padding: 14px 22px; border: 1px solid #afa9ec80; border-radius: var(--control-radius); color: #fff; background: linear-gradient(130deg,#6131c6,#6131c6 65%,#793ee0); font-size: 14px; font-weight: 700; }
  .consultation-submit:hover { background: #5026a6; }
  .consultation-submit:focus-visible,.consultation-solutions:focus-visible { outline: 2px solid #bae5ff; outline-offset: 5px; }
  .consultation-submit:disabled { cursor: default; opacity: .65; }
  .consultation-status { min-height: 44px; margin: -10px 0 0; color: #e1ffb9; font-size: 13px; line-height: 1.7; }
  @media(min-width:640px) {
    consultation-motion { padding-top: 16px; }
    .consultation-section { padding-block: 56px; border-radius: 36px 36px 0 0; }
    .consultation-field-pair { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 24px; }
    .consultation-portrait { width: 220px; }
  }
  @media(min-width:1000px) {
    consultation-motion { padding-top: 20px; }
    .consultation-section { padding-block: 64px; border-radius: 40px 40px 0 0; }
    .consultation-grid { width: min(100% - 112px,1250px); grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 64px; }
    .consultation-form { gap: 26px; }
  }
  @media(prefers-reduced-motion:reduce) { .consultation-organization-option > span { transition: none; } }
</style>
